import std.strings

func main():
    let haystack = "alpha;beta;gamma;delta"
    var at: long = 0
    var found = 0
    while true:
        let next = haystack.find(";", at)
        if next < 0:
            break
        found += 1
        at = next + 1
    print(f"{found} separators, {len(haystack.split(";"))} pieces")
