func fill(xs: list(long), upto: long):
    for i in range(0, upto):
        xs.append(i * i)

func total(values: list(long)) -> long:
    var sum: long = 0
    for value in values:
        sum += value
    return sum

func main():
    var squares: list(long) = []
    fill(squares, 5)                 # no word: a borrow
    print(f"{len(squares)} values totalling {total(squares)}")
