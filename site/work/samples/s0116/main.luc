func main():
    let text = "a,bb,ccc"
    var start: long = 0
    var pieces = 0
    while true:
        let comma = text.find_byte(44, start)
        if comma < 0:
            pieces += 1
            print(f"piece: {text[start:len(text)]}")
            break
        pieces += 1
        print(f"piece: {text[start:comma]}")
        start = comma + 1
    print(f"{pieces} pieces, {len(text)} bytes")
