import std.strings

func squares(upto: long) -> list(long):
    var out: list(long) = []
    for i in range(0, upto):
        out.append(i * i)
    return out                    # moves out; the caller owns it

func main():
    var values = squares(5)
    var text: list(string) = []
    for value in values:
        text.append(string(value))
    print(text.join(" "))
