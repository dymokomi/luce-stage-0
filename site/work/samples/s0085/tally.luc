import std.strings

private func clean(word: string) -> string:
    return strings.lower(strings.trim(word))

func count(text: string, wanted: string) -> long:
    let words = strings.split(text, " ")
    let target = clean(wanted)
    var found = 0
    for word in words:
        if clean(word) == target:
            found = found + 1
    return found
