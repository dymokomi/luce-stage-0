func main(args: list(string)):
    var greeting = "hello"
    if len(args) > 0:
        greeting = greeting + ", " + args[0]
    print(greeting)

    var counts = new map(string, long)
    for word in ["fig", "pear", "fig"]:
        counts[word] += 1
    for word, seen in counts:
        print(f"{word} appeared {seen} time(s)")
