# Float arithmetic: a mandelbrot membership count.  Pure * + -
# comparisons — no library calls in either language, so this measures
# raw float work.  The C twin is bench/math.c.

func main():
    let size = 2236
    let max_iter = 60
    var inside = 0
    for py in range(0, size):
        for px in range(0, size):
            let x0 = Float(px) * (3.0 / Float(size)) - 2.25
            let y0 = Float(py) * (2.5 / Float(size)) - 1.25
            var x = 0.0
            var y = 0.0
            var iter = 0
            while iter < max_iter and x * x + y * y <= 4.0:
                let next_x = x * x - y * y + x0
                y = 2.0 * x * y + y0
                x = next_x
                iter += 1
            if iter == max_iter:
                inside += 1
    print(String(inside))
