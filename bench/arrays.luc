# array number-crunching: fill two double arrays, then a repeated dot
# product.  This is the workload a C compiler auto-vectorizes, and the
# compiled Luce vectorizes it too — the fill loops on both sides, while
# the dot product's accumulation stays scalar on both, because a
# left-to-right float reduction cannot be reassociated.  What the ratio
# measures is therefore element access and loop overhead, not a SIMD
# gap.  The C twin is bench/arrays.c.  Every product is an exact
# multiple of 1/8, so the sum is exact and both sides truncate to the
# same integer.

func main():
    let n = 200000
    let reps = 400
    var a = new array(double, n)
    var b = new array(double, n)
    for i in range(0, n):
        a[i] = double(i % 100) * 0.5
        b[i] = double((i * 7) % 100) * 0.25
    var dot = 0.0
    for r in range(0, reps):
        var sum = 0.0
        for i in range(0, n):
            sum += a[i] * b[i]
        dot += sum
    print(string(long(trunc(dot))))
