# Vector statistics through std math — sum, extrema, dot, norm,
# variance over two million-element Float arrays.  The
# std-is-written-in-Luce bet measured on numeric code; the C twin is
# bench/stats.c.
#
# The sums accumulate strictly left to right on both sides, which is
# what makes the printed integers bit-identical and what stops either
# compiler vectorizing an accumulation: clang will not reorder a float
# reduction without fast-math, and Luce never will.  Both do vectorize
# the elementwise work underneath one — the multiply in dot, the
# subtract in variance — and sqrt is IEEE-exact on both.
#
# The extrema are the exception, and the one place the two languages
# differ in kind.  Luce's min is IEEE-754-2019 minimumNumber: exactly
# associative and commutative, so vmin may reduce four lanes at a time
# and still answer the value the one-at-a-time loop would have.  C's
# `a < b ? a : b` decides a NaN by operand order and is neither, so
# clang has to keep it a scalar compare-and-select chain.

import std.math

func main():
    let n = 2000000
    var a = new Array(Float, n)
    var b = new Array(Float, n)
    for i in range(0, n):
        a[i] = Float((i * 7) % 32) * 0.25
        b[i] = Float((i * 13) % 32) * 0.25
    var checksum = 0.0
    for r in range(0, 6):
        checksum += math.dot(a, b)
        checksum += math.variance(a) else 0.0
        checksum += math.norm(b)
    let low = Int((math.vmin(b) else 0.0) * 4.0)
    let high = Int((math.vmax(b) else 0.0) * 4.0)
    print(f"{Int(math.sum(a))} {low} {high} {Int(checksum)}")
