# list-bound work — the row the suite was missing.  Every other
# benchmark is scalar (`loops`, `math`), holds an `array` (`arrays`,
# `arrays32`, `matmul`, `matmul32`, `stats`) or is allocation-bound in
# a builder[`strings`], so none of them can see a change to how a
# `list` stores its elements.  This one is nothing but that: build a
# `list[u8]` by append, read it sequentially and strided, transform
# it in place, histogram it into a `list[i64]`, and then run the same
# four shapes at eight bytes an element.  It is the shape a decoder
# runs — zip and inflate are exactly this: a buffer that grows by
# append, a table indexed by a u8, and a pass that rewrites in place.
#
# The C twin is bench/lists.c; both print the same eight numbers.
# Every quantity is kept small enough that no sum can overflow, and
# every operand is non-negative, so Luce's floor `//`/`%` and C's
# truncating pair agree element for element.

pub func main():
    let n = 3000000
    # Prime, so it is coprime with both walk lengths below and the
    # stride visits every element exactly once — a whole pass over the
    # run in an order no prefetcher follows.
    let stride = 4099

    # 1. The growth path: n appends into a list that starts empty.
    var data = list[u8]()
    for i in range(0, n):
        data.append(u8((i * 7 + 11) % 251))

    # 2. Sequential read.
    var total: i64 = 0
    for value in data:
        total += i64(value)

    # 3. Strided read.
    var walk: i64 = 0
    var at = 0
    for step in range(0, n):
        walk += i64(data[at])
        at += stride
        if at >= n:
            at -= n

    # 4. In-place transform, read back by the histogram below.
    for i in range(0, n):
        data[i] = u8((data[i] * 3 + 1) & 0xFF)

    # 5. Histogram: 256 counters in a list[i64], indexed by a u8.
    var counts = list[i64]()
    for slot in range(0, 256):
        counts.append(0)
    for value in data:
        counts[i64(value)] += 1
    var weighted: i64 = 0
    var peak: i64 = 0
    for slot in range(0, 256):
        weighted += counts[slot] * slot
        if counts[slot] > peak:
            peak = counts[slot]

    # 6. The same shapes at eight bytes an element.
    let m = n // 8
    var marks = list[i64]()
    for i in range(0, m):
        marks.append(i64(data[i * 8]) * 65537 + i)
    var mark_walk: i64 = 0
    at = 0
    for step in range(0, m):
        mark_walk += marks[at] % 1000
        at += stride
        if at >= m:
            at -= m
    for i in range(0, m):
        marks[i] = marks[i] // 3 + 1
    var mark_total: i64 = 0
    for value in marks:
        mark_total += value % 251

    print(f"{len(data)} {total} {walk} {weighted} {peak} {len(marks)} {mark_walk} {mark_total}")
