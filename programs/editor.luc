# The loom editor — a modern terminal editor written in Luce, for Luce.
#
# Runs on the loom terminal builtins: the host owns raw mode and escape
# sequences, this program owns every editing decision.  Per-line syntax
# highlighting for Luce: keywords, capitalized type names, builtins,
# strings, numbers, and comments.
#
#   loom edit FILE          (or: loom run editor.lc FILE)
#   Ctrl-S save             Ctrl-Q quit (twice to discard changes)

import std.files

struct Theme:
    keyword: Int
    kind: Int
    builtin: Int
    text: Int
    number: Int
    comment: Int
    plain: Int
    punct: Int
    gutter: Int
    gutter_current: Int
    status_fg: Int
    status_bg: Int
    alert: Int

# One file-scope constant instead of a function per color.
let theme = Theme(
    keyword = 176,
    kind = 80,
    builtin = 74,
    text = 114,
    number = 215,
    comment = 244,
    plain = 252,
    punct = 249,
    gutter = 240,
    gutter_current = 250,
    status_fg = 252,
    status_bg = 237,
    alert = 215,
)

struct Fmt:
    func pad_left(value: String, width: Int) -> String:
        var padded = value
        while len(padded) < width:
            padded = " " + padded
        return padded

struct Text:
    func continuation(byte: Int) -> Bool:
        return byte >= 128 and byte < 192

    func previous_boundary(value: String, cursor: Int) -> Int:
        if cursor <= 0:
            return 0
        var at = cursor - 1
        while at > 0 and Text.continuation(value.byte_at(at)):
            at = at - 1
        return at

    func next_boundary(value: String, cursor: Int) -> Int:
        if cursor >= len(value):
            return len(value)
        var at = cursor + 1
        while at < len(value) and Text.continuation(value.byte_at(at)):
            at = at + 1
        return at

    func line_start(value: String, cursor: Int) -> Int:
        var at = cursor
        while at > 0 and value.byte_at(at - 1) != 10:
            at = at - 1
        return at

    func line_end(value: String, cursor: Int) -> Int:
        var at = cursor
        while at < len(value) and value.byte_at(at) != 10:
            at = at + 1
        return at

    func line_of(value: String, cursor: Int) -> Int:
        var line = 0
        for at in range(0, cursor):
            if value.byte_at(at) == 10:
                line = line + 1
        return line

    func count_lines(value: String) -> Int:
        return Text.line_of(value, len(value)) + 1

    func column_of(value: String, cursor: Int) -> Int:
        var at = Text.line_start(value, cursor)
        var column = 0
        while at < cursor:
            at = Text.next_boundary(value, at)
            column = column + 1
        return column

    func line_at(value: String, wanted: Int) -> Int:
        var at = 0
        var line = 0
        while line < wanted and at < len(value):
            if value.byte_at(at) == 10:
                line = line + 1
            at = at + 1
        return at

    func at_column(value: String, start: Int, column: Int) -> Int:
        var at = start
        var current = 0
        let finish = Text.line_end(value, start)
        while at < finish and current < column:
            at = Text.next_boundary(value, at)
            current = current + 1
        return at

    func width(value: String) -> Int:
        var at = 0
        var columns = 0
        while at < len(value):
            at = Text.next_boundary(value, at)
            columns = columns + 1
        return columns

struct Editing:
    func splice(value: String, cursor: Int, extra: String) -> String:
        return value[0:cursor] + extra + value[cursor:len(value)]

    func erase_before(value: String, cursor: Int) -> String:
        let before = Text.previous_boundary(value, cursor)
        return value[0:before] + value[cursor:len(value)]

    func erase_at(value: String, cursor: Int) -> String:
        let after = Text.next_boundary(value, cursor)
        return value[0:cursor] + value[after:len(value)]

struct Words:
    func is_digit(byte: Int) -> Bool:
        return byte >= 48 and byte <= 57

    func is_upper(byte: Int) -> Bool:
        return byte >= 65 and byte <= 90

    func is_alpha(byte: Int) -> Bool:
        return Words.is_upper(byte) or (byte >= 97 and byte <= 122)

    func is_word_start(byte: Int) -> Bool:
        return Words.is_alpha(byte) or byte == 95 or byte >= 194

    func is_word(byte: Int) -> Bool:
        return Words.is_word_start(byte) or Words.is_digit(byte) or Words.continuation_byte(byte)

    func continuation_byte(byte: Int) -> Bool:
        return byte >= 128 and byte < 192

    func is_keyword(word: String) -> Bool:
        if word == "func" or word == "let" or word == "var" or word == "if":
            return true
        if word == "elif" or word == "else" or word == "while" or word == "for":
            return true
        if word == "in" or word == "return" or word == "break" or word == "continue":
            return true
        if word == "struct" or word == "and" or word == "or" or word == "not":
            return true
        return word == "true" or word == "false"

    func is_builtin(word: String) -> Bool:
        if word == "range" or word == "len" or word == "slice" or word == "byte_at":
            return true
        if word == "print" or word == "assert" or word == "trap":
            return true
        if word == "min" or word == "max" or word == "clamp" or word == "abs":
            return true
        if word == "sqrt" or word == "floor" or word == "ceil":
            return true
        if word == "file_read" or word == "file_write" or word == "file_exists":
            return true
        if word == "key_read" or word == "key_text" or word == "dir_list":
            return true
        if word == "term_write" or word == "term_move" or word == "term_style":
            return true
        if word == "term_clear" or word == "term_flush" or word == "term_rows":
            return true
        return word == "term_cols"

    # 1 keyword, 2 type name (capitalized), 3 builtin, 0 plain.
    func classify(word: String) -> Int:
        if Words.is_keyword(word):
            return 1
        if len(word) > 0 and Words.is_upper(word.byte_at(0)):
            return 2
        if Words.is_builtin(word):
            return 3
        return 0

# The editor's whole state, and the operations on it.
#
# `Handle` used to stand at the bottom of this file with four
# functions that all took `state: State`, opened with `var next =
# state` and ended with `return next`; every call site wrote `state =
# Handle.key(state, …)`.  Those were the two halves of a write-back
# spelled by hand at seven sites (docs/METHODS.md), and `var self`
# writes them: `state.key(…)` means `state = State.key(state, …)`.
#
# `State` carries only String, Int and Bool — all values — which is
# what `var self` requires and where S17 and S28 had already put this
# code: had it carried a `List`, `return next` would already have been
# refused.
struct State:
    path: String
    content: String
    cursor: Int
    scroll: Int
    dirty: Bool
    message: String
    quit_pending: Bool
    quit: Bool

    func vertical(var self, target_line: Int):
        let total = Text.count_lines(self.content)
        let wanted = Text.column_of(self.content, self.cursor)
        let landing = clamp(target_line, 0, total - 1)
        let start = Text.line_at(self.content, landing)
        self.cursor = Text.at_column(self.content, start, wanted)

    # Early return on failure is the shape errors are for: the handler
    # says what went wrong and leaves, and the success lines below it
    # run only where the write landed (docs/FAILURE.md).
    func save(var self):
        file_write(self.path, self.content) catch:
            self.message = "cannot write " + self.path
            return
        self.dirty = false
        self.message = "saved " + self.path

    func key(var self, name: String, inserted: String, visible: Int):
        let line = Text.line_of(self.content, self.cursor)
        if name != "ctrl_q":
            self.quit_pending = false
        if len(self.message) > 0 and name != "ctrl_q" and name != "ctrl_s":
            self.message = ""

        if name == "left":
            self.cursor = Text.previous_boundary(self.content, self.cursor)
        elif name == "right":
            self.cursor = Text.next_boundary(self.content, self.cursor)
        elif name == "up":
            self.vertical(line - 1)
        elif name == "down":
            self.vertical(line + 1)
        elif name == "page_up":
            self.vertical(line - visible)
        elif name == "page_down":
            self.vertical(line + visible)
        elif name == "home":
            self.cursor = Text.line_start(self.content, self.cursor)
        elif name == "end":
            self.cursor = Text.line_end(self.content, self.cursor)
        elif name == "backspace":
            if self.cursor > 0:
                # **The line docs/METHODS.md named.**  This measures
                # against the content as it was *before* the erase, and
                # the copy-and-return shape gave that snapshot away for
                # free: `state` was still the old one while `next` was
                # the new.  Under `var self` there is one name, so the
                # snapshot has to be taken out loud — and a conversion
                # that missed it would move the cursor by the wrong
                # number of bytes with nothing to catch it, which is
                # why the editor got a behavioural test first.
                let before = self.content
                self.content = Editing.erase_before(self.content, self.cursor)
                self.cursor = Text.previous_boundary(before, self.cursor)
                self.dirty = true
        elif name == "delete":
            if self.cursor < len(self.content):
                self.content = Editing.erase_at(self.content, self.cursor)
                self.dirty = true
        elif name == "enter":
            self.content = Editing.splice(self.content, self.cursor, "\n")
            self.cursor = self.cursor + 1
            self.dirty = true
        elif name == "tab":
            self.content = Editing.splice(self.content, self.cursor, "    ")
            self.cursor = self.cursor + 4
            self.dirty = true
        elif name == "text":
            self.content = Editing.splice(self.content, self.cursor, inserted)
            self.cursor = self.cursor + len(inserted)
            self.dirty = true
        elif name == "ctrl_s":
            self.save()
        elif name == "ctrl_q":
            if self.dirty and not self.quit_pending:
                self.quit_pending = true
                self.message = "unsaved changes; Ctrl-Q again to discard"
            else:
                self.quit = true

    func adjust(var self, visible: Int):
        let cursor_line = Text.line_of(self.content, self.cursor)
        if cursor_line < self.scroll:
            self.scroll = cursor_line
        elif cursor_line >= self.scroll + visible:
            self.scroll = cursor_line - visible + 1

    # The two `Draw` functions that took a `State`: they read it and
    # answer nothing, so they take a plain `self` and write nothing
    # back.  Everything else in `Draw` operates on text and columns
    # rather than on the editor, and stays the namespace function it
    # is — which is the whole rule, said once.
    func status(self, rows: Int, cols: Int, line: Int, column: Int):
        term_move(rows - 1, 0)
        var flag = ""
        if self.dirty:
            flag = " +"
        var left = " " + self.path + flag + "  " + String(line + 1) + ":" + String(column + 1)
        if len(self.message) > 0:
            left = left + "  — " + self.message
        let hint = "Ctrl-S save  Ctrl-Q quit "
        var pad = cols - Text.width(left) - Text.width(hint)
        while pad > 0:
            left = left + " "
            pad = pad - 1
        let bar = left + hint
        term_style(theme.status_fg, theme.status_bg, false)
        let ignored = Draw.emit(bar, 0, len(bar), cols)

    func frame(self):
        let rows = max(term_rows(), 2)
        let cols = max(term_cols(), 10)
        let visible = rows - 1
        let side = 5
        let text_width = max(cols - side, 1)
        let cursor_line = Text.line_of(self.content, self.cursor)
        let cursor_column = Text.column_of(self.content, self.cursor)
        let total = Text.count_lines(self.content)

        term_clear()
        var at = Text.line_at(self.content, self.scroll)
        for row in range(0, visible):
            let line_index = self.scroll + row
            term_move(row, 0)
            if line_index < total:
                Draw.gutter(line_index + 1, line_index == cursor_line)
                let finish = Text.line_end(self.content, at)
                Draw.line(self.content, at, finish, text_width)
                at = finish + 1
            else:
                term_style(theme.gutter, -1, false)
                term_write("   ~")
        self.status(rows, cols, cursor_line, cursor_column)
        term_move(
            clamp(cursor_line - self.scroll, 0, visible - 1),
            clamp(side + cursor_column, 0, cols - 1),
        )
        term_flush()

struct Draw:
    # Write [from, to) clipped to `remaining` display columns; returns
    # the columns actually used.
    func emit(value: String, from: Int, to: Int, remaining: Int) -> Int:
        var at = from
        var used = 0
        while at < to and used < remaining:
            let stop = Text.next_boundary(value, at)
            term_write(value[at:stop])
            at = stop
            used = used + 1
        return used

    # One source line with Luce highlighting, clipped to `width`.
    func line(content: String, start: Int, finish: Int, width: Int):
        var at = start
        var used = 0
        while at < finish and used < width:
            let byte = content.byte_at(at)
            if byte == 35:
                term_style(theme.comment, -1, false)
                used = used + Draw.emit(content, at, finish, width - used)
                at = finish
            elif byte == 34:
                var close = at + 1
                var closed = false
                while close < finish and not closed:
                    let inner = content.byte_at(close)
                    if inner == 92:
                        close = close + 2
                    elif inner == 34:
                        closed = true
                        close = close + 1
                    else:
                        close = close + 1
                close = min(close, finish)
                term_style(theme.text, -1, false)
                used = used + Draw.emit(content, at, close, width - used)
                at = close
            elif Words.is_digit(byte):
                var stop = at + 1
                while stop < finish and (Words.is_digit(content.byte_at(stop)) or content.byte_at(stop) == 46):
                    stop = stop + 1
                term_style(theme.number, -1, false)
                used = used + Draw.emit(content, at, stop, width - used)
                at = stop
            elif Words.is_word_start(byte):
                var stop = at + 1
                while stop < finish and Words.is_word(content.byte_at(stop)):
                    stop = stop + 1
                let kind = Words.classify(content[at:stop])
                if kind == 1:
                    term_style(theme.keyword, -1, true)
                elif kind == 2:
                    term_style(theme.kind, -1, false)
                elif kind == 3:
                    term_style(theme.builtin, -1, false)
                else:
                    term_style(theme.plain, -1, false)
                used = used + Draw.emit(content, at, stop, width - used)
                at = stop
            else:
                var stop = Text.next_boundary(content, at)
                stop = min(stop, finish)
                term_style(theme.punct, -1, false)
                used = used + Draw.emit(content, at, stop, width - used)
                at = stop

    func gutter(number: Int, current: Bool):
        if current:
            term_style(theme.gutter_current, -1, false)
        else:
            term_style(theme.gutter, -1, false)
        term_write(Fmt.pad_left(String(number), 4) + " ")

func main(args: List(String)):
    if len(args) != 1:
        print("usage: editor FILE")
        return
    let path = args[0]
    # One read, and what it answers decides the greeting.  The
    # exists-then-read this used to write had a window between the two
    # calls that nothing could close, and it could not tell "not
    # there" from "would not open" either (docs/FAILURE.md).
    var opening = ""
    var greeting = ""
    opening = files.read(path) catch:
        greeting = "new file"
    var state = State(
        path = path,
        content = opening,
        cursor = 0,
        scroll = 0,
        dirty = false,
        message = greeting,
        quit_pending = false,
        quit = false,
    )
    while not state.quit:
        let visible = max(term_rows() - 1, 1)
        state.adjust(visible)
        state.frame()
        # `key_read` answers `String?`: `none` is the keyboard running
        # dry — a pipe that ended, a terminal that closed — and there
        # is no one left to ask what to do about unsaved work, so the
        # editor stops rather than asking forever.
        let name = key_read()
        if name == none:
            break
        state.key(name, key_text(), visible)
