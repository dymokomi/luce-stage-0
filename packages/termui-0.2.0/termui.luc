# termui — the value vocabulary every consumer needs.
#
# Style and Rect are values: they copy, take no verbs, and allocate
# nothing.  Layout is arithmetic, not a solver — the solver that turns a
# list of constraints into rectangles is `termui.layout`, and it is
# built out of these operations.

# The sixteen names a program reaches for; the fields stay `long`
# because 256-colour terminals are why `term_style` takes a number.
enum Color:
    black
    red
    green
    yellow
    blue
    magenta
    cyan
    white
    bright_black
    bright_red
    bright_green
    bright_yellow
    bright_blue
    bright_magenta
    bright_cyan
    bright_white

struct Style:
    foreground: long = 7
    background: long = -1
    bold: bool = false

    static func of(colour: Color) -> Style:
        return Style(foreground = int(colour))

# A rectangle of terminal cells.  Every operation is total: a split
# past the edge answers an empty rectangle rather than trapping,
# because a small window is a resize and not a bug.
struct Rect:
    row: long = 0
    column: long = 0
    rows: long = 0
    columns: long = 0

    func is_empty() -> bool:
        return self.rows <= 0 or self.columns <= 0

    func split_top(height: long) -> (Rect, Rect):
        let taken = clamp(height, 0, self.rows)
        let top = Rect(row = self.row, column = self.column, rows = taken, columns = self.columns)
        let rest = Rect(
            row = self.row + taken,
            column = self.column,
            rows = self.rows - taken,
            columns = self.columns,
        )
        return top, rest

    func split_bottom(height: long) -> (Rect, Rect):
        let taken = clamp(height, 0, self.rows)
        let rest = Rect(
            row = self.row,
            column = self.column,
            rows = self.rows - taken,
            columns = self.columns,
        )
        let bottom = Rect(
            row = self.row + self.rows - taken,
            column = self.column,
            rows = taken,
            columns = self.columns,
        )
        return bottom, rest

    func split_left(width: long) -> (Rect, Rect):
        let taken = clamp(width, 0, self.columns)
        let left = Rect(row = self.row, column = self.column, rows = self.rows, columns = taken)
        let rest = Rect(
            row = self.row,
            column = self.column + taken,
            rows = self.rows,
            columns = self.columns - taken,
        )
        return left, rest

    func split_right(width: long) -> (Rect, Rect):
        let taken = clamp(width, 0, self.columns)
        let rest = Rect(
            row = self.row,
            column = self.column,
            rows = self.rows,
            columns = self.columns - taken,
        )
        let right = Rect(
            row = self.row,
            column = self.column + self.columns - taken,
            rows = self.rows,
            columns = taken,
        )
        return right, rest

    func inset(amount: long) -> Rect:
        return Rect(
            row = self.row + amount,
            column = self.column + amount,
            rows = max(self.rows - 2 * amount, 0),
            columns = max(self.columns - 2 * amount, 0),
        )
