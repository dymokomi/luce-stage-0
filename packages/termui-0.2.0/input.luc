# Terminal input as one union of values.
#
# The host answers a key *name* and keeps the numbers belonging to it
# in mutable state that the next read overwrites.  `next()` reads that
# state once, at the moment the event is made, and hands back a value
# — so an event held across another read still says what it said.

import std.term

# One member per name the host can produce.  `src/apps/key.zig`'s own
# union is the thirteen navigation names plus `control: u8`, which the
# host renders as "ctrl_" and the letter; `unknown` is every name a
# later host learns before this enum does.
enum Key:
    unknown
    enter
    tab
    backspace
    delete
    up
    down
    left
    right
    home
    end
    page_up
    page_down
    escape
    ctrl_a
    ctrl_b
    ctrl_c
    ctrl_d
    ctrl_e
    ctrl_f
    ctrl_g
    ctrl_h
    ctrl_i
    ctrl_j
    ctrl_k
    ctrl_l
    ctrl_m
    ctrl_n
    ctrl_o
    ctrl_p
    ctrl_q
    ctrl_r
    ctrl_s
    ctrl_t
    ctrl_u
    ctrl_v
    ctrl_w
    ctrl_x
    ctrl_y
    ctrl_z

enum Pointer:
    press
    release
    drag
    move
    wheel

# The mouse report, copied out of the host at the moment the event is
# made.  Coordinates are zero based; buttons are left=0, middle=1,
# right=2 and -1 for a wheel; wheel is +1 up and -1 down.
struct Mouse:
    kind: Pointer = Pointer.move
    row: long = 0
    column: long = 0
    button: long = 0
    modifiers: long = 0
    wheel: long = 0

    func has_shift() -> bool:
        return (self.modifiers & 1) != 0

    func has_alt() -> bool:
        return (self.modifiers & 2) != 0

    func has_control() -> bool:
        return (self.modifiers & 4) != 0

union Event:
    closed
    resize
    key(pressed: Key)
    text(typed: string)
    mouse(pointer: Mouse)

# The input stream.  `last_name` is the escape hatch: a key this
# version does not name still arrives, as `Key.unknown`, and a program
# that wants the raw spelling can ask.
struct Events:
    last_name: string = ""

    func next() -> Event:
        let name = term.io.read()
        if name == none:
            return Event.closed
        self.last_name = name
        if name == "resize":
            return Event.resize
        if name == "text":
            return Event.text(typed = term.io.text())
        let pointer = Events.pointer_of(name)
        if pointer != none:
            return Event.mouse(pointer = Mouse(
                kind = pointer,
                row = term.io.row(),
                column = term.io.column(),
                button = term.io.button(),
                modifiers = term.io.modifiers(),
                wheel = term.io.value(),
            ))
        return Event.key(pressed = Events.key_of(name))

    static func pointer_of(name: string) -> Pointer?:
        if name == "mouse_press":
            return Pointer.press
        if name == "mouse_release":
            return Pointer.release
        if name == "mouse_drag":
            return Pointer.drag
        if name == "mouse_move":
            return Pointer.move
        if name == "mouse_wheel":
            return Pointer.wheel
        return none

    # The one place a key name is a string.  Every other name in the
    # host's vocabulary is a member of `Key`, so the table below is a
    # transcription and a name it does not know is `Key.unknown`.
    static func key_of(name: string) -> Key:
        let named = NAMES.get(name)
        if named == none:
            return Key.unknown
        return named

const NAMES = {
    "enter": Key.enter,
    "tab": Key.tab,
    "backspace": Key.backspace,
    "delete": Key.delete,
    "up": Key.up,
    "down": Key.down,
    "left": Key.left,
    "right": Key.right,
    "home": Key.home,
    "end": Key.end,
    "page_up": Key.page_up,
    "page_down": Key.page_down,
    "escape": Key.escape,
    "ctrl_a": Key.ctrl_a,
    "ctrl_b": Key.ctrl_b,
    "ctrl_c": Key.ctrl_c,
    "ctrl_d": Key.ctrl_d,
    "ctrl_e": Key.ctrl_e,
    "ctrl_f": Key.ctrl_f,
    "ctrl_g": Key.ctrl_g,
    "ctrl_h": Key.ctrl_h,
    "ctrl_i": Key.ctrl_i,
    "ctrl_j": Key.ctrl_j,
    "ctrl_k": Key.ctrl_k,
    "ctrl_l": Key.ctrl_l,
    "ctrl_m": Key.ctrl_m,
    "ctrl_n": Key.ctrl_n,
    "ctrl_o": Key.ctrl_o,
    "ctrl_p": Key.ctrl_p,
    "ctrl_q": Key.ctrl_q,
    "ctrl_r": Key.ctrl_r,
    "ctrl_s": Key.ctrl_s,
    "ctrl_t": Key.ctrl_t,
    "ctrl_u": Key.ctrl_u,
    "ctrl_v": Key.ctrl_v,
    "ctrl_w": Key.ctrl_w,
    "ctrl_x": Key.ctrl_x,
    "ctrl_y": Key.ctrl_y,
    "ctrl_z": Key.ctrl_z,
}
