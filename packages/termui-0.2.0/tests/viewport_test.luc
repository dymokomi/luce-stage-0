# Viewport is a scroll position; ViewportView paints the window.

import viewport
import surface
import termui
import view as views

struct Log:
    lines: list[str]

    func at(index: i64) -> str:
        return self.lines[index]

func log_of(count: i64) -> Log:
    var held = Log(lines = new list[str])
    for i in range(0, count):
        held.lines.append("line" + str(i))
    return held

func test_scroll_stays_on_the_content():
    var window = viewport.Viewport(total = 10)
    window.scroll_by(3)
    assert(window.top == 3)
    window.scroll_by(100)
    assert(window.top == 9)
    window.scroll_by(-100)
    assert(window.top == 0)

func test_viewport_view_paints_the_window():
    var held = log_of(6)
    let item: views.View = viewport.ViewportView(
        render = held.at,
        top = 2,
        total = 6,
        style = termui.Style(),
    )
    var s = surface.Surface.of(2, 8)
    s.clear()
    item.draw(s, s.area())
    s.present()
    assert(s.front[0, 4].text == "2")
    assert(s.front[1, 4].text == "3")
