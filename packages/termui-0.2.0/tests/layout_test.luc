# The constraint solver is total: the sum never exceeds what is
# available and no length is negative, whatever the terminal's size.

import termui
import layout

func sum(sizes: list[i64]) -> i64:
    var total: i64 = 0
    for size in sizes:
        total = total + size
    return total

func test_cells_are_exact_and_grow_takes_the_rest():
    var items = new list[layout.Length]
    items.append(layout.Length.cells(count = 5))
    items.append(layout.Length.grow(weight = 1))
    let sizes = layout.resolve(80, 0, items)
    assert(sizes[0] == 5)
    assert(sizes[1] == 75)
    assert(sum(sizes) == 80)

func test_grow_splits_leftover_by_weight_and_fills_exactly():
    var items = new list[layout.Length]
    items.append(layout.Length.grow(weight = 1))
    items.append(layout.Length.grow(weight = 3))
    let sizes = layout.resolve(41, 0, items)
    # 41 shared 1:3 is 10 and 30, and the rounding remainder (1) goes
    # to the first grow, so the axis is filled exactly.
    assert(sizes[0] == 11)
    assert(sizes[1] == 30)
    assert(sum(sizes) == 41)

func test_between_clamps_its_ratio():
    var items = new list[layout.Length]
    # A quarter of 80 is 20, inside [18, 24], so it stays 20.
    items.append(layout.Length.between(low = 18, high = 24, ratio = 25))
    items.append(layout.Length.grow(weight = 1))
    let wide = layout.resolve(80, 0, items)
    assert(wide[0] == 20)
    assert(wide[1] == 60)
    # A quarter of 40 is 10, below the floor, so it clamps up to 18.
    let narrow = layout.resolve(40, 0, items)
    assert(narrow[0] == 18)
    assert(narrow[1] == 22)

func test_gaps_come_out_of_the_usable_space():
    var items = new list[layout.Length]
    items.append(layout.Length.grow(weight = 1))
    items.append(layout.Length.grow(weight = 1))
    # Two grows over 21 with a gap of 1 share 20: 10 and 10.
    let sizes = layout.resolve(21, 1, items)
    assert(sizes[0] == 10)
    assert(sizes[1] == 10)
    assert(sum(sizes) == 20)

func test_oversubscription_shrinks_between_toward_its_floor():
    var items = new list[layout.Length]
    items.append(layout.Length.cells(count = 5))
    items.append(layout.Length.between(low = 18, high = 24, ratio = 25))
    items.append(layout.Length.grow(weight = 1))
    # Only 20 cells: the grow is 0, the sidebar gives way from its 18
    # floor, the gutter's 5 hold until the last resort.
    let sizes = layout.resolve(20, 0, items)
    assert(sizes[2] == 0)
    assert(sum(sizes) <= 20)
    assert(sizes[0] >= 0 and sizes[1] >= 0 and sizes[2] >= 0)

func test_the_solve_is_total_at_zero_width():
    var items = new list[layout.Length]
    items.append(layout.Length.cells(count = 5))
    items.append(layout.Length.grow(weight = 1))
    let sizes = layout.resolve(0, 0, items)
    assert(sum(sizes) == 0)
    assert(sizes[0] >= 0 and sizes[1] >= 0)

func test_row_places_rectangles_left_to_right():
    let area = termui.Rect(row = 0, column = 0, rows = 24, columns = 80)
    var items = new list[layout.Length]
    items.append(layout.Length.cells(count = 20))
    items.append(layout.Length.grow(weight = 1))
    let rects = layout.Row.solve(area, 0, items)
    assert(rects[0].column == 0 and rects[0].columns == 20)
    assert(rects[1].column == 20 and rects[1].columns == 60)
    assert(rects[0].rows == 24 and rects[1].rows == 24)

func test_column_places_rectangles_top_to_bottom():
    let area = termui.Rect(row = 0, column = 0, rows = 24, columns = 80)
    var items = new list[layout.Length]
    items.append(layout.Length.grow(weight = 1))
    items.append(layout.Length.cells(count = 1))
    let rects = layout.Column.solve(area, 0, items)
    assert(rects[0].row == 0 and rects[0].rows == 23)
    assert(rects[1].row == 23 and rects[1].rows == 1)
    assert(rects[0].columns == 80 and rects[1].columns == 80)

func test_a_horizontal_handle_hits_a_vertical_rule_and_tracks_columns():
    let h = layout.Handle(axis = layout.Axis.horizontal, line = 20, from = 0, to = 10)
    assert(h.hit(5, 20))
    assert(not h.hit(5, 21))
    assert(not h.hit(10, 20))
    assert(not h.hit(-1, 20))
    assert(h.track(5, 23) == 23)

func test_a_vertical_handle_hits_a_horizontal_rule_and_tracks_rows():
    let h = layout.Handle(axis = layout.Axis.vertical, line = 15, from = 0, to = 80)
    assert(h.hit(15, 40))
    assert(not h.hit(14, 40))
    assert(not h.hit(15, 80))
    assert(h.track(18, 40) == 18)
