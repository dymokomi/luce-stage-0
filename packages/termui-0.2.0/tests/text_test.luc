# A Line draws its spans in order, measured by display width and
# clipped to the rectangle it is handed.

import termui
import surface
import text

func test_line_width_sums_its_spans():
    var spans = new list(text.Span)
    spans.append(text.Span(text = "let ", style = termui.Style()))
    spans.append(text.Span(text = "x", style = termui.Style()))
    let line = text.Line(spans = give spans)
    assert(line.width() == 5)

func test_plain_builds_a_one_span_line():
    let line = text.plain("hello", termui.Style(foreground = 3))
    assert(line.width() == 5)
    assert(line.spans[0].style.foreground == 3)

func test_spans_draw_one_after_another():
    var view = surface.Surface.of(1, 10)
    let area = view.area()
    var spans = new list(text.Span)
    spans.append(text.Span(text = "ab", style = termui.Style(foreground = 1)))
    spans.append(text.Span(text = "cd", style = termui.Style(foreground = 2)))
    let line = text.Line(spans = give spans)
    line.draw(view, area, 0)
    assert(view.back[0, 0].text == "a")
    assert(view.back[0, 1].text == "b")
    assert(view.back[0, 2].text == "c")
    assert(view.back[0, 3].text == "d")
    assert(view.back[0, 0].style.foreground == 1)
    assert(view.back[0, 2].style.foreground == 2)

func test_an_over_long_line_is_clipped_to_the_area():
    var view = surface.Surface.of(1, 3)
    let area = view.area()
    let line = text.plain("abcdef", termui.Style())
    line.draw(view, area, 0)
    assert(view.back[0, 0].text == "a")
    assert(view.back[0, 2].text == "c")
