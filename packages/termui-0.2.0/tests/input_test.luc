# A key name becomes a member; an event is a value.

import input

func test_every_host_key_name_has_a_member():
    assert(input.Events.key_of("ctrl_s") == input.Key.ctrl_s)
    assert(input.Events.key_of("page_down") == input.Key.page_down)
    assert(input.Events.key_of("escape") == input.Key.escape)

func test_a_name_this_version_does_not_know_is_unknown():
    assert(input.Events.key_of("hyper_meta") == input.Key.unknown)
    assert(input.Events.key_of("") == input.Key.unknown)

func test_an_event_carries_its_own_data():
    let m = input.Mouse(kind = input.Pointer.press, row = 7, column = 2, modifiers = 5)
    match input.Event.mouse(pointer = m):
        mouse(pointer):
            assert(pointer.row == 7)
            assert(pointer.column == 2)
            assert(pointer.has_shift())
            assert(pointer.has_control())
            assert(not pointer.has_alt())
        closed:
            assert(false)
        resize:
            assert(false)
        key(pressed):
            assert(false)
        text(typed):
            assert(false)

func test_match_reaches_the_arm_the_value_names():
    match input.Event.key(pressed = input.Key.ctrl_q):
        key(pressed):
            assert(pressed == input.Key.ctrl_q)
        else:
            assert(false)
    match input.Event.text(typed = "x"):
        text(typed):
            assert(typed == "x")
        else:
            assert(false)
