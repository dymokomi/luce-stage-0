# Rows is app-owned state; RowsView is its read-only projection.  The
# provider reads app data the widget does not own.

import rows
import surface
import termui
import view as views

struct Names:
    names: list[str]

    func at(index: i64) -> str:
        return self.names[index]

func names_of(count: i64) -> Names:
    var held = Names(names = new list[str])
    for i in range(0, count):
        held.names.append("file" + str(i))
    return held

func test_moving_answers_where_it_landed_and_stops_at_the_ends():
    var pane = rows.Rows(count = 5)
    match pane.move_by(3):
        moved(index):
            assert(index == 3)
        chosen(index):
            assert(false)
    match pane.move_by(99):
        moved(index):
            assert(index == 4)
        chosen(index):
            assert(false)
    match pane.move_by(-99):
        moved(index):
            assert(index == 0)
        chosen(index):
            assert(false)

func test_the_window_follows_the_selection():
    var pane = rows.Rows(count = 20)
    pane.move_by(15)
    pane.adjust(5)
    assert(pane.selected == 15)
    assert(pane.top == 11)
    pane.move_by(-15)
    pane.adjust(5)
    assert(pane.top == 0)

func test_an_empty_list_has_nowhere_to_be():
    var pane = rows.Rows(count = 0)
    pane.adjust(4)
    assert(pane.top == 0)
    assert(pane.selected == 0)

func test_rows_is_a_value():
    var pane = rows.Rows(count = 3)
    pane.move_by(2)
    let snapshot = pane
    pane.move_by(-2)
    assert(snapshot.selected == 2)
    assert(pane.selected == 0)

func test_rows_view_paints_the_window_without_owning_the_list():
    var held = names_of(9)
    var pane = rows.Rows(count = 9)
    pane.move_by(7)
    pane.adjust(3)
    let item: views.View = rows.RowsView(
        render = held.at,
        count = pane.count,
        top = pane.top,
        selected = pane.selected,
        normal = termui.Style(),
        highlight = termui.Style(foreground = 4),
    )
    var s = surface.Surface.of(3, 8)
    s.clear()
    let needed_rows, needed_columns = item.measure(s.area())
    assert(needed_rows == 3 and needed_columns == 8)
    item.draw(s, s.area())
    s.present()
    # Selection 7 with three visible rows puts 5 at the top.
    assert(s.front[0, 4].text == "5")
    assert(s.front[2, 4].text == "7")
    assert(s.front[2, 4].style.foreground == 4)
    # Painting did not move the app's state.
    assert(pane.top == 5 and pane.selected == 7)
