# A Frame draws box edges; overlapping strokes merge into the right
# junction, so corners and shared edges need no special-casing.

import termui
import surface
import frame

func test_a_full_box_has_correct_corners_and_edges():
    var view = surface.Surface.of(4, 6)
    let inside = frame.Frame().draw(view, view.area())
    assert(view.back[0, 0].text == "┌")
    assert(view.back[0, 5].text == "┐")
    assert(view.back[3, 0].text == "└")
    assert(view.back[3, 5].text == "┘")
    assert(view.back[0, 1].text == "─")
    assert(view.back[1, 0].text == "│")
    # The interior is the box inset by one on every drawn edge.
    assert(inside.row == 1 and inside.column == 1)
    assert(inside.rows == 2 and inside.columns == 4)

func test_a_three_sided_frame_leaves_the_bottom_open():
    var view = surface.Surface.of(4, 6)
    let pane = frame.Frame(bottom = false)
    let inside = pane.draw(view, view.area())
    # No bottom rule: the last row's ends are f16-corners, not ┘/└.
    assert(view.back[3, 0].text == "╵")
    assert(view.back[3, 5].text == "╵")
    assert(inside.rows == 3)

func test_adjacent_frames_merge_into_junctions():
    var view = surface.Surface.of(5, 10)
    # A full box on the left; its right rule stands in column 5.
    frame.Frame().draw(view, termui.Rect(row = 0, column = 0, rows = 5, columns = 6))
    # A second box below-right, its left rule sharing column 5.
    frame.Frame().draw(view, termui.Rect(row = 2, column = 5, rows = 3, columns = 5))
    # Where the second box's top meets the first box's rule from above,
    # the glyph is a left-tee; where its bottom meets it, an up-tee.
    assert(view.back[2, 5].text == "├")
    assert(view.back[4, 5].text == "┴")
    # The first box's own top-right corner is untouched above the join.
    assert(view.back[0, 5].text == "┐")

func test_a_title_sits_on_the_top_edge():
    var view = surface.Surface.of(3, 12)
    frame.Frame(title = "files").draw(view, view.area())
    assert(view.back[0, 2].text == " ")
    assert(view.back[0, 3].text == "f")
    assert(view.back[0, 7].text == "s")
    assert(view.back[0, 8].text == " ")

# A title i64 enough to reach the far corner is clipped i16 of it —
# the corner glyph survives rather than being blanked by the trailing
# space of the framed title.
func test_a_long_title_never_erases_the_far_corner():
    var view = surface.Surface.of(3, 8)
    frame.Frame(title = "abcdefgh").draw(view, view.area())
    assert(view.back[0, 7].text == "┐")
    assert(view.back[0, 0].text == "┌")
