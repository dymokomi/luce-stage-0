# The read-only view interface and its plain concretes.
#
# A View measures itself and paints into a surface the caller owns; it
# does not own a terminal, an event loop, or application state.  Under
# Luce's read-only interface rule a view may change the surface handed
# to it but cannot hide a mutable receiver, so composition stays honest
# — the app keeps the model and hands a fresh projection to `draw`.

import surface
import termui
import text

interface View:
    func measure(area: termui.Rect) -> (i64, i64)
    func draw(into: surface.Surface, area: termui.Rect)

# A block of styled lines.  Backed by `text.Line`, so one line may carry
# many styles (a highlighted source row), not one style for the block.
struct Text: View:
    lines: list[text.Line]

    func measure(area: termui.Rect) -> (i64, i64):
        var columns: i64 = 0
        for line in self.lines:
            columns = max(columns, line.width())
        return min(len(self.lines), max(area.rows, 0)), min(columns, max(area.columns, 0))

    func draw(into: surface.Surface, area: termui.Rect):
        for row, line in self.lines:
            if row >= area.rows:
                return
            line.draw(into, area, row)

# A rectangle of one repeated cell — a selection bar, a cleared pane.
struct Fill: View:
    glyph: str = " "
    style: termui.Style = termui.Style()

    func measure(area: termui.Rect) -> (i64, i64):
        return max(area.rows, 0), max(area.columns, 0)

    func draw(into: surface.Surface, area: termui.Rect):
        into.fill(area, self.glyph, self.style)
