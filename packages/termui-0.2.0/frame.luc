# Boxes that share their edges — the junction-aware frame.
#
# A Frame draws any subset of its four edges as box-drawing strokes.
# The one idea that makes it composable: a stroke laid over a stroke
# **merges**.  Where a frame's edge crosses a rule already on the
# surface — its own corner, or a neighbouring pane's border — the two
# glyphs combine into the correct `┼`/`├`/`┴`/… instead of one
# overwriting the other.  So a caller tiles framed panes and never picks
# a junction glyph: the geometry it drew decides.

import std.strings
import std.term
import termui
import surface

# One box glyph as its four strokes.  `term.ui.junction` turns strokes
# back into a glyph; `STROKES` below is its inverse for the glyphs a
# frame can meet.
struct Strokes:
    up: bool = false
    right: bool = false
    down: bool = false
    left: bool = false

    func glyph() -> str:
        return term.ui.junction(top = self.up, right = self.right, bottom = self.down, left = self.left)

    func merged(other: Strokes) -> Strokes:
        return Strokes(
            up = self.up or other.up,
            right = self.right or other.right,
            down = self.down or other.down,
            left = self.left or other.left,
        )

    func is_empty() -> bool:
        return not (self.up or self.right or self.down or self.left)

# The inverse of `term.ui.junction`, for merging.  A cell holding any of
# these box glyphs contributes its strokes; a cell holding text (a
# title, a label) contributes none and is simply overwritten.
const STROKES = {
    "┼": Strokes(up = true, right = true, down = true, left = true),
    "├": Strokes(up = true, right = true, down = true),
    "┤": Strokes(up = true, down = true, left = true),
    "┴": Strokes(up = true, right = true, left = true),
    "┬": Strokes(right = true, down = true, left = true),
    "│": Strokes(up = true, down = true),
    "─": Strokes(right = true, left = true),
    "└": Strokes(up = true, right = true),
    "┘": Strokes(up = true, left = true),
    "┌": Strokes(right = true, down = true),
    "┐": Strokes(down = true, left = true),
    "╵": Strokes(up = true),
    "╷": Strokes(down = true),
    "╶": Strokes(right = true),
    "╴": Strokes(left = true),
}

func strokes_of(glyph: str) -> Strokes:
    let found = STROKES.get(glyph)
    if found == none:
        return Strokes()
    return found

struct Frame:
    title: str = ""
    style: termui.Style = termui.Style()
    top: bool = true
    right: bool = true
    bottom: bool = true
    left: bool = true

    # Lay `add`'s strokes onto the cell at `row`,`column` inside `area`,
    # merging with any box glyph already there.  Absolute placement and
    # bounds are the surface's job (`cell_at`/`put` both clip), so a
    # frame at the edge of the screen is a normal draw.
    func stroke(into: surface.Surface, area: termui.Rect, row: i64, column: i64, add: Strokes):
        if row < 0 or row >= area.rows or column < 0 or column >= area.columns:
            return
        let abs_row = area.row + row
        let abs_column = area.column + column
        let prior = strokes_of(into.cell_at(abs_row, abs_column).text)
        into.put(abs_row, abs_column, add.merged(prior).glyph(), self.style)

    # Draw the requested edges, then the title, and answer the interior.
    func draw(into: surface.Surface, area: termui.Rect) -> termui.Rect:
        if area.rows <= 0 or area.columns <= 0:
            return self.interior(area)
        let last_row = area.rows - 1
        let last_column = area.columns - 1
        if self.top:
            for column in range(0, area.columns):
                self.stroke(into, area, 0, column, Strokes(right = column < last_column, left = column > 0))
        if self.bottom:
            for column in range(0, area.columns):
                self.stroke(into, area, last_row, column, Strokes(right = column < last_column, left = column > 0))
        if self.left:
            for row in range(0, area.rows):
                self.stroke(into, area, row, 0, Strokes(up = row > 0, down = row < last_row))
        if self.right:
            for row in range(0, area.rows):
                self.stroke(into, area, row, last_column, Strokes(up = row > 0, down = row < last_row))
        # The title sits on the top edge, framed by a space each side and
        # clipped to what is left before the far corner.  It overwrites
        # the rule it sits on, which is exactly what a titled box shows.
        # The framed str starts at column 2 and is `len + 2` wide, so
        # `room` is four less than the width: one for the near edge it
        # starts after, two for its own spaces, and one to keep the far
        # corner glyph — a title i64 enough to reach it would erase it.
        if self.top and self.title != "" and last_column > 4:
            let room = last_column - 4
            let shown = self.title.take(room)
            into.write(area, 0, 2, " " + shown + " ", self.style)
        return self.interior(area)

    # The rectangle inside whichever edges were drawn.
    func interior(area: termui.Rect) -> termui.Rect:
        var row = area.row
        var column = area.column
        var rows = area.rows
        var columns = area.columns
        if self.top:
            row = row + 1
            rows = rows - 1
        if self.bottom:
            rows = rows - 1
        if self.left:
            column = column + 1
            columns = columns - 1
        if self.right:
            columns = columns - 1
        return termui.Rect(row = row, column = column, rows = max(rows, 0), columns = max(columns, 0))
