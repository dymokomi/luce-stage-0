# A scrollable window over content — state and its view projection.
#
# The same pattern as `rows`, without a selection: `Viewport` is the
# app-owned scroll position over `total` lines; `ViewportView` paints
# the visible window from a provider.  This is the output/log pane an
# editor scrolls because a person said "down", where `Rows` would scroll
# to follow a selection.

import termui
import surface
import view as views

struct Viewport:
    top: i64 = 0
    total: i64 = 0

    # Move the window, keeping it on the content.  A line index rather
    # than a page is the unit; the caller decides how far a key scrolls.
    func scroll_by(steps: i64):
        self.top = clamp(self.top + steps, 0, max(self.total - 1, 0))

    func to(line: i64):
        self.top = clamp(line, 0, max(self.total - 1, 0))

# The read-only projection.  The provider answers line `index`; the view
# paints the window `[top, top + rows)` in one style.
struct ViewportView: views.View:
    render: (func(i64) -> str)?
    top: i64 = 0
    total: i64 = 0
    style: termui.Style = termui.Style()

    func measure(area: termui.Rect) -> (i64, i64):
        return min(max(self.total, 0), max(area.rows, 0)), max(area.columns, 0)

    func line(index: i64) -> str:
        let provider = self.render
        if provider == none:
            return ""
        return provider(index)

    func draw(into: surface.Surface, area: termui.Rect):
        # A view is a plain struct a caller can build directly, so clamp
        # `top` rather than trust it: a negative offset would ask the
        # provider for a negative line and trap in the app's accessor.
        let top = max(self.top, 0)
        for row in range(0, area.rows):
            let index = top + row
            if index >= self.total:
                return
            into.write(area, row, 0, self.line(index), self.style)
