# The terminal-facing owner for a termui frame.
#
# The `Surface` stays an in-memory, deterministic drawable.  `Renderer`
# is the thin owner that knows when to resize it, when to begin a frame,
# and when to turn a painted frame into terminal output.  Applications
# still own their event loop and state; this type only removes the
# repeated terminal choreography.

import std.term
import termui
import surface
import input

struct Renderer:
    surface: surface.Surface
    events: input.Events = input.Events()

    # Use this in programs connected to a terminal.  Host setup is lazy
    # in std.term, so construction emits nothing.
    static func open() -> Renderer:
        return Renderer(surface = surface.Surface.of(term.rows(), term.cols()))

    # A host-free constructor keeps renderer tests deterministic and lets
    # a caller drive a fixed-size frame without a real terminal.
    static func of(rows: long, columns: long) -> Renderer:
        return Renderer(surface = surface.Surface.of(rows, columns))

    func begin_at(rows: long, columns: long) -> termui.Rect:
        if rows != self.surface.rows or columns != self.surface.columns:
            self.surface = surface.Surface.of(rows, columns)
        self.surface.clear()
        return self.surface.area()

    # Start the next frame and answer the area available to views.
    func begin() -> termui.Rect:
        return self.begin_at(term.rows(), term.cols())

    # The testable part of presentation.  `flush` is separate so an app
    # can put the cursor after its last paint before committing output.
    func present() -> surface.Painted:
        return self.surface.present()

    func cursor(row: long, column: long):
        term.move(row, column)

    func flush():
        term.flush()

    func next() -> input.Event:
        var events = self.events
        let event = events.next()
        self.events = events
        return event
