# A scrolling selection list — state and its view projection.
#
# This is the uniform widget pattern: `Rows` is the app-owned **state**
# (a window and a selection over data it does not own — it holds no
# container, only counters), and `RowsView` is the read-only **View**
# built from that state each frame.  The app moves `Rows` in response to
# a key, then hands a snapshot to `RowsView` to paint.  Nothing here
# owns the app's list, so replacing that list is the app's business.

import termui
import surface
import view as views

# What a key did to the list.  A widget's events are a small closed set
# the widget owns — exactly what a union is for — and the app matches
# this and decides what "chosen" means.
union RowsEvent:
    moved(index: i64)
    chosen(index: i64)

struct Rows:
    count: i64 = 0
    top: i64 = 0
    selected: i64 = 0

    # Keep the selection on the list and the window on the selection.
    func adjust(height: i64):
        if self.count <= 0:
            self.top = 0
            self.selected = 0
            return
        self.selected = clamp(self.selected, 0, self.count - 1)
        if self.selected < self.top:
            self.top = self.selected
        if height > 0 and self.selected >= self.top + height:
            self.top = self.selected - height + 1
        self.top = clamp(self.top, 0, max(self.count - 1, 0))

    func move_by(steps: i64) -> RowsEvent:
        self.selected = clamp(self.selected + steps, 0, max(self.count - 1, 0))
        return RowsEvent.moved(index = self.selected)

    func choose() -> RowsEvent:
        return RowsEvent.chosen(index = self.selected)

# The read-only projection.  The provider answers what row `index` reads
# — a bound method, so the view reads app data without owning it — and
# the selected row is drawn in `highlight`.  Names are plain text; the
# selection is a style, not a Line, because a file list has one colour
# per row and a bar across the width says "selected" better than markup.
struct RowsView: views.View:
    render: (func(i64) -> str)?
    count: i64 = 0
    top: i64 = 0
    selected: i64 = 0
    normal: termui.Style = termui.Style()
    highlight: termui.Style = termui.Style(foreground = 7, background = 4)

    func measure(area: termui.Rect) -> (i64, i64):
        return min(max(self.count, 0), max(area.rows, 0)), max(area.columns, 0)

    func label(index: i64) -> str:
        let provider = self.render
        if provider == none:
            return ""
        return provider(index)

    func draw(into: surface.Surface, area: termui.Rect):
        if self.count <= 0 or area.rows <= 0:
            return
        var selected = clamp(self.selected, 0, self.count - 1)
        var top = max(self.top, 0)
        if selected < top:
            top = selected
        if selected >= top + area.rows:
            top = selected - area.rows + 1
        top = clamp(top, 0, max(self.count - 1, 0))
        for row in range(0, area.rows):
            let index = top + row
            if index >= self.count:
                return
            var style = self.normal
            if index == selected:
                # A selected row is a bar across the pane: fill first,
                # then write the label over it.
                into.fill(termui.Rect(row = area.row + row, column = area.column, rows = 1, columns = area.columns), " ", self.highlight)
                style = self.highlight
            into.write(area, row, 0, self.label(index), style)
