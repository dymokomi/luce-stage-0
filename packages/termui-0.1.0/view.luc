# Small renderable values for termui.
#
# A View is deliberately narrower than a widget framework.  It measures
# itself and paints into a surface supplied by the caller; it does not own a
# terminal, an event loop, or application state.  That keeps composition
# honest under Luce's read-only interface rule: a view may change the surface
# it was handed, but it cannot hide a mutable receiver behind a callback.

import screen
import termui
import border
import std.strings

interface View:
    func measure(area: termui.Rect) -> (long, long)
    func draw(into: screen.Screen, area: termui.Rect)

# Text is the smallest useful view.  Newlines make a value into a small
# block, and the surface clips each line to the rectangle it receives.
struct Text: View:
    content: string = ""
    style: termui.Style = termui.Style()

    func measure(area: termui.Rect) -> (long, long):
        let lines = strings.split(self.content, "\n")
        var rows: long = len(lines)
        var columns: long = 0
        for line in lines:
            columns = max(columns, line.width())
        return min(rows, max(area.rows, 0)), min(columns, max(area.columns, 0))

    func draw(into: screen.Screen, area: termui.Rect):
        let lines = strings.split(self.content, "\n")
        for row, line in lines:
            if row >= area.rows:
                return
            into.write(area, row, 0, line, self.style)

# A border plus one child.  The child is optional so an empty panel is still
# useful as a frame or a measured placeholder.  View fields are safe here:
# the concrete views in this module are value-only and the panel never
# replaces or mutates a child while it is being drawn.
struct Panel: View:
    title: string = ""
    child: View? = none
    style: termui.Style = termui.Style()

    func measure(area: termui.Rect) -> (long, long):
        let child = self.child
        if child == none:
            return min(max(area.rows, 0), 2), min(max(area.columns, 0), 2)
        let inside = area.inset(1)
        let rows, columns = child.measure(inside)
        return min(rows + 2, max(area.rows, 0)), min(columns + 2, max(area.columns, 0))

    func draw(into: screen.Screen, area: termui.Rect):
        let inside = border.Border(title = self.title, style = self.style).draw(into, area)
        let child = self.child
        if child != none:
            child.draw(into, inside)

# A two-child flex primitive.  `horizontal` divides columns; `vertical`
# divides rows.  `ratio` is a percentage for the first child and is clamped,
# so a resize cannot produce an invalid rectangle.  A non-zero gap is left
# blank between the children.
enum Axis:
    horizontal
    vertical

struct Split: View:
    first: View
    second: View
    axis: Axis = Axis.horizontal
    ratio: long = 50
    gap: long = 0

    func measure(area: termui.Rect) -> (long, long):
        let first_rows, first_columns = self.first.measure(area)
        let second_rows, second_columns = self.second.measure(area)
        let separation = max(self.gap, 0)
        match self.axis:
            horizontal:
                return max(first_rows, second_rows), first_columns + second_columns + separation
            vertical:
                return first_rows + second_rows + separation, max(first_columns, second_columns)

    func draw(into: screen.Screen, area: termui.Rect):
        let percentage = clamp(self.ratio, 0, 100)
        let separation = min(max(self.gap, 0), max(area.columns - 1, 0))
        match self.axis:
            horizontal:
                let available = max(area.columns - separation, 0)
                let first_width = long(available * percentage / 100)
                let first_area, rest = area.split_left(first_width)
                let gap_area, second_area = rest.split_left(separation)
                self.first.draw(into, first_area)
                self.second.draw(into, second_area)
            vertical:
                let vertical_gap = min(max(self.gap, 0), max(area.rows - 1, 0))
                let available = max(area.rows - vertical_gap, 0)
                let first_height = long(available * percentage / 100)
                let first_area, rest = area.split_top(first_height)
                let gap_area, second_area = rest.split_top(vertical_gap)
                self.first.draw(into, first_area)
                self.second.draw(into, second_area)
