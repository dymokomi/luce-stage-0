# A box, and the space left inside it (docs/TERMUI.md D12).
#
# "Draw a box" is one line at the call and four clipped edges, four
# corners and a clipped title inside — which is what makes this worth
# a function rather than a comment.  `draw` answers the **interior**,
# so a caller lays out inside a frame without repeating the inset.

import std.strings
import std.term
import screen
import termui

struct Border:
    title: string = ""
    style: termui.Style = termui.Style()

    # Draw the box around `area` and answer the rectangle inside it.
    # An area too small to hold a box is left alone and answers empty,
    # because a one-column pane is a resize and not a bug.
    func draw(into: screen.Screen, area: termui.Rect) -> termui.Rect:
        if area.rows < 2 or area.columns < 2:
            return termui.Rect(row = area.row, column = area.column)
        let last_row = area.rows - 1
        let last_column = area.columns - 1
        let horizontal = term.ui.horizontal()
        let vertical = term.ui.vertical()
        for column in range(1, last_column):
            into.write(area, 0, column, horizontal, self.style)
            into.write(area, last_row, column, horizontal, self.style)
        for row in range(1, last_row):
            into.write(area, row, 0, vertical, self.style)
            into.write(area, row, last_column, vertical, self.style)
        into.write(area, 0, 0, term.ui.top_left(), self.style)
        into.write(area, 0, last_column, term.ui.top_right(), self.style)
        into.write(area, last_row, 0, term.ui.bottom_left(), self.style)
        into.write(area, last_row, last_column, term.ui.bottom_right(), self.style)
        # The title sits on the top edge, clipped to what is left of
        # it, and is skipped entirely when there is no room to read it.
        if self.title != "":
            # Two spaces frame the title and the last column is the
            # corner, so what is left for the text is four less than
            # the width — one short of that and the corner goes.
            let room = last_column - 4
            if room > 0:
                let shown = self.title.take(room)
                into.write(area, 0, 2, " " + shown + " ", self.style)
        return area.inset(1)
