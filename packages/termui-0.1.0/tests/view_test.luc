# Views are values behind a small two-method interface.  These tests exercise
# both the multi-value measurement result and heterogeneous composition.

import screen
import termui
import view

func test_a_text_view_measures_and_draws_through_the_interface():
    var surface = screen.Screen.of(3, 10)
    surface.clear()
    let text = view.Text(content = "hello\nworld", style = termui.Style(foreground = 3))
    let item: view.View = text
    let rows, columns = item.measure(surface.area())
    assert(rows == 2)
    assert(columns == 5)
    item.draw(surface, surface.area())
    surface.present()
    assert(surface.front[0, 0].text == "h")
    assert(surface.front[1, 4].text == "d")
    assert(surface.front[0, 0].style.foreground == 3)

func test_panels_and_splits_compose_heterogeneous_views():
    var surface = screen.Screen.of(4, 20)
    surface.clear()
    let left = view.Text(content = "left")
    let right = view.Panel(title = "R", child = view.Text(content = "right"))
    let layout: view.View = view.Split(first = left, second = right, ratio = 50)
    var items = new list(view.View)
    items.append(left)
    items.append(right)
    items.append(layout)
    let measured_rows, measured_columns = items[2].measure(surface.area())
    assert(measured_rows == 3)
    assert(measured_columns == 11)
    items[2].draw(surface, surface.area())
    surface.present()
    assert(surface.front[0, 0].text == "l")
    assert(surface.front[0, 10].text == "┌")
    assert(surface.front[1, 11].text == "r")

func test_a_panel_without_a_child_is_still_a_frame():
    var surface = screen.Screen.of(3, 8)
    surface.clear()
    let item: view.View = view.Panel(title = "empty")
    let rows, columns = item.measure(surface.area())
    assert(rows == 2 and columns == 2)
    item.draw(surface, surface.area())
    surface.present()
    assert(surface.front[0, 0].text == "┌")
    assert(surface.front[2, 7].text == "┘")
