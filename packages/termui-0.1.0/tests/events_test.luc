# A key name becomes a member; an event is a value.

import events

func test_every_host_key_name_has_a_member():
    assert(events.Events.key_of("ctrl_s") == events.Key.ctrl_s)
    assert(events.Events.key_of("page_down") == events.Key.page_down)
    assert(events.Events.key_of("escape") == events.Key.escape)

func test_a_name_this_version_does_not_know_is_unknown():
    assert(events.Events.key_of("hyper_meta") == events.Key.unknown)
    assert(events.Events.key_of("") == events.Key.unknown)

func test_an_event_carries_its_own_data():
    let m = events.Mouse(kind = events.Pointer.press, row = 7, column = 2, modifiers = 5)
    match events.Event.mouse(pointer = m):
        mouse(pointer):
            assert(pointer.row == 7)
            assert(pointer.column == 2)
            assert(pointer.has_shift())
            assert(pointer.has_control())
            assert(not pointer.has_alt())
        closed:
            assert(false)
        resize:
            assert(false)
        key(pressed):
            assert(false)
        text(typed):
            assert(false)

func test_match_reaches_the_arm_the_value_names():
    match events.Event.key(pressed = events.Key.ctrl_q):
        key(pressed):
            assert(pressed == events.Key.ctrl_q)
        else:
            assert(false)
    match events.Event.text(typed = "x"):
        text(typed):
            assert(typed == "x")
        else:
            assert(false)
