# Application ownership and the sole terminal lifecycle loop.

import std.term
import model
import input
import canvas
import view

interface Application:
    func body() -> view.View

# Run until input closes or a visible view answers `quit`. The same tree is
# drawn and then receives the event, so pointer geometry can never be newer or
# older than what the person saw.
func run(app: Application):
    let screen = new canvas.Screen(term.rows(), term.cols())
    let events = new input.Stream()
    while true:
        screen.resize(term.rows(), term.cols())
        let surface = screen.surface
        surface.clear()
        let root = app.body()
        let requested = root.draw(surface, surface.area())
        screen.present()
        var cursor = model.Cursor()
        if requested != none:
            cursor = requested
        term.move(
            clamp(cursor.row, 0, max(surface.rows - 1, 0)),
            clamp(cursor.column, 0, max(surface.columns - 1, 0)),
        )
        term.flush()

        let event = events.next()
        match event:
            closed:
                return
            resize:
                continue
            else:
                if view.route(root, event, surface.area()) == model.Response.quit:
                    return
