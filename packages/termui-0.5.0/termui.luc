# Declarative terminal applications through grouped public modules.
#
# An application builds its layout once — components constructed with
# whatever model they observe — hands it to `Application.set_layout`,
# and `start()` owns terminal sizing, frame buffering, drawing, cursor
# placement, flushing, input and shutdown.  Components are classes
# conforming to `View`; a program's own conformers compose with the
# shipped ones through the same two-method contract.
#
# This module is the core: `Application`, the `View` contract, the
# drawing `Surface`, and the value and event vocabulary.  The rest of
# the surface is grouped where reading an import line says what it is:
#
#     from termui import Application, View
#     from termui.layout import VStack, HStack
#     from termui.constraints import Fixed, Grow
#     from termui.widgets import Label, Panel, Rows
#
# `canvas`, `model`, `input`, `view`, and `runtime` are implementation
# modules; their public vocabulary is re-exported here.

import model
import input
import canvas
import view
import runtime as app_runtime

alias Color = model.Color
alias Style = model.Style
alias Rect = model.Rect
alias Span = model.Span
alias Line = model.Line
alias Cursor = model.Cursor
alias Response = model.Response
alias Edges = model.Edges

alias Key = input.Key
alias KeyPress = input.KeyPress
alias Pointer = input.Pointer
alias Mouse = input.Mouse
alias Event = input.Event

alias View = view.View
alias Surface = canvas.Surface
alias Snapshot = canvas.Snapshot
alias Application = app_runtime.Application

func plain(content: str, style: Style = Style()) -> Line:
    return model.plain(content, style)

func route(child: View, event: Event, area: Rect) -> Response:
    return view.route(child, event, area)

func snapshot(content: View, rows: i64, columns: i64) -> Snapshot:
    return view.snapshot(content, rows, columns)

