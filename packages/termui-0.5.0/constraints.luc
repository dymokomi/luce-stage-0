# Sizing constraints, and the total one-axis solver that reads them.
#
# `from termui.constraints import Fixed, Grow` is the public spelling;
# the solver below is the package's own machinery.

from model import Rect

# What one child asks of its axis.  Any conformer lays out: the
# shipped Fixed, Grow, Ratio, and Preferred are the common shapes, and
# a program's own constraint composes exactly the same way.
pub interface Constraint:
    # The floor this child never gives up until the axis itself runs
    # out.
    func minimum() -> i64
    # The ceiling surplus never pushes past; none is unbounded.
    func maximum() -> i64?
    # The share of surplus this child claims relative to the other
    # growers.  Zero never grows past its preference or minimum.
    func weight() -> i64
    # The preferred size given the usable axis, or none.  A preference
    # yields first when space runs short — it asked for comfort, not
    # necessity.
    func preference(axis: i64) -> i64?

# Exactly `cells` — never more, never less, until the axis itself is
# smaller than everything's minimums.
pub class Fixed: Constraint:
    let cells: i64

    pub init(cells: i64):
        self.cells = cells

    pub func minimum() -> i64:
        return max(self.cells, 0)

    pub func maximum() -> i64?:
        return max(self.cells, 0)

    pub func weight() -> i64:
        return 0

    pub func preference(axis: i64) -> i64?:
        return none

# Keep at least `minimum`, then take surplus in proportion to
# `weight`.  The default is the main content of a screen: everything
# the siblings leave.
pub class Grow: Constraint:
    let share: i64
    let floor: i64

    pub init(weight: i64 = 1, minimum: i64 = 0):
        self.share = weight
        self.floor = minimum

    pub func minimum() -> i64:
        return max(self.floor, 0)

    pub func maximum() -> i64?:
        return none

    pub func weight() -> i64:
        return max(self.share, 0)

    pub func preference(axis: i64) -> i64?:
        return none

# A pane that scales with the terminal: `percent` of the axis, kept
# between `low` and `high`.
pub class Ratio: Constraint:
    var low: i64
    var high: i64
    let percent: i64

    pub init(low: i64, high: i64, percent: i64):
        self.low = low
        self.high = high
        self.percent = percent

    pub func minimum() -> i64:
        return max(self.low, 0)

    pub func maximum() -> i64?:
        return max(self.high, max(self.low, 0))

    pub func weight() -> i64:
        return 0

    pub func preference(axis: i64) -> i64?:
        return floor_div(axis * clamp(self.percent, 0, 100), 100)

# A pane with a remembered size — after a person drags a divider —
# kept between `low` and `high`.
pub class Preferred: Constraint:
    var low: i64
    let ideal: i64
    var high: i64

    pub init(low: i64, ideal: i64, high: i64):
        self.low = low
        self.ideal = ideal
        self.high = high

    pub func minimum() -> i64:
        return max(self.low, 0)

    pub func maximum() -> i64?:
        return max(self.high, max(self.low, 0))

    pub func weight() -> i64:
        return 0

    pub func preference(axis: i64) -> i64?:
        return self.ideal

func floor_div(numerator: i64, denominator: i64) -> i64:
    return i64(floor(numerator / denominator))

# Turn one Constraint per child into non-negative sizes.  Preferences
# compress before growers, growers before rigid children, and nothing
# is ever negative or beyond the axis.
pub func resolve(total: i64, spacing: i64, constraints: list[Constraint]) -> list[i64]:
    let count = len(constraints)
    var sizes = list[i64]()
    if count == 0:
        return sizes
    let gap = max(spacing, 0)
    let usable = max(total - gap * (count - 1), 0)
    var prefers = list[bool]()
    var claimed: i64 = 0
    var total_weight: i64 = 0

    for constraint in constraints:
        let floor_size = constraint.minimum()
        var size = floor_size
        let wanted = constraint.preference(usable)
        if wanted != none:
            size = wanted
        let ceiling = constraint.maximum()
        if ceiling != none:
            size = min(size, max(ceiling, floor_size))
        size = max(size, floor_size)
        sizes.append(size)
        prefers.append(wanted != none)
        claimed += size
        total_weight += constraint.weight()

    if claimed <= usable:
        let remaining = usable - claimed
        if total_weight > 0:
            var given: i64 = 0
            var first: i64 = -1
            for index in range(0, count):
                let weight = constraints[index].weight()
                if weight > 0:
                    var share = floor_div(remaining * weight, total_weight)
                    let ceiling = constraints[index].maximum()
                    if ceiling != none:
                        share = min(share, max(ceiling - sizes[index], 0))
                    sizes[index] += share
                    given += share
                    if first < 0:
                        first = index
            if first >= 0:
                var leftover = remaining - given
                let ceiling = constraints[first].maximum()
                if ceiling != none:
                    leftover = min(leftover, max(ceiling - sizes[first], 0))
                sizes[first] += leftover
        return sizes

    var over = claimed - usable
    # First return preferring children's slack down to their floor.
    for index in range(0, count):
        if over <= 0:
            break
        if prefers[index]:
            let cut = min(max(sizes[index] - constraints[index].minimum(), 0), over)
            sizes[index] -= cut
            over -= cut
    # On a truly tiny axis, preferring panes disappear before primary
    # content.
    for index in range(0, count):
        if over <= 0:
            break
        if prefers[index]:
            let cut = min(sizes[index], over)
            sizes[index] -= cut
            over -= cut
    for index in range(0, count):
        if over <= 0:
            break
        if constraints[index].weight() > 0:
            let cut = min(sizes[index], over)
            sizes[index] -= cut
            over -= cut
    # Rigid children are the final claim.  This branch is reached only
    # when the complete axis is smaller than every other child reduced
    # to zero.
    for index in range(0, count):
        if over <= 0:
            break
        let cut = min(sizes[index], over)
        sizes[index] -= cut
        over -= cut
    return sizes

pub func row(area: Rect, spacing: i64, constraints: list[Constraint]) -> list[Rect]:
    let widths = resolve(area.columns, spacing, constraints)
    var rectangles = list[Rect]()
    var at_column = area.column
    let gap = max(spacing, 0)
    for width in widths:
        rectangles.append(Rect(row = area.row, column = at_column, rows = area.rows, columns = width))
        at_column += width + gap
    return rectangles

pub func column(area: Rect, spacing: i64, constraints: list[Constraint]) -> list[Rect]:
    let heights = resolve(area.rows, spacing, constraints)
    var rectangles = list[Rect]()
    var at_row = area.row
    let gap = max(spacing, 0)
    for height in heights:
        rectangles.append(Rect(row = at_row, column = area.column, rows = height, columns = area.columns))
        at_row += height + gap
    return rectangles
