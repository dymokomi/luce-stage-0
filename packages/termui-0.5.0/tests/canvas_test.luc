import canvas
import model

pub func test_writes_clip_to_the_assigned_rectangle():
    let surface = canvas.Surface(3, 6)
    surface.clear()
    let right = model.Rect(row = 0, column = 3, rows = 2, columns = 3)
    surface.write(right, 0, 0, "abcdef", model.Style(foreground = 2))
    let frame = surface.snapshot(none)
    assert(frame.cell(0, 3).text == "a")
    assert(frame.cell(0, 5).text == "c")
    assert(frame.cell(0, 0).text == " ")
    assert(frame.cell(0, 3).style.foreground == 2)

pub func test_a_snapshot_owns_characters_styles_and_cursor():
    let surface = canvas.Surface(2, 5)
    surface.clear()
    surface.write(surface.area(), 0, 0, "hé", model.Style(foreground = 3))
    let frame = surface.snapshot(model.Cursor(row = 0, column = 2))
    assert(frame.cell(0, 0).text == "h")
    assert(frame.cell(0, 1).text == "é")
    assert(frame.line(0) == "hé   ")
    assert(frame.cursor != none)
    let cursor = frame.cursor else model.Cursor()
    assert(cursor.column == 2)
    surface.put(0, 0, "x", model.Style())
    assert(frame.cell(0, 0).text == "h")

pub func test_crossing_strokes_merge_into_the_right_junction():
    # Two borders laid independently share cells; the second stroke
    # reads what the first left and the union picks the glyph, so a
    # `─` crossed by a `│` is a `┼` and a corner meeting an edge is a
    # `├` — without either caller knowing the other exists.
    let surface = canvas.Surface(3, 3)
    surface.clear()
    let area = surface.area()
    surface.stroke(area, 1, 1, right = true, left = true)
    assert(surface.cell_at(1, 1).text == "─")
    surface.stroke(area, 1, 1, up = true, down = true)
    assert(surface.cell_at(1, 1).text == "┼")
    surface.stroke(area, 0, 0, right = true, down = true)
    surface.stroke(area, 0, 0, up = true, down = true)
    assert(surface.cell_at(0, 0).text == "├")
    # A non-border cell contributes nothing to the merge.
    surface.put(2, 2, "x", model.Style())
    surface.stroke(area, 2, 2, left = true)
    assert(surface.cell_at(2, 2).text == "╴")

pub func test_resize_replaces_both_grids_and_marks_the_frame_unknown():
    let screen = canvas.Screen(2, 3)
    screen.surface.clear()
    assert(screen.present().cells == 6)
    assert(screen.present().cells == 0)
    screen.resize(3, 4)
    screen.surface.clear()
    assert(screen.present().cells == 12)

pub func test_a_one_cell_change_is_one_diff_run():
    let screen = canvas.Screen(2, 4)
    screen.surface.clear()
    discard(screen.present())
    screen.surface.put(1, 2, "x", model.Style(foreground = 4))
    let painted = screen.present()
    assert(painted.cells == 1)
    assert(painted.runs == 1 and painted.moves == 1)
