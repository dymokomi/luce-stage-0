import model

func test_rectangles_clip_splits_and_points_at_every_edge():
    let area = model.Rect(row = 2, column = 3, rows = 4, columns = 6)
    assert(area.contains(2, 3))
    assert(area.contains(5, 8))
    assert(not area.contains(6, 8))
    assert(not area.contains(5, 9))
    let head, rest = area.split_top(99)
    assert(head.rows == 4 and rest.rows == 0)
    assert(area.inset(99).is_empty())

func test_a_line_is_styled_runs_measured_as_characters():
    let spans: list[model.Span] = [
        model.Span(text = "hé", style = model.Style(foreground = 1)),
        model.Span(text = "llo", style = model.Style(foreground = 2)),
    ]
    let line = model.Line(spans = spans)
    assert(line.width() == 5)
    assert(model.plain("ok").width() == 2)

func test_values_copy_without_hidden_terminal_state():
    let original = model.Cursor(row = 1, column = 2)
    var changed = original
    changed.row = 9
    assert(original.row == 1 and changed.row == 9)
