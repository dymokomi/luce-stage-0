import termui
from layout import VStack
from widgets import Fill, EventHost
from constraints import Fixed

# A retained component: constructed once, drawing its current state
# each frame and updating that state in place when routed an event.
pub class Ticker: termui.View:
    pub value: i64

    pub init(value: i64):
        self.value = value

    pub func draw(surface: termui.Surface, area: termui.Rect) -> termui.Cursor?:
        surface.write(area, 0, 0, "count " + str(self.value), termui.Style())
        return none

    pub func dispatch(event: termui.Event, area: termui.Rect) -> termui.Response:
        match event:
            key(press):
                if press.key == termui.Key.enter:
                    self.value += 1
                    return termui.Response.handled
            else:
                return termui.Response.ignored
        return termui.Response.ignored

pub func test_a_retained_layout_updates_in_place():
    var stack = VStack()
    stack.add(Fill("."))
    stack.add(Ticker(41), size = Fixed(1))

    var app = termui.Application()
    app.set_layout(stack)

    let first = termui.snapshot(stack, 3, 10)
    assert(first.line(2) == "count 41  ")
    let response = termui.route(
        stack,
        termui.Event.key(press = termui.KeyPress(key = termui.Key.enter)),
        termui.Rect(rows = 3, columns = 10),
    )
    assert(response == termui.Response.handled)
    let second = termui.snapshot(stack, 3, 10)
    assert(second.line(2) == "count 42  ")
