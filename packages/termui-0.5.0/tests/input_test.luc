import input
import std.term

func test_the_vocabulary_is_the_terminals_own():
    # The aliases are transparent: a termui Key is a std.term Key, so
    # events pass between termui code and plain terminal code without
    # translation.  Name decoding itself belongs to std.term and is
    # proven by the standard library's own specification.
    let pressed: term.Key = input.Key.ctrl_s
    assert(pressed == term.Key.ctrl_s)
    let kind: term.Pointer = input.Pointer.wheel
    assert(kind == term.Pointer.wheel)
    let held: term.KeyPress = input.KeyPress(key = input.Key.left, shift = true)
    assert(held.key == term.Key.left and held.shift and not held.control)

func test_an_event_owns_the_mouse_snapshot_it_carries():
    let mouse = input.Mouse(kind = input.Pointer.press, row = 7, column = 2, modifiers = 5)
    match input.Event.mouse(pointer = mouse):
        mouse(pointer):
            assert(pointer.row == 7 and pointer.column == 2)
            assert(pointer.has_shift() and pointer.has_control())
            assert(not pointer.has_alt())
        else:
            assert(false)
