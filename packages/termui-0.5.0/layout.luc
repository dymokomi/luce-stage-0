# The layout containers: stacks that divide an axis among their
# children by Constraint.
#
# `from termui.layout import VStack, HStack` is the public spelling.

from constraints import Constraint, Grow, row, column
from canvas import Surface
from input import Event
from model import Rect, Response, Cursor
from view import View, route

# Pairing a child with its constraint makes a row/column mismatch
# impossible.
private struct Slot:
    size: Constraint
    content: View

private func constraints_of(slots: list[Slot]) -> list[Constraint]:
    var sizes = list[Constraint]()
    for slot in slots:
        sizes.append(slot.size)
    return sizes

# When absent, a child grows: filling what the siblings leave is the
# most common intent, so it is the unstated one.
private func slot_constraint(size: Constraint?) -> Constraint:
    if size == none:
        return Grow()
    return size


class VStack: View:
    private slots: list[Slot]
    private spacing: i64

    init(spacing: i64 = 0):
        self.slots = list[Slot]()
        self.spacing = spacing

    func add(child: View, size: Constraint? = none):
        self.slots.append(Slot(size = slot_constraint(size), content = child))

    # Retained layouts reshape by slot: a drag hands a pane its new
    # constraint, and a hidden pane is `fixed(0)` — zero cells draw
    # nothing and contain no pointer, so hiding needs no tree surgery.
    func resize(index: i64, size: Constraint):
        if index < 0 or index >= len(self.slots):
            return
        self.slots[index] = Slot(size = size, content = self.slots[index].content)

    func draw(surface: Surface, area: Rect) -> Cursor?:
        let rectangles = column(area, self.spacing, constraints_of(self.slots))
        var cursor: Cursor? = none
        for index in range(0, min(len(self.slots), len(rectangles))):
            let found = self.slots[index].content.draw(surface, rectangles[index])
            if cursor == none:
                cursor = found
        return cursor

    func dispatch(event: Event, area: Rect) -> Response:
        let rectangles = column(area, self.spacing, constraints_of(self.slots))
        for index in range(0, min(len(self.slots), len(rectangles))):
            let response = route(self.slots[index].content, event, rectangles[index])
            if response != Response.ignored:
                return response
        return Response.ignored

class HStack: View:
    private slots: list[Slot]
    private spacing: i64

    init(spacing: i64 = 0):
        self.slots = list[Slot]()
        self.spacing = spacing

    func add(child: View, size: Constraint? = none):
        self.slots.append(Slot(size = slot_constraint(size), content = child))

    # Retained layouts reshape by slot: a drag hands a pane its new
    # constraint, and a hidden pane is `fixed(0)` — zero cells draw
    # nothing and contain no pointer, so hiding needs no tree surgery.
    func resize(index: i64, size: Constraint):
        if index < 0 or index >= len(self.slots):
            return
        self.slots[index] = Slot(size = size, content = self.slots[index].content)

    func draw(surface: Surface, area: Rect) -> Cursor?:
        let rectangles = row(area, self.spacing, constraints_of(self.slots))
        var cursor: Cursor? = none
        for index in range(0, min(len(self.slots), len(rectangles))):
            let found = self.slots[index].content.draw(surface, rectangles[index])
            if cursor == none:
                cursor = found
        return cursor

    func dispatch(event: Event, area: Rect) -> Response:
        let rectangles = row(area, self.spacing, constraints_of(self.slots))
        for index in range(0, min(len(self.slots), len(rectangles))):
            let response = route(self.slots[index].content, event, rectangles[index])
            if response != Response.ignored:
                return response
        return Response.ignored

# Children draw in list order, so the last is visually on top — and
# events visit the visually topmost child first.
class ZStack: View:
    private children: list[View]

    init():
        self.children = list[View]()

    func add(child: View):
        self.children.append(child)

    func draw(surface: Surface, area: Rect) -> Cursor?:
        var cursor: Cursor? = none
        for child in self.children:
            let found = child.draw(surface, area)
            if found != none:
                cursor = found
        return cursor

    func dispatch(event: Event, area: Rect) -> Response:
        var index = len(self.children) - 1
        while index >= 0:
            let response = route(self.children[index], event, area)
            if response != Response.ignored:
                return response
            index -= 1
        return Response.ignored
