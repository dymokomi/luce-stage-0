# The view contract, the one routing law, and host-free rendering.
#
# A component is any conformer of `View`: the shipped classes in
# components.luc and a program's own alike.  `draw` describes cells and
# answers the cursor the subtree wants; `dispatch` answers one event.
# Both receive the exact rectangle the parent assigned, so geometry can
# never disagree between drawing and routing.

from model import Rect, Response, Cursor
from input import Event
from canvas import Surface, Snapshot

pub interface View:
    func draw(surface: Surface, area: Rect) -> Cursor?
    func dispatch(event: Event, area: Rect) -> Response

# **The routing law.**  A container never calls `child.dispatch`
# directly — it calls `route(child, event, child_area)`.  Route owns
# the pre-checks every container would otherwise repeat: lifecycle
# events (`closed`, `resize`) belong to the runtime and enter no
# subtree, and a pointer event enters only a rectangle containing the
# pointer.  Keyboard and text events continue until a child accepts
# them.  Because the checks live here, a user container written
# against `route` gets the same discipline as the shipped ones.
pub func route(child: View, event: Event, area: Rect) -> Response:
    match event:
        closed:
            return Response.ignored
        resize:
            return Response.ignored
        mouse(pointer):
            if not area.contains(pointer.row, pointer.column):
                return Response.ignored
            return child.dispatch(event, area)
        else:
            return child.dispatch(event, area)

# Render one tree host-free: tests and previews see exactly the cells
# the live loop would present.
pub func snapshot(content: View, rows: i64, columns: i64) -> Snapshot:
    let surface = Surface(rows, columns)
    surface.clear()
    let cursor = content.draw(surface, surface.area())
    return surface.snapshot(cursor)
