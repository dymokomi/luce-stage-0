# The public values shared by termui's declarative tree.
#
# These are transparent descriptions. They own no terminal and perform no
# host IO. The application builds them; the hidden runtime interprets them.

import std.strings

pub enum Color:
    black
    red
    green
    yellow
    blue
    magenta
    cyan
    white
    bright_black
    bright_red
    bright_green
    bright_yellow
    bright_blue
    bright_magenta
    bright_cyan
    bright_white

pub struct Style:
    pub let foreground: i64 = 7
    pub let background: i64 = -1
    pub let bold: bool = false

    pub static func of(colour: Color) -> Style:
        return Style(foreground = i64(colour))

# A rectangle of terminal cells. Every operation is total because a small
# terminal is a normal layout input, not an exceptional state.
pub struct Rect:
    pub var row: i64 = 0
    pub let column: i64 = 0
    pub var rows: i64 = 0
    pub var columns: i64 = 0

    pub func is_empty() -> bool:
        return self.rows <= 0 or self.columns <= 0

    pub func contains(row: i64, column: i64) -> bool:
        return row >= self.row and row < self.row + self.rows and column >= self.column and column < self.column + self.columns

    pub func split_top(height: i64) -> (Rect, Rect):
        let taken = clamp(height, 0, self.rows)
        let top = Rect(row = self.row, column = self.column, rows = taken, columns = self.columns)
        let rest = Rect(
            row = self.row + taken,
            column = self.column,
            rows = self.rows - taken,
            columns = self.columns,
        )
        return top, rest

    pub func split_bottom(height: i64) -> (Rect, Rect):
        let taken = clamp(height, 0, self.rows)
        let rest = Rect(
            row = self.row,
            column = self.column,
            rows = self.rows - taken,
            columns = self.columns,
        )
        let bottom = Rect(
            row = self.row + self.rows - taken,
            column = self.column,
            rows = taken,
            columns = self.columns,
        )
        return bottom, rest

    pub func split_left(width: i64) -> (Rect, Rect):
        let taken = clamp(width, 0, self.columns)
        let left = Rect(row = self.row, column = self.column, rows = self.rows, columns = taken)
        let rest = Rect(
            row = self.row,
            column = self.column + taken,
            rows = self.rows,
            columns = self.columns - taken,
        )
        return left, rest

    pub func split_right(width: i64) -> (Rect, Rect):
        let taken = clamp(width, 0, self.columns)
        let rest = Rect(
            row = self.row,
            column = self.column,
            rows = self.rows,
            columns = self.columns - taken,
        )
        let right = Rect(
            row = self.row,
            column = self.column + self.columns - taken,
            rows = self.rows,
            columns = taken,
        )
        return right, rest

    pub func inset(amount: i64) -> Rect:
        let margin = max(amount, 0)
        return Rect(
            row = self.row + margin,
            column = self.column + margin,
            rows = max(self.rows - 2 * margin, 0),
            columns = max(self.columns - 2 * margin, 0),
        )

pub struct Span:
    pub let text: str = ""
    pub let style: Style = Style()

# One styled terminal row. A provider builds a Line for the current frame;
# the view traversal owns clipping and placement.
pub struct Line:
    pub let spans: list[Span]

    pub func width() -> i64:
        var total: i64 = 0
        for span in self.spans:
            total += span.text.width()
        return total

pub func plain(text: str, style: Style = Style()) -> Line:
    let spans: list[Span] = [Span(text = text, style = style)]
    return Line(spans = spans)

pub struct Cursor:
    pub var row: i64 = 0
    pub let column: i64 = 0

pub enum Response:
    ignored
    handled
    quit

# Which edges a frame contributes. Omitting an edge also leaves that cell
# available to its content; the returned interior is inset only on edges that
# exist.
pub struct Edges:
    pub let top: bool = true
    pub let right: bool = true
    pub let bottom: bool = true
    pub let left: bool = true
