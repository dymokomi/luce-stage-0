# The application: a retained layout and the sole terminal lifecycle
# loop that drives it.
#
# Build the tree once, hand it to `set_layout`, and `start()` owns the
# terminal until input closes or a component answers `quit`.  The loop
# redraws the retained tree after every event — the cell diff makes an
# unchanged frame cheap — so components read current state in `draw`
# and update their own state in `dispatch` or through their model
# subscriptions; nothing is rebuilt.

import std.term
from model import Cursor, Response
from input import Stream
from canvas import Screen
from view import View, route

pub class Application:
    var root: View?
    var tick_ms: i64

    pub init():
        self.root = none
        self.tick_ms = -1

    # The retained tree.  Calling it again replaces the layout whole,
    # which is the retained model's one honest reshape.
    pub func set_layout(child: View):
        self.root = child

    # Ask the loop to wake at most this often even with no input, and
    # route an `idle` event through the tree — the turn components use
    # to pump held work (a language server, an animation).  Negative
    # turns ticking off, which is the default: an application that
    # holds nothing sleeps in the read.
    pub func set_tick(milliseconds: i64):
        self.tick_ms = milliseconds

    # Run until input closes or a routed event answers `quit`.  The
    # same tree is drawn and then receives the event, so pointer
    # geometry can never be newer or older than what the person saw.
    pub func start():
        let root = self.root
        if root == none:
            return
        let screen = Screen(term.rows(), term.cols())
        let events = Stream()
        while true:
            screen.resize(term.rows(), term.cols())
            let surface = screen.surface
            surface.clear()
            let requested = root.draw(surface, surface.area())
            screen.present()
            var cursor = Cursor()
            if requested != none:
                cursor = requested
            term.move(
                clamp(cursor.row, 0, max(surface.rows - 1, 0)),
                clamp(cursor.column, 0, max(surface.columns - 1, 0)),
            )
            term.flush()

            let event = events.next(self.tick_ms)
            match event:
                closed:
                    return
                resize:
                    continue
                else:
                    # `idle` routes like any event: a component that
                    # holds work pumps it, everything else ignores it,
                    # and the redraw above keeps the frame honest.
                    if route(root, event, surface.area()) == Response.quit:
                        return
