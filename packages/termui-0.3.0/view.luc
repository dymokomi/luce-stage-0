# Declarative view values and the one traversal that interprets them.

import std.strings
import std.term
import model
import input
import layout
import canvas

union View:
    empty
    label(lines: list[model.Line])
    lines(
        total: i64,
        top: i64,
        anchor: i64?,
        selected: i64?,
        render: (func(i64) -> model.Line)?,
        selected_style: model.Style,
    )
    fill(glyph: str, style: model.Style)
    hstack(items: list[Item], spacing: i64)
    vstack(items: list[Item], spacing: i64)
    zstack(children: list[View])
    panel(
        panel_children: list[View],
        title: str,
        style: model.Style,
        edges: model.Edges,
    )
    events(
        event_children: list[View],
        respond: (func(input.Event, model.Rect) -> model.Response)?,
    )
    cursor_modifier(
        cursor_children: list[View],
        locate: (func(model.Rect) -> model.Cursor?)?,
    )

    # Modifiers wrap rather than mutate. Their order is therefore represented
    # directly in the tree and interpreted by the same traversal as built-ins.
    func sized(size: layout.Length) -> Item:
        return Item(size = size, content = self)

    func on_event(respond: func(input.Event, model.Rect) -> model.Response) -> View:
        let content: list[View] = [self]
        return View.events(event_children = content, respond = respond)

    func cursor(locate: func(model.Rect) -> model.Cursor?) -> View:
        let content: list[View] = [self]
        return View.cursor_modifier(cursor_children = content, locate = locate)

# Pairing a child with its length makes a row/column mismatch impossible.
struct Item:
    size: layout.Length
    content: View

func first(children: list[View]) -> View:
    if len(children) == 0:
        return View.empty
    return children[0]

func item_lengths(items: list[Item]) -> list[layout.Length]:
    var lengths = new list[layout.Length]
    for item in items:
        lengths.append(item.size)
    return lengths

# The visible first row for a scrolling set. When a selection exists, keep it
# inside the window. This function is public through the facade so pointer and
# cursor callbacks can interpret the exact same window the renderer used.
func visible_top(top: i64, total: i64, selected: i64?, height: i64) -> i64:
    if total <= 0 or height <= 0:
        return 0
    var result = clamp(top, 0, max(total - height, 0))
    if selected == none:
        return result
    let chosen = clamp(selected, 0, total - 1)
    if chosen < result:
        result = chosen
    elif chosen >= result + height:
        result = chosen - height + 1
    return clamp(result, 0, max(total - height, 0))

func draw_line(
    surface: canvas.Surface,
    area: model.Rect,
    row: i64,
    line: model.Line,
    override: model.Style?,
):
    var at_column: i64 = 0
    for span in line.spans:
        if at_column >= area.columns:
            return
        var style = span.style
        if override != none:
            style = override
        surface.write(area, row, at_column, span.text, style)
        at_column += span.text.width()

func blank_line(index: i64) -> model.Line:
    return model.plain("")

struct Strokes:
    up: bool = false
    right: bool = false
    down: bool = false
    left: bool = false

    func glyph() -> str:
        return term.ui.junction(top = self.up, right = self.right, bottom = self.down, left = self.left)

    func merged(other: Strokes) -> Strokes:
        return Strokes(
            up = self.up or other.up,
            right = self.right or other.right,
            down = self.down or other.down,
            left = self.left or other.left,
        )

const STROKES = {
    "┼": Strokes(up = true, right = true, down = true, left = true),
    "├": Strokes(up = true, right = true, down = true),
    "┤": Strokes(up = true, down = true, left = true),
    "┴": Strokes(up = true, right = true, left = true),
    "┬": Strokes(right = true, down = true, left = true),
    "│": Strokes(up = true, down = true),
    "─": Strokes(right = true, left = true),
    "└": Strokes(up = true, right = true),
    "┘": Strokes(up = true, left = true),
    "┌": Strokes(right = true, down = true),
    "┐": Strokes(down = true, left = true),
    "╵": Strokes(up = true),
    "╷": Strokes(down = true),
    "╶": Strokes(right = true),
    "╴": Strokes(left = true),
}

func strokes_of(glyph: str) -> Strokes:
    let found = STROKES.get(glyph)
    if found == none:
        return Strokes()
    return found

func stroke(
    surface: canvas.Surface,
    area: model.Rect,
    row: i64,
    column: i64,
    add: Strokes,
    style: model.Style,
):
    if row < 0 or row >= area.rows or column < 0 or column >= area.columns:
        return
    let absolute_row = area.row + row
    let absolute_column = area.column + column
    let prior = strokes_of(surface.cell_at(absolute_row, absolute_column).text)
    surface.put(absolute_row, absolute_column, add.merged(prior).glyph(), style)

func frame_interior(area: model.Rect, edges: model.Edges) -> model.Rect:
    var at_row = area.row
    var at_column = area.column
    var rows = area.rows
    var columns = area.columns
    if edges.top:
        at_row += 1
        rows -= 1
    if edges.bottom:
        rows -= 1
    if edges.left:
        at_column += 1
        columns -= 1
    if edges.right:
        columns -= 1
    return model.Rect(
        row = at_row,
        column = at_column,
        rows = max(rows, 0),
        columns = max(columns, 0),
    )

func draw_frame(
    surface: canvas.Surface,
    area: model.Rect,
    title: str,
    style: model.Style,
    edges: model.Edges,
) -> model.Rect:
    if area.is_empty():
        return frame_interior(area, edges)
    let last_row = area.rows - 1
    let last_column = area.columns - 1
    if edges.top:
        for at_column in range(0, area.columns):
            stroke(surface, area, 0, at_column, Strokes(right = at_column < last_column, left = at_column > 0), style)
    if edges.bottom:
        for at_column in range(0, area.columns):
            stroke(surface, area, last_row, at_column, Strokes(right = at_column < last_column, left = at_column > 0), style)
    if edges.left:
        for at_row in range(0, area.rows):
            stroke(surface, area, at_row, 0, Strokes(up = at_row > 0, down = at_row < last_row), style)
    if edges.right:
        for at_row in range(0, area.rows):
            stroke(surface, area, at_row, last_column, Strokes(up = at_row > 0, down = at_row < last_row), style)
    if edges.top and title != "" and last_column > 4:
        let shown = title.take(last_column - 4)
        surface.write(area, 0, 2, " " + shown + " ", style)
    return frame_interior(area, edges)

func first_cursor(current: model.Cursor?, found: model.Cursor?) -> model.Cursor?:
    if current != none:
        return current
    return found

# Draw one complete tree and answer its requested cursor. This is the only
# rendering interpretation of View; snapshots and the live loop both call it.
func draw(node: View, surface: canvas.Surface, area: model.Rect) -> model.Cursor?:
    match node:
        empty:
            return none
        label(lines):
            for at_row, line in lines:
                if at_row >= area.rows:
                    break
                draw_line(surface, area, at_row, line, none)
            return none
        lines(total, top, anchor, selected, render, selected_style):
            let provider = render else blank_line
            let start = visible_top(top, total, anchor, area.rows)
            let chosen = selected else -1
            for at_row in range(0, area.rows):
                let index = start + at_row
                if index >= total:
                    break
                let line = provider(index)
                if index == chosen:
                    surface.fill(
                        model.Rect(row = area.row + at_row, column = area.column, rows = 1, columns = area.columns),
                        " ",
                        selected_style,
                    )
                    draw_line(surface, area, at_row, line, selected_style)
                else:
                    draw_line(surface, area, at_row, line, none)
            return none
        fill(glyph, style):
            surface.fill(area, glyph, style)
            return none
        hstack(items, spacing):
            let rectangles = layout.row(area, spacing, item_lengths(items))
            var cursor: model.Cursor? = none
            for index in range(0, min(len(items), len(rectangles))):
                cursor = first_cursor(cursor, draw(items[index].content, surface, rectangles[index]))
            return cursor
        vstack(items, spacing):
            let rectangles = layout.column(area, spacing, item_lengths(items))
            var cursor: model.Cursor? = none
            for index in range(0, min(len(items), len(rectangles))):
                cursor = first_cursor(cursor, draw(items[index].content, surface, rectangles[index]))
            return cursor
        zstack(children):
            var cursor: model.Cursor? = none
            for child in children:
                let found = draw(child, surface, area)
                if found != none:
                    cursor = found
            return cursor
        panel(panel_children, title, style, edges):
            let interior = draw_frame(surface, area, title, style, edges)
            return draw(first(panel_children), surface, interior)
        events(event_children, respond):
            return draw(first(event_children), surface, area)
        cursor_modifier(cursor_children, locate):
            let child_cursor = draw(first(cursor_children), surface, area)
            let provider = locate
            if provider == none:
                return child_cursor
            let own = provider(area)
            if own != none:
                return own
            return child_cursor

func pointer_of(event: input.Event) -> input.Mouse?:
    match event:
        mouse(pointer):
            return pointer
        else:
            return none

func dispatch_children(
    items: list[Item],
    rectangles: list[model.Rect],
    event: input.Event,
) -> model.Response:
    for index in range(0, min(len(items), len(rectangles))):
        let response = dispatch(items[index].content, event, rectangles[index])
        if response != model.Response.ignored:
            return response
    return model.Response.ignored

# Route one event through the geometry that was drawn. A handler sees the
# event before its child, so a root modifier can own global commands.
func dispatch(node: View, event: input.Event, area: model.Rect) -> model.Response:
    match event:
        closed:
            return model.Response.ignored
        resize:
            return model.Response.ignored
        else:
            let pointer = pointer_of(event)
            if pointer != none:
                let at = pointer
                if not area.contains(at.row, at.column):
                    return model.Response.ignored
            match node:
                empty:
                    return model.Response.ignored
                label(lines):
                    return model.Response.ignored
                lines(total, top, anchor, selected, render, selected_style):
                    return model.Response.ignored
                fill(glyph, style):
                    return model.Response.ignored
                hstack(items, spacing):
                    return dispatch_children(items, layout.row(area, spacing, item_lengths(items)), event)
                vstack(items, spacing):
                    return dispatch_children(items, layout.column(area, spacing, item_lengths(items)), event)
                zstack(children):
                    var index = len(children) - 1
                    while index >= 0:
                        let response = dispatch(children[index], event, area)
                        if response != model.Response.ignored:
                            return response
                        index -= 1
                    return model.Response.ignored
                panel(panel_children, title, style, edges):
                    return dispatch(first(panel_children), event, frame_interior(area, edges))
                events(event_children, respond):
                    let handler = respond
                    if handler != none:
                        let response = handler(event, area)
                        if response != model.Response.ignored:
                            return response
                    return dispatch(first(event_children), event, area)
                cursor_modifier(cursor_children, locate):
                    return dispatch(first(cursor_children), event, area)

func snapshot(content: View, rows: i64, columns: i64) -> canvas.Snapshot:
    let surface = canvas.Surface(rows, columns)
    surface.clear()
    let cursor = draw(content, surface, surface.area())
    return surface.snapshot(cursor)
