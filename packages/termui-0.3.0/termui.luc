# Declarative terminal applications through one public module.
#
# An application supplies `body`; `run` owns terminal sizing, frame buffering,
# layout, drawing, cursor placement, flushing, input and shutdown.

import model
import input
import layout
import canvas
import view
import application as app_runtime

alias Color = model.Color
alias Style = model.Style
alias Rect = model.Rect
alias Span = model.Span
alias Line = model.Line
alias Cursor = model.Cursor
alias Response = model.Response
alias Edges = model.Edges

alias Key = input.Key
alias Pointer = input.Pointer
alias Mouse = input.Mouse
alias Event = input.Event

alias Length = layout.Length
alias Item = view.Item
alias View = view.View
alias Snapshot = canvas.Snapshot
alias Application = app_runtime.Application

func plain(content: str, style: Style = Style()) -> Line:
    return model.plain(content, style)

func empty() -> View:
    return View.empty

func text(content: str, style: Style = Style()) -> View:
    let one_line: list[Line] = [plain(content, style)]
    return View.text(lines = one_line)

func block(content_lines: list[Line]) -> View:
    return View.text(lines = content_lines)

func lines(
    total: i64,
    top: i64,
    selected: i64?,
    render: func(i64) -> Line,
    selected_style: Style = Style(),
) -> View:
    return View.lines(
        total = total,
        top = top,
        selected = selected,
        render = render,
        selected_style = selected_style,
    )

func fill(glyph: str = " ", style: Style = Style()) -> View:
    return View.fill(glyph = glyph, style = style)

func item(size: Length, content: View) -> Item:
    return Item(size = size, content = content)

func row(items: list[Item], spacing: i64 = 0) -> View:
    return View.row(items = items, spacing = spacing)

func column(items: list[Item], spacing: i64 = 0) -> View:
    return View.column(items = items, spacing = spacing)

func overlay(children: list[View]) -> View:
    return View.overlay(children = children)

func visible_top(top: i64, total: i64, selected: i64?, height: i64) -> i64:
    return view.visible_top(top, total, selected, height)

func snapshot(content: View, rows: i64, columns: i64) -> Snapshot:
    return view.snapshot(content, rows, columns)

func run(application: Application):
    app_runtime.run(application)
