# Terminal input snapshotted as ordinary values.
#
# The vocabulary is `std.term`'s own: `Key`, `Pointer`, and `Mouse` are
# the same types a program reading the terminal directly sees, so an
# application can pass events between termui code and plain terminal
# code without translating.  termui adds only `closed` — the end of
# input, which `term.read()` spells as absence and a declarative event
# loop wants as an ordinary case to match on.

import std.term

alias Key = term.Key
alias Pointer = term.Pointer
alias Mouse = term.Mouse

union Event:
    closed
    resize
    key(pressed: Key)
    text(typed: str)
    mouse(pointer: Mouse)

# The event stream: each `next()` answers one Event, `closed` once the
# terminal has nothing more to say.  `term.read()` copies every host
# slot before returning, so a held Event never changes under a later
# read.
class Stream:
    init():
        return

    func next() -> Event:
        let read = term.read()
        if read == none:
            return Event.closed
        match read:
            resize:
                return Event.resize
            key(pressed):
                return Event.key(pressed = pressed)
            text(typed):
                return Event.text(typed = typed)
            mouse(pointer):
                return Event.mouse(pointer = pointer)
