import termui

class Counter: termui.Application:
    value: i64

    init(value: i64):
        self.value = value

    func increment(event: termui.Event, area: termui.Rect) -> termui.Response:
        match event:
            key(pressed):
                if pressed == termui.Key.enter:
                    self.value += 1
                    return termui.Response.handled
            else:
                return termui.Response.ignored
        return termui.Response.ignored

    func body() -> termui.View:
        let status = termui.Label("count " + str(self.value)).on_event(self.increment)
        let items: list[termui.Item] = [
            termui.Fill(".").sized(termui.Length.grow(weight = 1, minimum = 0)),
            status.sized(termui.Length.fixed(cells = 1)),
        ]
        return termui.VStack(items)

func test_the_public_facade_describes_and_updates_an_application():
    let app = new Counter(41)
    let first = termui.snapshot(app.body(), 3, 10)
    assert(first.line(2) == "count 41  ")
    let response = app.increment(
        termui.Event.key(pressed = termui.Key.enter),
        termui.Rect(rows = 3, columns = 10),
    )
    assert(response == termui.Response.handled)
    assert(app.value == 42)
    let second = termui.snapshot(app.body(), 3, 10)
    assert(second.line(2) == "count 42  ")
