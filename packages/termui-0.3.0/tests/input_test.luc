import input

func test_every_current_host_key_name_has_a_member():
    assert(input.Stream.key_of("ctrl_s") == input.Key.ctrl_s)
    assert(input.Stream.key_of("page_down") == input.Key.page_down)
    assert(input.Stream.key_of("escape") == input.Key.escape)

func test_an_unknown_host_name_stays_an_explicit_value():
    assert(input.Stream.key_of("hyper_meta") == input.Key.unknown)
    assert(input.Stream.key_of("") == input.Key.unknown)

func test_an_event_owns_the_mouse_snapshot_it_carries():
    let mouse = input.Mouse(kind = input.Pointer.press, row = 7, column = 2, modifiers = 5)
    match input.Event.mouse(pointer = mouse):
        mouse(pointer):
            assert(pointer.row == 7 and pointer.column == 2)
            assert(pointer.has_shift() and pointer.has_control())
            assert(not pointer.has_alt())
        else:
            assert(false)
