union State:
    idle
    running(progress: i64)
func score(state: State) -> i64
    local %1 (temporary): State
    local %2 progress: i64
  b0:
    r0 = local_get %0
    local_set %1, r0
    r2 = local_get %1
    r3 = variant_tag r2
    r4 = const 0
    r5 = equal.i64 r3, r4
