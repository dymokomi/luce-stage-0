pub interface Measured:
    func measure() -> i64

pub struct Width: Measured:
    pub value: i64

    pub func measure() -> i64:
        return self.value

pub func read(value: Measured) -> i64:
    return value.measure()

pub func main(args: list[str]):
    let width = Width(value = len(args) + 4)
    print(str(read(width)))
