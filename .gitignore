/build/
.DS_Store
/.zig-cache/
/zig-out/
.bench-base/
*.o
core
# examples/dice/dice.luc writes its roll log into the cwd
dice_rolls.txt

# Agent worktrees and local Claude Code state — never part of the tree.
.claude/

# Vendored LLVM: pinned source, build tree and install prefix (./vendor-llvm.sh).
/.llvm/

# Content-addressed warm artifacts: loom's `.luce/cache/` and the test
# runner's `.luce/cache/tests/`, wherever a governed project sits.
# Deletable at any time — each entry is keyed by its program's hash and
# rebuilt on a miss.  The leading `**/` matters: a pattern with a
# middle slash anchors to this file's directory, which is how 58 of
# these were once committed from `examples/editor` without a sound.
**/.luce/cache/
