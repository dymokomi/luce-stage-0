# math — the Luce standard math module.
#
# Pure Luce over the checked builtins (sqrt, floor, ceil, abs, min,
# max, clamp live there; this module adds what they lack).  Series
# are range-reduced first.  exp/ln hold ~1e-14 relative across their
# domains; sin/cos hold ~1e-12 absolute only while |x| stays below
# about 1e4 — the pi used for reduction carries ~20 digits, so each
# decade of magnitude past that costs a digit (measured against libm:
# 1e-14 at 1e3 through 8e-3 at 1e15), and nothing traps: a huge angle
# answers a plausible number that is simply wrong.  Reduce angles to
# a revolution before calling if magnitudes run large.
#
# Randomness is a Lehmer generator in a struct: `var rng =
# math.Rng(state = 42)` then `rng.next()`.  The state is a value that
# is written back, not an object that is mutated through a borrow; no
# hidden globals.

let pi = 3.14159265358979323846
let tau = 6.28318530717958647692
let e = 2.71828182845904523536

let ln2 = 0.69314718055994530942
let ln10 = 2.30258509299404568402

# Round half away from zero: round(2.5) == 3.0, round(-2.5) == -3.0.
# The same rounding Int(x) does, which is the point — a language with
# two roundings that disagree has a bug in it (docs/NUMERICS.md).
#
# Not floor(x + 0.5), which is how this was written and how most
# people would write it: 0.49999999999999994 + 0.5 rounds up to
# exactly 1.0 in binary64, so the floor of it is 1 where the answer is
# 0.  Splitting at trunc(x) instead is exact — the subtraction below
# is exact for every x whose fraction is not already zero.
func round(x: Float) -> Float:
    let whole = trunc(x)
    let fraction = x - whole
    if fraction >= 0.5:
        return whole + 1.0
    if fraction <= -0.5:
        return whole - 1.0
    return whole

# e raised to x.  Large x overflows to infinity, very negative x
# underflows to 0.0 — IEEE semantics, no traps.
func exp(x: Float) -> Float:
    # Reduce: x = k*ln2 + r with r in [-ln2/2, ln2/2], so the series
    # below converges in a few terms; then scale by 2^k.
    let k = Int(x / ln2)
    let r = x - Float(k) * ln2
    var term = 1.0
    var total = 1.0
    for i in range(1, 15):
        term *= r / Float(i)
        total += term
    var factor = 1.0
    if k >= 0:
        for i in range(0, k):
            factor *= 2.0
    else:
        for i in range(0, 0 - k):
            factor *= 0.5
    return total * factor

# Natural logarithm.  Non-positive input is a bug, not a value: trap.
func ln(x: Float) -> Float:
    if x <= 0.0:
        trap("ln of a non-positive number")
    # Reduce to m in [1, 2) with x = m * 2^k ...
    var m = x
    var k = 0
    while m >= 2.0:
        m *= 0.5
        k += 1
    while m < 1.0:
        m *= 2.0
        k -= 1
    # ... then ln(m) = 2 * atanh(t) with t = (m-1)/(m+1), |t| <= 1/3.
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var term = t
    var total = t
    for i in range(1, 14):
        term *= t2
        total += term / Float(2 * i + 1)
    return 2.0 * total + Float(k) * ln2

func log2(x: Float) -> Float:
    return ln(x) / ln2

func log10(x: Float) -> Float:
    return ln(x) / ln10

# x raised to y.  Negative x needs a whole-number y (otherwise the
# result is not a real number: trap); 0^y is 0 for positive y, 1 for
# y == 0, and a trap for negative y.
func pow(x: Float, y: Float) -> Float:
    if x == 0.0:
        if y > 0.0:
            return 0.0
        if y == 0.0:
            return 1.0
        trap("pow: zero base with a negative exponent")
    if x > 0.0:
        return exp(y * ln(x))
    if floor(y) != y:
        trap("pow: negative base needs a whole-number exponent")
    let magnitude = exp(y * ln(0.0 - x))
    # Odd whole exponents keep the sign.
    if Int(y) % 2 == 1:
        return 0.0 - magnitude
    return magnitude

# Integer power by squaring; arithmetic is checked, so a result past
# i64 traps integer_overflow.  Negative exponents have no Int answer.
func ipow(base: Int, exponent: Int) -> Int:
    if exponent < 0:
        trap("ipow needs a non-negative exponent")
    var result = 1
    var square = base
    var left = exponent
    while left > 0:
        if left % 2 == 1:
            result *= square
        left //= 2
        if left > 0:
            square *= square
    return result

# Sine, by range reduction to (-pi, pi] and a Taylor series.
func sin(x: Float) -> Float:
    var r = x - floor(x / tau) * tau
    if r > pi:
        r -= tau
    var term = r
    var total = r
    for i in range(1, 11):
        term *= (0.0 - r * r) / Float((2 * i) * (2 * i + 1))
        total += term
    return total

func cos(x: Float) -> Float:
    return sin(x + pi / 2.0)

# Tangent; near odd multiples of pi/2 the true value diverges and the
# result is a large float, as IEEE division dictates.
func tan(x: Float) -> Float:
    return sin(x) / cos(x)

# -- vectors and statistics --------------------------------------------
#
# Whole-array operations over Array(Float, _), the numeric vector
# type.  Sums accumulate left to right — the same order both engines
# and the C benchmark twins use, so results are bit-reproducible.
# Empty arrays: sum is 0.0; the operations that have no empty answer
# (mean, vmin, vmax, variance) trap.

func sum(xs: Array(Float, _)) -> Float:
    var total = 0.0
    for i in range(0, len(xs)):
        total += xs[i]
    return total

# The reductions over an array answer `Float?`: an empty array has no
# mean, no smallest and no spread, and "there is nothing there" is the
# same fact every time with no reason worth carrying (docs/FAILURE.md).
# A caller that knows the array is non-empty writes `else` once.
func mean(xs: Array(Float, _)) -> Float?:
    if len(xs) == 0:
        return none
    return sum(xs) / Float(len(xs))

func vmin(xs: Array(Float, _)) -> Float?:
    if len(xs) == 0:
        return none
    var smallest = xs[0]
    for i in range(1, len(xs)):
        smallest = min(smallest, xs[i])
    return smallest

func vmax(xs: Array(Float, _)) -> Float?:
    if len(xs) == 0:
        return none
    var largest = xs[0]
    for i in range(1, len(xs)):
        largest = max(largest, xs[i])
    return largest

# The smallest and the largest, in one pass.  `vmin` and `vmax` walk
# the same array twice, and there could not have been a `minmax`
# before: writing one would have meant inventing a bag struct in the
# standard library (docs/RETURNS.md).
func minmax(xs: Array(Float, _)) -> (Float?, Float?):
    if len(xs) == 0:
        return none, none
    var smallest = xs[0]
    var largest = xs[0]
    for i in range(1, len(xs)):
        smallest = min(smallest, xs[i])
        largest = max(largest, xs[i])
    return smallest, largest

# The dot product; lengths must agree.
func dot(xs: Array(Float, _), ys: Array(Float, _)) -> Float:
    if len(xs) != len(ys):
        trap("dot needs arrays of one length")
    var total = 0.0
    for i in range(0, len(xs)):
        total += xs[i] * ys[i]
    return total

# The Euclidean norm.
func norm(xs: Array(Float, _)) -> Float:
    return sqrt(dot(xs, xs))

# Population variance (mean of squared deviations) and its root.
func variance(xs: Array(Float, _)) -> Float?:
    if len(xs) == 0:
        return none
    let center = mean(xs) else 0.0
    var total = 0.0
    for i in range(0, len(xs)):
        let d = xs[i] - center
        total += d * d
    return total / Float(len(xs))

func stddev(xs: Array(Float, _)) -> Float?:
    let spread = variance(xs)
    if spread == none:
        return none
    return sqrt(spread)

# xs[i] = value for every element — a typed fill.
func fill(xs: Array(Float, _), value: Float):
    for i in range(0, len(xs)):
        xs[i] = value

# xs[i] *= factor for every element.
func scale(xs: Array(Float, _), factor: Float):
    for i in range(0, len(xs)):
        xs[i] *= factor

# xs[i] += factor * ys[i] — the BLAS axpy, the shape most numeric
# loops reduce to.
func axpy(xs: Array(Float, _), factor: Float, ys: Array(Float, _)):
    if len(xs) != len(ys):
        trap("axpy needs arrays of one length")
    for i in range(0, len(xs)):
        xs[i] += factor * ys[i]

# -- randomness --------------------------------------------------------
#
# Lehmer / MINSTD: state' = state * 48271 mod (2^31 - 1).  Period
# 2^31 - 2; not cryptographic — games and shuffles, not secrets.
#
# The state is one `Int` in a struct, and every draw writes it back:
#
#     var rng = math.Rng(state = 42)
#     let roll = rng.in_range(1, 7)
#
# This was a one-element `List(Int)`, allocated by a `seed` function
# and kept alive for the life of `main`, whose entire purpose was to
# give an `Int` reference semantics so the *state* could go out
# through a borrow while the *draw* went out through `return`.  Two
# values, two channels, one allocation.  `var self` and a second
# return position between them delete all three (docs/RETURNS.md).
struct Rng:
    # The generator's whole state.  Any seed works: one out of range
    # is brought into range on first use.
    state: Int

    # The next raw state value in [1, 2^31 - 2].
    func next(var self) -> Int:
        # A Lehmer generator has no zero state and none at or past its
        # modulus, so a seed of either shape would stick or wrap.  In
        # range this is the identity — which is the property that
        # matters, because every state the recurrence below produces is
        # already in range and must pass through untouched.
        if self.state < 1 or self.state >= 2147483647:
            self.state = self.state % 2147483646
            if self.state < 0:
                self.state = self.state + 2147483646
            self.state = self.state + 1
        self.state = self.state * 48271 % 2147483647
        return self.state

    # A Float uniform in (0, 1).
    func real(var self) -> Float:
        return Float(self.next()) / 2147483647.0

    # An Int uniform in [low, high) — high is exclusive, like range.
    # (Slight modulo bias; fine for games, meaningless for spans that
    # small anyway.)
    func in_range(var self, low: Int, high: Int) -> Int:
        if high <= low:
            trap("in_range needs low < high")
        return low + self.next() % (high - low)

