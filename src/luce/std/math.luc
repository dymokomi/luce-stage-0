# math — the Luce standard math module.
#
# Pure Luce over the checked builtins (sqrt, floor, ceil, abs, min,
# max, clamp live there; this module adds what they lack).  Series
# are range-reduced first.  exp/ln hold ~1e-14 relative across their
# domains; sin/cos hold ~1e-12 absolute while |x| stays at or below
# 1e4.  The pi used for reduction carries ~20 digits, so each decade
# of magnitude past that costs a digit (measured against libm: 1e-14
# at 1e3 through 8e-3 at 1e15).  Rather than return a plausible but
# wrong answer, sin/cos trap outside that finite accuracy domain; tan
# inherits the same boundary.
#
# Randomness is a Lehmer generator with identity: `var rng =
# math.Rng(42)` then `rng.next()`.  Every draw advances the one
# state the class owns; no hidden globals.

# These constants state `f64` explicitly because the module's accuracy
# promises are binary64 promises. Their decimal spellings round directly
# to the nearest binary64 value; the annotation keeps that precision part
# of the API even though `f64` is also the context-free float default.
pub const pi: f64 = 3.14159265358979323846
pub const tau: f64 = 6.28318530717958647692
pub const e: f64 = 2.71828182845904523536

const ln2: f64 = 0.69314718055994530942
const ln10: f64 = 2.30258509299404568402

# Round f64 halfway away from zero: round(2.5) == 3.0 and
# round(-2.5) == -3.0. Integer conversions deliberately truncate;
# call round when nearest-integer rounding is the intended operation.
#
# Not floor(x + 0.5), which is how this was written and how most
# people would write it: 0.49999999999999994 + 0.5 rounds up to
# exactly 1.0 in binary64, so the floor of it is 1 where the answer is
# 0.  Splitting at trunc(x) instead is exact — the subtraction below
# is exact for every x whose fraction is not already zero.
pub func round(x: f64) -> f64:
    let whole = trunc(x)
    let fraction = x - whole
    if fraction >= 0.5:
        return whole + 1.0
    if fraction <= -0.5:
        return whole - 1.0
    return whole

# e raised to x.  Large x overflows to infinity, very negative x
# underflows to 0.0 — IEEE semantics, no traps.
pub func exp(x: f64) -> f64:
    # Reduce: x = k*ln2 + r with r in [-ln2/2, ln2/2], so the series
    # below converges in a few terms; then scale by 2^k.
    let k = i64(x / ln2)
    let r = x - f64(k) * ln2
    var term: f64 = 1.0
    var total: f64 = 1.0
    for i in range(1, 15):
        term *= r / f64(i)
        total += term
    var factor = 1.0
    if k >= 0:
        for i in range(0, k):
            factor *= 2.0
    else:
        for i in range(0, 0 - k):
            factor *= 0.5
    return total * factor

# Natural logarithm.  Non-positive input is a bug, not a value: trap.
pub func ln(x: f64) -> f64:
    if x <= 0.0:
        trap("ln of a non-positive number")
    # Reduce to m in [1, 2) with x = m * 2^k ...
    var m = x
    var k = 0
    while m >= 2.0:
        m *= 0.5
        k += 1
    while m < 1.0:
        m *= 2.0
        k -= 1
    # ... then ln(m) = 2 * atanh(t) with t = (m-1)/(m+1), |t| <= 1/3.
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var term = t
    var total = t
    for i in range(1, 14):
        term *= t2
        total += term / f64(2 * i + 1)
    return 2.0 * total + f64(k) * ln2

pub func log2(x: f64) -> f64:
    return ln(x) / ln2

pub func log10(x: f64) -> f64:
    return ln(x) / ln10

# x raised to y.  Negative x needs a whole-number y (otherwise the
# result is not a real number: trap); 0^y is 0 for positive y, 1 for
# y == 0, and a trap for negative y.
pub func pow(x: f64, y: f64) -> f64:
    if x == 0.0:
        if y > 0.0:
            return 0.0
        if y == 0.0:
            return 1.0
        trap("pow: zero base with a negative exponent")
    if x > 0.0:
        return exp(y * ln(x))
    if floor(y) != y:
        trap("pow: negative base needs a whole-number exponent")
    let magnitude = exp(y * ln(0.0 - x))
    # Odd whole exponents keep the sign.
    if i64(y) % 2 == 1:
        return 0.0 - magnitude
    return magnitude

# Integer power by squaring; arithmetic is checked, so a result past
# i64 traps integer_overflow.  Negative exponents have no i64 answer.
pub func ipow(base: i64, exponent: i64) -> i64:
    if exponent < 0:
        trap("ipow needs a non-negative exponent")
    var result: i64 = 1
    var square = base
    var left = exponent
    while left > 0:
        if left % 2 == 1:
            result *= square
        left //= 2
        if left > 0:
            square *= square
    return result

# Sine, by range reduction to (-pi, pi] and a Taylor series.  The
# reduction is deliberately bounded: ordinary f64 arithmetic cannot
# preserve enough low bits of a large revolution count to answer honestly.
const trig_limit: f64 = 10000.0

func trig_in_domain(x: f64) -> bool:
    # `x != x` is the IEEE NaN test; infinity fails the magnitude test.
    return x == x and abs(x) <= trig_limit

func sine_series(x: f64) -> f64:
    var r = x - floor(x / tau) * tau
    if r > pi:
        r -= tau
    var term = r
    var total = r
    for i in range(1, 11):
        term *= (0.0 - r * r) / f64((2 * i) * (2 * i + 1))
        total += term
    return total

pub func sin(x: f64) -> f64:
    if not trig_in_domain(x):
        trap("math.sin supports finite angles with |x| <= 10000")
    return sine_series(x)

pub func cos(x: f64) -> f64:
    if not trig_in_domain(x):
        trap("math.cos supports finite angles with |x| <= 10000")
    return sine_series(x + pi / 2.0)

# Tangent; near odd multiples of pi/2 the true value diverges and the
# result is a large f32, as IEEE division dictates.
pub func tan(x: f64) -> f64:
    return sin(x) / cos(x)

# -- vectors and statistics --------------------------------------------
#
# Whole-array operations over array[f64, _], the numeric vector
# type.  Sums accumulate left to right — the same order both engines
# and the C benchmark twins use, so results are bit-reproducible.
# Empty arrays: sum is 0.0; the operations that have no empty answer
# (mean, vmin, vmax, variance) answer `none`.

pub func sum(xs: array[f64, _]) -> f64:
    var total: f64 = 0.0
    for i in range(0, len(xs)):
        total += xs[i]
    return total

# The reductions over an array answer `f64?`: an empty array has no
# mean, no smallest and no spread, and "there is nothing there" is the
# same fact every time with no reason worth carrying (docs/FAILURE.md).
# A caller that knows the array is non-empty writes `else` once.
pub func mean(xs: array[f64, _]) -> f64?:
    if len(xs) == 0:
        return none
    return sum(xs) / f64(len(xs))

pub func vmin(xs: array[f64, _]) -> f64?:
    if len(xs) == 0:
        return none
    var smallest = xs[0]
    for i in range(1, len(xs)):
        smallest = min(smallest, xs[i])
    return smallest

pub func vmax(xs: array[f64, _]) -> f64?:
    if len(xs) == 0:
        return none
    var largest = xs[0]
    for i in range(1, len(xs)):
        largest = max(largest, xs[i])
    return largest

# The smallest and the largest, in one pass.  `vmin` and `vmax` walk
# the same array twice, and there could not have been a `minmax`
# before: writing one would have meant inventing a bag struct in the
# standard library (docs/RETURNS.md).
pub func minmax(xs: array[f64, _]) -> (f64?, f64?):
    if len(xs) == 0:
        return none, none
    var smallest = xs[0]
    var largest = xs[0]
    for i in range(1, len(xs)):
        smallest = min(smallest, xs[i])
        largest = max(largest, xs[i])
    return smallest, largest

# The dot product; lengths must agree.
pub func dot(xs: array[f64, _], ys: array[f64, _]) -> f64:
    if len(xs) != len(ys):
        trap("dot needs arrays of one length")
    var total: f64 = 0.0
    for i in range(0, len(xs)):
        total += xs[i] * ys[i]
    return total

# The Euclidean norm.
pub func norm(xs: array[f64, _]) -> f64:
    return sqrt(dot(xs, xs))

# Population variance (mean of squared deviations) and its root.
pub func variance(xs: array[f64, _]) -> f64?:
    if len(xs) == 0:
        return none
    let center = mean(xs) else 0.0
    var total: f64 = 0.0
    for i in range(0, len(xs)):
        let d = xs[i] - center
        total += d * d
    return total / f64(len(xs))

pub func stddev(xs: array[f64, _]) -> f64?:
    let spread = variance(xs)
    if spread == none:
        return none
    return sqrt(spread)

# xs[i] = value for every element — a typed fill.
pub func fill(xs: array[f64, _], value: f64):
    for i in range(0, len(xs)):
        xs[i] = value

# xs[i] *= factor for every element.
pub func scale(xs: array[f64, _], factor: f64):
    for i in range(0, len(xs)):
        xs[i] *= factor

# xs[i] += factor * ys[i] — the BLAS axpy, the shape most numeric
# loops reduce to.
pub func axpy(xs: array[f64, _], factor: f64, ys: array[f64, _]):
    if len(xs) != len(ys):
        trap("axpy needs arrays of one length")
    for i in range(0, len(xs)):
        xs[i] += factor * ys[i]

# -- randomness --------------------------------------------------------
#
# Lehmer / MINSTD: state' = state * 48271 mod (2^31 - 1).  Period
# 2^31 - 2; not cryptographic — games and shuffles, not secrets.
#
# A generator is stateful identity, so `Rng` is a class: every draw
# advances the one state, and handing the generator to a helper hands
# the same sequence rather than silently copying it — the copy was
# the struct shape's one footgun, a helper's draws that never
# advanced the caller's generator.
#
#     var rng = math.Rng(42)
#     let roll = rng.in_range(1, 7)
pub class Rng:
    # The generator's whole state.  Any seed works: one out of
    # range is brought into range on first use.
    var state: i64

    pub init(seed: i64):
        self.state = seed

    # The next raw state value in [1, 2^31 - 2].
    pub func next() -> i64:
        # A Lehmer generator has no zero state and none at or past its
        # modulus, so a seed of either shape would stick or wrap.  In
        # range this is the identity — which is the property that
        # matters, because every state the recurrence below produces is
        # already in range and must pass through untouched.
        if self.state < 1 or self.state >= 2147483647:
            self.state = self.state % 2147483646
            if self.state < 0:
                self.state = self.state + 2147483646
            self.state = self.state + 1
        self.state = self.state * 48271 % 2147483647
        return self.state

    # A f64 uniform in (0, 1).
    pub func real() -> f64:
        return f64(self.next()) / 2147483647.0

    # A i64 uniform in [low, high) — high is exclusive, like range.
    # (Slight modulo bias; fine for games, meaningless for spans that
    # small anyway.)
    pub func in_range(low: i64, high: i64) -> i64:
        if high <= low:
            trap("in_range needs low < high")
        return low + self.next() % (high - low)

