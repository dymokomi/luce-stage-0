# gpu — the small, backend-neutral drawing surface.
#
# A Surface is the thing a window gives you to draw on.  This module keeps
# the language API independent of Metal, Vulkan, and any window-system
# handle; the host supplies those through the runtime graphics channel.
# Resource lifetime is ordinary Luce ARC: aliases retain the same surface, and
# the native resource closes when its last strong reference disappears. A
# Surface also keeps the host-side state needed by its originating window alive
# until that Surface is released.
#
# The macOS host shipped with `loom` uses Metal when it is available and a
# CPU-backed window when it is not. Other hosts may leave this channel absent;
# calling one of these functions there fails closed with `host_unavailable`.

enum Backend:
    metal
    vulkan
    headless

class Surface:
    private:
        raw: handle

    private init(raw: handle):
        self.raw = raw

    # The cross-std construction seam: `handle` is a std-only
    # spelling, so this door is unreachable from programs while
    # letting `ui` hand a window's drawing state over.
    static func from_handle(raw: handle) -> Surface:
        return Surface(raw)

    func width() -> i64!:
        return try Builtin.gpu_surface_size(self.raw, 0)

    func height() -> i64!:
        return try Builtin.gpu_surface_size(self.raw, 1)

    func clear(red: i64, green: i64, blue: i64, alpha: i64 = 255) -> !:
        try Builtin.gpu_surface_clear(self.raw, red, green, blue, alpha)

    func fill_rect(
        x: i64,
        y: i64,
        width: i64,
        height: i64,
        red: i64,
        green: i64,
        blue: i64,
        alpha: i64 = 255,
    ) -> !:
        try Builtin.gpu_surface_fill_rect(
            self.raw,
            x,
            y,
            width,
            height,
            red,
            green,
            blue,
            alpha,
        )

    func present() -> !:
        try Builtin.gpu_surface_present(self.raw)

func backend() -> Backend:
    match Builtin.gpu_backend():
        0:
            return Backend.metal
        1:
            return Backend.vulkan
        2:
            return Backend.headless
        else:
            trap("host returned an unknown GPU backend")
