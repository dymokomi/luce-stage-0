# files — the Luce standard file module.
#
# A thin, honest layer over the host's file builtins, so programs
# read `files.read(path)` instead of remembering builtin names.  The
# host gate still applies: importing files in a host-less context
# (an evaluator) is a compile error, which is the truth.
#
# Paths resolve the way the host says — in loom, relative to the
# current directory.
#
# Every function here that touches a file says `!`: the world decides
# whether a read or a write lands, and a correct program given correct
# input can still be told no, which is what makes it an error rather
# than a trap (docs/FAILURE.md).  Call one with `try` to hand the
# failure to your caller, or with `catch` to answer it here.  `exists`
# is the exception and answers a plain Bool — but it is a question
# about the past, so it is never a guard for the call after it: read
# the file, and handle what the read says.

import std.strings

func exists(path: String) -> Bool:
    return file_exists(path)

func read(path: String) -> String!:
    return try file_read(path)

func write(path: String, text: String) -> !:
    try file_write(path, text)

# The file's lines, without their newlines.  A trailing final newline
# (the usual text-file ending) does not produce a phantom empty line.
func read_lines(path: String) -> List(String)!:
    let text = try file_read(path)
    var lines = text.split("\n")
    if len(lines) > 0 and lines[len(lines) - 1] == "":
        lines.remove(len(lines) - 1)
    return lines

# Write lines joined with newlines, ending with one (the text-file
# convention); an empty list writes an empty file.
func write_lines(path: String, lines: List(String)) -> !:
    if len(lines) == 0:
        try file_write(path, "")
        return
    try file_write(path, lines.join("\n") + "\n")
