# files — the Luce standard file module.
#
# A thin, honest layer over the compiler's private host bridge, so programs
# read `files.read(path)` and no host implementation name enters their
# namespace. The host gate still applies: importing files in a host-less
# context is a compile error, which is the truth.
#
# Paths resolve the way the host says — in loom, relative to the
# current directory.
#
# Every function here that touches a file says `!`: the world decides
# whether a read or a write lands, and a correct program given correct
# input can still be told no, which is what makes it an error rather
# than a trap (docs/FAILURE.md).  Call one with `try` to hand the
# failure to your caller, or with `catch` to answer it here.  There is
# no exception, `exists` included — see the note above it.
#
# **There is no `close` and no `with`.**  A `File` is a
# reference-counted class owning the host's descriptor, closed
# automatically when the last reference to it goes away, and using one
# after it is closed traps like any use after free.  Python's `with`
# is a per-call-site opt-in
# to a guarantee this language gives unconditionally: a Luce program
# cannot leak a file by forgetting a keyword, because there is no
# keyword to forget.

import std.io
import std.strings
import std.paths

# -- what is at a path (docs/FILESYSTEM.md) ---------------------------

# What a path names.  Three members, because that is the set a program
# branches on: recurse, read, or leave alone.  `other` is honest and
# total — a socket, a device, a fifo, a filesystem that will not say
# more — and it is one member rather than a taxonomy because a program
# that must tell a block device from a door is writing an operating
# system, not using one.
#
# There is no `symlink`: a link is what it points at (`kind` follows
# them), and a broken one is nothing there.
pub enum Kind:
    file
    directory
    other

# What is at this path, or none when nothing is.
#
# **This is the primitive question, and the three predicates below are
# one line each over it.**  The two answers are different facts and get
# different channels: `none` means *nothing is there* — the same
# reason every time, no message worth carrying — and `!` means *the
# world would not say*, a parent nobody may search, a device that
# failed.
#
# Links are followed, so the kind describes the same file the next
# line touches, and a dangling link is `none`.
#
# `match` does not dispatch over an optional, which is the guarantee
# rather than the wart: bind it, answer the absent case, then match.
#
#     let what = try files.kind(p)
#     if what == none:
#         print(p + " is not there")
#         return
#     match what:
#         directory: walk(p)
#         file: visit(p)
#         other: continue
pub func kind(path: str) -> Kind?!:
    let code = try Builtin.path_kind(path)
    if code == 1:
        return Kind.file
    if code == 2:
        return Kind.directory
    if code == 3:
        return Kind.other
    return none

# Whether there is anything at all at this path.
#
# **It answers `bool!` and not `bool`, deliberately.**  A file that
# certainly exists under a directory nobody may open is not absent —
# the world refused to look — and a bool has no room to say so, which
# is how the old `file_exists` came to answer `false` for both.
# Python 3.14 made its three predicates swallow every OSError,
# PermissionError included; Rust added `try_exists()` because that
# swallowing was a bug source.  A program that wants Python's
# behaviour writes `catch false`, which is three visible words.
#
# It is still a question about the past, so it is still never a guard
# for the call after it: read the file, and handle what the read says.
pub func exists(path: str) -> bool!:
    let what = try kind(path)
    return what != none

# Whether an ordinary file is there — `os.path.isfile`.
pub func is_file(path: str) -> bool!:
    let what = try kind(path)
    if what == none:
        return false
    return what == Kind.file

# Whether a directory is there — `os.path.isdir`.  This is the
# question `exists` is usually asked by mistake: a file holding the
# name answers false here and true there.
pub func is_dir(path: str) -> bool!:
    let what = try kind(path)
    if what == none:
        return false
    return what == Kind.directory

pub func read(path: str) -> str!:
    return try Builtin.file_read(path)

pub func write(path: str, text: str) -> !:
    try Builtin.file_write(path, text)

# The file's lines, without their newlines.  A trailing final newline
# (the usual text-file ending) does not produce a phantom empty line.
pub func read_lines(path: str) -> list[str]!:
    let text = try Builtin.file_read(path)
    var lines = text.split("\n")
    if len(lines) > 0 and lines[len(lines) - 1] == "":
        lines.remove(len(lines) - 1)
    return lines

# Write lines joined with newlines, ending with one (the text-file
# convention); an empty list writes an empty file.
pub func write_lines(path: str, lines: list[str]) -> !:
    if len(lines) == 0:
        try Builtin.file_write(path, "")
        return
    try Builtin.file_write(path, lines.join("\n") + "\n")

# Add to the end of a file, creating it if it is not there.  This is
# what a log wants and what `write` cannot be: `read` then `write` is
# two calls with a window between them, and the second one throws away
# whatever landed in the first one's shadow.
#
pub func append(path: str, text: str) -> !:
    try Builtin.file_append(path, text)

# The same, one line at a time, each ending in a newline.  An empty
# list adds nothing at all rather than an empty line.
pub func append_lines(path: str, lines: list[str]) -> !:
    if len(lines) == 0:
        return
    try Builtin.file_append(path, lines.join("\n") + "\n")

pub func delete(path: str) -> !:
    try Builtin.file_delete(path)

# Move a file.  Renaming onto an existing name replaces it, which is
# what makes write-then-rename the way to replace a file without ever
# leaving half of one on disk.
pub func rename(from: str, to: str) -> !:
    try Builtin.file_rename(from, to)

# -- the two stat facts ------------------------------------------------

# How many bytes the file holds — `os.path.getsize`.
#
# The byte count of the *file*, so a directory is an error here and
# not a number: a directory's `st_size` is a filesystem implementation
# detail no program can use.  Like every question about the world it
# is about the past — sizing a file and then reading it is two calls
# with a window between them — so the honest use is display and
# bookkeeping, not a buffer size to trust.
pub func size(path: str) -> i64!:
    return try Builtin.path_size(path)

# When the file or directory was last modified, in milliseconds since
# the Unix epoch — `os.path.getmtime`, on `os.epoch_ms`'s terms.
#
# It is wall-clock time: an operator may set the clock, a copied tree
# keeps old stamps, and two machines disagree.  A build tool compares
# two of these to each other and nothing else.
pub func modified(path: str) -> i64!:
    return try Builtin.path_modified(path)

# -- copy and move -----------------------------------------------------

# Copy one file's bytes to a new name, replacing whatever held it —
# `shutil.copyfile`.  A streaming loop over two open files, so a file
# larger than memory copies in constant space.  Nothing else crosses:
# permissions and ownership are the operating-system surface Luce has
# not taken up, and a copy that silently carried some of them would be
# promising what it cannot keep.
pub func copy(from: str, to: str) -> !:
    var source = try File(from)
    var sink = try File(to, Mode.create)
    var buffer = array[u8](4096)
    var landed = try source.read(buffer)
    while landed > 0:
        var remaining = landed
        while remaining > 0:
            let sent = try sink.write(buffer, remaining)
            if sent <= 0:
                error("the write made no progress")
            # A short write is ordinary: slide the unsent tail to the
            # front, because a Writer always takes from the front.
            var at: i64 = 0
            while at < remaining - sent:
                buffer[at] = buffer[sent + at]
                at += 1
            remaining -= sent
        landed = try source.read(buffer)
    try sink.flush()

# Move a file: rename when the world allows it, and copy-then-delete
# when it does not — `shutil.move`'s answer to a destination on
# another filesystem, where a rename cannot happen.  Directories move
# only by rename; carrying a tree across filesystems is a walk with
# policy in it, and a program that needs one writes the loop where the
# policy shows.
pub func move(from: str, to: str) -> !:
    rename(from, to) catch:
        if not (try is_file(from)):
            # Only a file falls back to copy.  Asking again re-raises
            # the rename's own refusal, in its own words — and a world
            # that changed its mind is a move that landed.
            try rename(from, to)
            return
        try copy(from, to)
        try delete(from)

# -- removing what a program made --------------------------------------

# Remove one **empty** directory — `os.rmdir`, the precise tool.  A
# directory with anything still in it is an error, which is the
# safety: this call cannot take more than the one name it was given.
pub func remove_directory(path: str) -> !:
    try Builtin.dir_remove(path)

# Remove whatever is at the path — a file, or a directory and
# everything under it — `shutil.rmtree` and the file half of Swift's
# `removeItem` in one call.
#
# Two rules, said here because a caller plans around both:
#
#   * **Nothing there is success.**  The call means "there is nothing
#     at this path when I return" — `make_directory`'s idempotence
#     rule, mirrored — so cleaning a build directory needs no guard in
#     front of it.
#   * **A symbolic link is removed as a link.**  What it points at is
#     untouched: a recursive delete that followed links would walk out
#     of the tree it was asked to remove, which is the classic way a
#     cleanup empties a home directory.
#
# There is no undo.  The precise tools — `delete`, `remove_directory`
# — refuse anything unexpected; this one is for the tree the program
# itself laid out.
pub func remove_all(path: str) -> !:
    try Builtin.tree_remove(path)

# Make a directory, and every directory leading to it.
#
# It means "there is a directory at this path when I return", so a
# directory that was already there is success and not an error.  That
# is deliberate: the alternative makes every caller write
# `if not files.exists(p)` in front of the call, and that check is a
# race — the same one that is why `exists` is never a guard for the
# read after it.
#
# A *file* holding the name is an error: you asked for a directory and
# there is not one.
pub func make_directory(path: str) -> !:
    try Builtin.dir_create(path)

# Make a directory inside `parent` that nobody else has, and answer
# where it is.
#
# **This is the one directory call that proves the directory is
# yours.**  `make_directory` says "there is a directory at this path
# when I return" and succeeds on one somebody else made — which is
# what saves ordinary callers from a guard, and exactly what makes it
# useless for a scratch area.  Asking `exists` first and creating
# after is the race, not the fix: between the question and the answer
# another program takes the name, and idempotence turns that into two
# programs sharing one directory, each free to delete the other's
# files.
#
# So the name is chosen and taken in the same act.  What comes back
# exists and was made by this call; nothing that was already there is
# ever replaced or removed.  On POSIX it is owner-only, because a
# scratch directory in a shared `/tmp` is otherwise everyone's
# reading.
#
# `prefix` only shapes the leading characters, so a person reading a
# directory listing can tell whose it is — the rest of the name is the
# host's, and characters it cannot use are dropped rather than
# refused.  Removing it when you are done is `remove_all`; nothing
# removes it for you.
#
#     let scratch = try files.make_temporary_directory(".", "build-")
#     # … write inside scratch, rename the finished artifact out …
#     try files.remove_all(scratch)
pub func make_temporary_directory(parent: str, prefix: str) -> str!:
    return try Builtin.temporary_directory(parent, prefix)

# -- the u8 channel (docs/BYTES.md) ---------------------------------
#
# A file is bytes reached through an open handle, and text is a
# validation the language performs on the bytes.  `File(path)`
# answers an ordinary class holding the host's descriptor, closed when
# its last reference goes away; using one after it is closed traps
# like any use after free, because it is the same mistake.
#
# The primitive shape is `io`'s: a read fills a buffer you own and
# says how many bytes landed, a write takes a buffer and a count and
# says how many landed.  `File` conforms to `io.Reader` and
# `io.Writer`, so the whole-file conveniences below are `io.drain` and
# `io.send` behind a path.

# How a file is opened: the three doors, named instead of numbered.
pub enum Mode:
    # From the start; the file must be there.
    read
    # Write from the start, creating the file and emptying it.
    create
    # Write at the end, creating the file if it is not there.
    append

# An open file.  The raw descriptor is private to this file — a
# program holds a File, never a number — which is the boundary that
# matters: the host's handle vocabulary stays behind the class that
# owns it, the way a Swift descriptor stays behind the session object
# wrapping it.
pub class File: io.Reader, io.Writer:
    let raw: handle

    # Open a file: `try File(path)` to read,
    # `try File(path, files.Mode.append)` for a log.  The world
    # decides whether the open lands, so construction is fallible.
    pub init(path: str, mode: Mode = Mode.read) -> !:
        self.raw = try Builtin.file_open(path, mode_code(mode))

    # Fill the buffer from where the last read stopped and answer how
    # many bytes landed.  Zero is the end of the file, not an error.
    pub func read(buffer: array[u8, _]) -> i64!:
        return try Builtin.handle_read(self.raw, buffer)

    # Hand `count` bytes from the front of the buffer to the file and
    # answer how many landed.  A short write is ordinary — the next
    # round continues from where this one stopped — which is the whole
    # reason the count comes back.
    pub func write(buffer: array[u8, _], count: i64) -> i64!:
        return try Builtin.handle_write(self.raw, buffer, count)

    pub func flush() -> !:
        try Builtin.handle_flush(self.raw)

# How the doors number themselves for the host.  Private: a reader
# writes `Mode.append`, never a number.
func mode_code(mode: Mode) -> i64:
    match mode:
        read:
            return 0
        create:
            return 1
        append:
            return 2

# The whole file, as bytes.  Nothing here asks whether the bytes are
# text — that is what `strings.from_bytes` is for — so this reads a
# JPEG as happily as a note.
pub func read_bytes(path: str) -> list[u8]!:
    var f = try File(path)
    return try io.drain(f)

# Write bytes, replacing whatever was there.
pub func write_bytes(path: str, data: list[u8]) -> !:
    var f = try File(path, Mode.create)
    try io.send(f, data)

# Add bytes to the end of a file, creating it if it is not there.
pub func append_bytes(path: str, data: list[u8]) -> !:
    var f = try File(path, Mode.append)
    try io.send(f, data)

# -- listing a directory ----------------------------------------------

# One thing in a directory: its name, the path that reaches it, and
# what it is.  This is `os.scandir`'s `DirEntry`, and the two path
# fields are not redundancy — they are the two things a caller wants.
# A file pane prints `name`; a walk pushes `path`; neither writes a
# join, and the join deleted from the top of every walk loop is the
# one that was getting written wrong.
pub struct Entry:
    pub let name: str
    pub let path: str
    pub let kind: Kind

# What is in a directory, sorted by name, each entry carrying its kind
# — `os.scandir`.
#
# Sorted because the host's order is whatever the file system felt
# like, which differs between two machines holding the same files, and
# a program that prints a listing should print the same listing.
#
# `path` is the listed path with the name joined onto it, exactly as
# Python's is: entries(".") answers "./notes", entries("src") answers
# "src/luce.zig".
#
# An entry the listing named and whose kind has since become nothing
# was removed while this loop was running; it is left out rather than
# reported, because it is no longer there to report and a listing is a
# statement about a moment.  A world that *refuses* to say is a
# different matter and travels in the error channel like everything
# else here.
#
# The kinds are fetched one per entry, which is one host call per name
# on top of the listing.  That is an implementation detail behind this
# signature: a host that could answer the whole listing at once would
# change this function and not one program that calls it.
pub func entries(path: str) -> list[Entry]!:
    var names = try Builtin.dir_list(path)
    names.sort()
    var found = list[Entry]()
    for name in names:
        let whole = paths.join(path, name)
        let what = try kind(whole)
        if what != none:
            found.append(Entry(name = name, path = whole, kind = what))
    return found

# The names in a directory, sorted — `os.listdir`.
#
# The plain names, not paths: join them yourself, or call `entries`
# and read `path`.  It survives beside `entries` for the reason Python
# keeps both and PEP 471 says so — most callers only want the names —
# and it asks the host for exactly that: the listing, and no kinds.
pub func list(path: str) -> list[str]!:
    var names = try Builtin.dir_list(path)
    names.sort()
    return names
