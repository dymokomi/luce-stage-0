# files — the Luce standard file module.
#
# A thin, honest layer over the host's file builtins, so programs
# read `files.read(path)` instead of remembering builtin names.  The
# host gate still applies: importing files in a host-less context
# is a compile error, which is the truth.
#
# Paths resolve the way the host says — in loom, relative to the
# current directory.
#
# Every function here that touches a file says `!`: the world decides
# whether a read or a write lands, and a correct program given correct
# input can still be told no, which is what makes it an error rather
# than a trap (docs/FAILURE.md).  Call one with `try` to hand the
# failure to your caller, or with `catch` to answer it here.  `exists`
# is the exception and answers a plain bool — but it is a question
# about the past, so it is never a guard for the call after it: read
# the file, and handle what the read says.

import std.strings

func exists(path: string) -> bool:
    return file_exists(path)

func read(path: string) -> string!:
    return try file_read(path)

func write(path: string, text: string) -> !:
    try file_write(path, text)

# The file's lines, without their newlines.  A trailing final newline
# (the usual text-file ending) does not produce a phantom empty line.
func read_lines(path: string) -> list(string)!:
    let text = try file_read(path)
    var lines = text.split("\n")
    if len(lines) > 0 and lines[len(lines) - 1] == "":
        lines.remove(len(lines) - 1)
    return lines

# Write lines joined with newlines, ending with one (the text-file
# convention); an empty list writes an empty file.
func write_lines(path: string, lines: list(string)) -> !:
    if len(lines) == 0:
        try file_write(path, "")
        return
    try file_write(path, lines.join("\n") + "\n")

# Add to the end of a file, creating it if it is not there.  This is
# what a log wants and what `write` cannot be: `read` then `write` is
# two calls with a window between them, and the second one throws away
# whatever landed in the first one's shadow.
#
# Spelled `append_text` and not `append` because `append` is a
# reserved name — it is `xs.append(v)`, the list method — and nothing
# user-declared may take one, module-qualified or not.
func append_text(path: string, text: string) -> !:
    try file_append(path, text)

# The same, one line at a time, each ending in a newline.  An empty
# list adds nothing at all rather than an empty line.
func append_lines(path: string, lines: list(string)) -> !:
    if len(lines) == 0:
        return
    try file_append(path, lines.join("\n") + "\n")

func delete(path: string) -> !:
    try file_delete(path)

# Move a file.  Renaming onto an existing name replaces it, which is
# what makes write-then-rename the way to replace a file without ever
# leaving half of one on disk.
func rename(from: string, to: string) -> !:
    try file_rename(from, to)

# -- the byte channel (docs/BYTES.md) ---------------------------------
#
# A file is bytes reached through an open handle, and text is a
# validation the language performs on the bytes.  `open`, `create` and
# `append_to` answer a `file` your scope owns: the end of that scope
# closes it, `free f` closes it early, `give f` and `return f` move it,
# and using one after it is closed traps like any use after free,
# because it is the same mistake.
#
# The primitive is C-shaped on purpose: a read fills a buffer you own
# and says how many bytes landed — zero means the file is finished —
# and a write takes a buffer and a count and says how many landed,
# which may be fewer than you asked for.  Everything below the three
# doors is a loop over that, the way Go's `os.ReadFile` is a loop over
# `Read`.

# How the three doors number themselves for the host.  Private: a
# reader writes `files.open(path)`, never a number.
private const mode_read = 0
private const mode_write = 1
private const mode_append = 2

# How much one read of a whole-file convenience asks for.  Large
# enough that an ordinary file is a handful of calls; small enough
# that the buffer is not itself the memory question.
private const chunk = 65536

# Open a file to read from the start.  The file must be there.
func open(path: string) -> file!:
    return try file_open(path, mode_read)

# Open a file to write from the start, creating it and emptying it.
func create(path: string) -> file!:
    return try file_open(path, mode_write)

# Open a file to write at its end, creating it if it is not there.
func append_to(path: string) -> file!:
    return try file_open(path, mode_append)

# The whole file, as bytes.  Nothing here asks whether the bytes are
# text — that is what `strings.from_bytes` is for — so this reads a
# JPEG as happily as a note.
func read_bytes(path: string) -> list(byte)!:
    var f = try open(path)
    var buffer = new array(byte, chunk)
    var all = new list(byte)
    var filled = try f.read(buffer)
    while filled > 0:
        var at: long = 0
        while at < filled:
            all.append(buffer[at])
            at += 1
        filled = try f.read(buffer)
    return all

# Write bytes, replacing whatever was there.
func write_bytes(path: string, bytes: list(byte)) -> !:
    var f = try create(path)
    try send(f, bytes)

# Add bytes to the end of a file, creating it if it is not there.
func append_bytes(path: string, bytes: list(byte)) -> !:
    var f = try append_to(path)
    try send(f, bytes)

# The loop both writers share: fill a buffer from where the last write
# stopped, hand it over, and go round again.  A short write is
# ordinary and not a failure — which is the whole reason `write`
# answers a count — so the next round refills from `at + sent` rather
# than re-sending bytes that already landed.  A host that accepts
# nothing at all has stopped writing, and says so as an error instead
# of spinning.
private func send(f: file, bytes: list(byte)) -> !:
    var buffer = new array(byte, chunk)
    var at: long = 0
    while at < len(bytes):
        var held: long = 0
        while held < chunk and at + held < len(bytes):
            buffer[held] = bytes[at + held]
            held += 1
        let sent = try f.write(buffer, held)
        if sent <= 0:
            error("the write made no progress")
        at += sent
    try f.flush()

# The names in a directory, sorted.
#
# Sorted because the host's order is whatever the file system felt
# like, which differs between two machines holding the same files —
# and a program that prints a listing should print the same listing.
# The names are plain names, not paths: join them yourself.
func list(path: string) -> list(string)!:
    var names = try dir_list(path)
    names.sort()
    return names
