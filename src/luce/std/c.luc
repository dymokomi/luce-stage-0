# c — the C boundary's helpers (docs/FFI.md).
#
# An extern speaks scalars and opaque tokens; this module is the safe
# spelling of the two things a program otherwise cannot say: hand a
# callee the address of some bytes, and hand it text the way C expects
# text.  The address exists only inside the scope `with_bytes` opens —
# the buffer is the scope's parameter, so ARC pins it for exactly that
# long, and a token that escapes the scope is dangling by contract:
# the docs say so, and Tier 2's borrow rules are a separate design.

import std.strings

# The buffer's address, handed to `body` as a foreign token beside
# nothing — the callee learns the count some other way, because C
# does.  Answers whatever `body` answers.
#
#     let total = c.with_bytes(data, (p) => sum_bytes(p, u64(len(data))))
#
# The token must not outlive the call, and the buffer must not grow,
# shrink, or die while it lives.
pub func with_bytes(buffer: list[u8], body: func(foreign) -> i64) -> i64:
    return body(Builtin.buffer_address(buffer))

# The same scope for a callee that answers a token — a constructor
# taking a name, a parser taking bytes.
pub func with_bytes_foreign(buffer: list[u8], body: func(foreign) -> foreign) -> foreign:
    return body(Builtin.buffer_address(buffer))

# Text the way C expects it: the UTF-8 bytes with one terminating
# zero.  The list is ordinary and its address is `with_bytes`'s to
# hand over.
pub func zstring(text: str) -> list[u8]:
    var held = list[u8]()
    for b in strings.to_bytes(text):
        held.append(b)
    held.append(0)
    return held

# Reading the other direction (docs/FFI.md): a **copy** out of
# C-owned memory, never a borrow — the rare shape's one visible verb.
# `count` bytes from `pointer`, as a fresh `bytes`.  The null token
# traps `null_foreign`.
pub func bytes_at(pointer: foreign, count: u64) -> bytes:
    return Builtin.bytes_at(pointer, count)

# A C string, copied: NUL-scan from `pointer`, copy, validate UTF-8.
# Invalid text traps `invalid_utf8` — a str is valid UTF-8 by
# contract, and an API that answers arbitrary bytes is not a str API.
# Hand-written externs should prefer declaring `-> str` and letting
# the boundary do this; this spelling is the raw layer's.
pub func cstring_at(pointer: foreign) -> str:
    return Builtin.cstring_at(pointer)

# Take ownership of C-owned text in one call: copy and validate the
# NUL-terminated bytes at `at` (`cstring_at`'s exact semantics —
# `null_foreign` on the zero token, `invalid_utf8` on bad bytes),
# release the allocation through `free`, then answer the copy.  The
# LLVMPrintModuleToString / LLVMDisposeMessage convention as one call
# — an extern's own name converts to the cfunc (docs/FFI.md):
#
#     let ir = c.take_str(LLVMPrintModuleToString(m), LLVMDisposeMessage)
#
# The zero token traps before `free` runs: there is nothing to read
# and, by the same contract, nothing to release.
pub func take_str(at: foreign, free: cfunc(foreign)) -> str:
    let text = Builtin.cstring_at(at)
    free(at)
    return text
