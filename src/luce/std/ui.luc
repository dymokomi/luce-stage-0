# ui — the low-level window boundary.
#
# `open` asks the host for a window.  A Window owns the native window handle;
# `surface` turns that window into the `std.gpu.Surface` used for drawing. A
# returned Surface retains the native drawing state, so it may safely outlive
# the Window value that created it.
# The types deliberately stop here. Layout, widgets, event routing, and the
# application loop belong in a higher-level package built on these two narrow
# modules; this boundary does not predict that package's component model.
#
# The macOS host shipped with `loom` installs the Metal channel (and a small
# CPU fallback when Metal is unavailable). Other hosts may leave the channel
# absent; those calls then fail closed with `host_unavailable`. No platform
# handle leaks into Luce source.

import std.gpu

struct Window:
    private:
        handle: file

    static func from_handle(handle: file) -> Window:
        return Window(handle = handle)

    func surface() -> gpu.Surface!:
        let raw = try ui_window_surface(self.handle)
        return gpu.Surface.from_handle(raw)

func open(title: str, width: i64, height: i64) -> Window!:
    let raw = try ui_window_open(title, width, height)
    return Window.from_handle(raw)
