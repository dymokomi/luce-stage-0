# ui — the low-level window boundary.
#
# `open` asks the host for a window.  A Window owns the native window handle;
# `surface` turns that window into the `std.gpu.Surface` used for drawing.
# The types deliberately stop here.  Layout, widgets, and event loops belong
# in a higher-level package built on these two modules once Luce's generic and
# interface features are ready.
#
# The macOS host shipped with `loom` installs the Metal channel (and a small
# CPU fallback when Metal is unavailable). Other hosts may leave the channel
# absent; those calls then fail closed with `host_unavailable`. No platform
# handle leaks into Luce source.

import std.gpu

struct Window:
    private:
        handle: file

    static func from_handle(handle: give file) -> Window:
        return Window(handle = give handle)

    func surface() -> gpu.Surface!:
        let raw = try ui_window_surface(self.handle)
        return gpu.Surface.from_handle(give raw)

func open(title: string, width: long, height: long) -> Window!:
    let raw = try ui_window_open(title, width, height)
    return Window.from_handle(give raw)
