# strings — the Luce standard string module.
#
# The language keeps the primitives: string the immutable UTF-8
# value, literals and f-strings, `+`, comparison, boundary-checked
# slices `s[a:b]`, `len`, and `s.byte_at(i)`.  Everything built on
# top of them lives here, in ordinary Luce — and `s.find(x)` is sugar
# for `strings.find(s, x)` whenever this module is imported.
#
# Byte offsets throughout, like the primitives.  Slices below always
# cut at safe places: ASCII positions, or match positions of a valid
# UTF-8 needle (a needle's first byte can never be a continuation
# byte, so a match never starts or ends mid-character).

# The byte offset of the first occurrence of needle at or after
# `start`, or -1 — for a match that never comes, and for a `start`
# outside the string, which is an argument error and not a missing
# needle.  An empty needle matches at `start`.  `start` defaults to
# the whole string: `find(s, needle)` is the everyday call, and
# `find_from` was this function wearing the default as a second
# declaration (docs/ARGS.md §9).
func find(s: string, needle: string, start: long = 0) -> long:
    let size = len(s)
    let needle_size = len(needle)
    if start < 0 or start > size:
        return -1
    if needle_size == 0:
        return start
    # The needle's first byte is located with the scanning primitive —
    # one call an engine is free to vectorize — and only a candidate
    # position pays the byte-by-byte compare, which stops at the first
    # mismatch.  Lengths are hoisted out of the loop.
    let head = needle.byte_at(0)
    let limit = size - needle_size
    var at = start
    while at <= limit:
        let hit = s.find_byte(head, at)
        if hit < 0 or hit > limit:
            return -1
        var i = 1
        while i < needle_size and s.byte_at(hit + i) == needle.byte_at(i):
            i += 1
        if i == needle_size:
            return hit
        at = hit + 1
    return -1

func contains(s: string, needle: string) -> bool:
    return find(s, needle) >= 0

func starts_with(s: string, prefix: string) -> bool:
    if len(prefix) > len(s):
        return false
    return s[0:len(prefix)] == prefix

func ends_with(s: string, suffix: string) -> bool:
    if len(suffix) > len(s):
        return false
    return s[len(s) - len(suffix):] == suffix

# How many non-overlapping occurrences; an empty needle counts zero.
func count(s: string, needle: string) -> long:
    if len(needle) == 0:
        return 0
    var found = 0
    var at = find(s, needle)
    while at >= 0:
        found += 1
        at = find(s, needle, at + len(needle))
    return found

func is_space_byte(byte: byte) -> bool:
    return byte == 32 or byte == 9 or byte == 13 or byte == 10

# ASCII whitespace off both ends.
func trim(s: string) -> string:
    var first = 0
    while first < len(s) and is_space_byte(s.byte_at(first)):
        first += 1
    var last = len(s)
    while last > first and is_space_byte(s.byte_at(last - 1)):
        last -= 1
    return s[first:last]

# ASCII case folding; every other byte passes through untouched.
# Unchanged runs are sliced whole, so multi-byte characters survive.
func lower(s: string) -> string:
    return fold_case(s, first = 65, last = 90, shift = 32)

func upper(s: string) -> string:
    return fold_case(s, first = 97, last = 122, shift = -32)

func fold_case(s: string, first: long, last: long, shift: long) -> string:
    var out = new builder()
    var run = 0
    var at = 0
    let size = len(s)
    while at < size:
        let byte = s.byte_at(at)
        if byte >= first and byte <= last:
            # Adjacent folded bytes leave an empty run; appending it
            # would cost a slice and a service call for nothing.  The
            # folded byte is ASCII by construction (both ranges are),
            # so it goes in without a string to carry it.
            if at > run:
                out.append(s[run:at])
            out.append_ascii(byte + shift)
            run = at + 1
        at += 1
    if run == 0:
        return s
    out.append(s[run:])
    return out.build()

# Every occurrence of old replaced with replacement; an empty old
# changes nothing.
func replace(s: string, old: string, replacement: string) -> string:
    if len(old) == 0:
        return s
    var out = new builder()
    var run: long = 0
    var at = find(s, old)
    while at >= 0:
        out.append(s[run:at])
        out.append(replacement)
        run = at + len(old)
        at = find(s, old, run)
    if run == 0:
        return s
    out.append(s[run:])
    return out.build()

# The text repeated `times` times; zero or fewer is "".
func repeat(s: string, times: long) -> string:
    if times <= 0 or len(s) == 0:
        return ""
    var out = new builder()
    for i in range(0, times):
        out.append(s)
    return out.build()

# Split on a separator, keeping empty pieces ("a;;b" has three); an
# empty separator splits on whitespace runs instead, dropping empties
# (Python's bare split).
func split(s: string, separator: string) -> list(string):
    var pieces: list(string) = []
    if len(separator) == 0:
        var at = 0
        while at < len(s):
            while at < len(s) and is_space_byte(s.byte_at(at)):
                at += 1
            var word_end = at
            while word_end < len(s) and not is_space_byte(s.byte_at(word_end)):
                word_end += 1
            if word_end > at:
                pieces.append(s[at:word_end])
            at = word_end
        return pieces
    var run: long = 0
    var at = find(s, separator)
    while at >= 0:
        pieces.append(s[run:at])
        run = at + len(separator)
        at = find(s, separator, run)
    pieces.append(s[run:])
    return pieces

# The pieces joined with a separator between each pair.
func join(parts: list(string), separator: string) -> string:
    var out = new builder()
    for i, piece in parts:
        if i > 0:
            out.append(separator)
        out.append(piece)
    return out.build()

# Space-padded to `width` bytes; text already that wide is unchanged.
func pad_left(s: string, width: long) -> string:
    return repeat(" ", width - len(s)) + s

func pad_right(s: string, width: long) -> string:
    return s + repeat(" ", width - len(s))

# A double as fixed-point text: format_float(2.5, 2) is "2.50",
# rounded half away from zero.  Meant for display of ordinary
# magnitudes; |value| past ~1e15 falls back to string(value).
func format_float(value: double, decimals: long) -> string:
    if decimals < 0:
        trap("format_float needs decimals >= 0")
    var magnitude = value
    var sign = ""
    if value < 0.0:
        magnitude = 0.0 - value
        sign = "-"
    if magnitude > 1.0e15:
        return string(value)
    # Annotated `double`, and it has to be.  This one binding never
    # meets `value` in an expression the checker would complain about
    # — it is multiplied by literals and compared against a widened
    # `long` — so at the narrower default it would quietly stay 32-bit
    # and stop being exact at 10^8, three digits inside the range
    # `decimals` allows.  The other unannotated site in std that would
    # have gone wrong is loud; this is the one that is not
    # (docs/TYPES.md, the unannotated-site audit).
    var scale: double = 1.0
    for i in range(0, decimals):
        scale *= 10.0
    # `long(x)` rounds (docs/NUMERICS.md), so the split at the
    # integral part says `trunc` out loud — and the `+ 0.5` that used
    # to hand-roll the rounding of the fraction is what `long` does
    # now, correctly, including at the values `floor(x + 0.5)` gets
    # wrong.
    var whole = long(trunc(magnitude))
    var fraction = long((magnitude - double(whole)) * scale)
    if double(fraction) >= scale:
        whole += 1
        fraction = 0
    if decimals == 0:
        return sign + string(whole)
    var digits = string(fraction)
    while len(digits) < decimals:
        digits = "0" + digits
    return sign + string(whole) + "." + digits
