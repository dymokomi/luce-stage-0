struct Text:
    func continuation(byte: Int) -> Bool:
        return byte >= 128 and byte < 192

    func previous_boundary(value: String, cursor: Int) -> Int:
        if cursor <= 0:
            return 0
        var at = cursor - 1
        while at > 0 and Text.continuation(byte_at(value, at)):
            at = at - 1
        return at

    func next_boundary(value: String, cursor: Int) -> Int:
        if cursor >= len(value):
            return len(value)
        var at = cursor + 1
        while at < len(value) and Text.continuation(byte_at(value, at)):
            at = at + 1
        return at

    func line_start(value: String, cursor: Int) -> Int:
        var at = cursor
        while at > 0 and byte_at(value, at - 1) != 10:
            at = at - 1
        return at

    func line_end(value: String, cursor: Int) -> Int:
        var at = cursor
        while at < len(value) and byte_at(value, at) != 10:
            at = at + 1
        return at

    func line_of(value: String, cursor: Int) -> Int:
        var line = 0
        for at in range(0, cursor):
            if byte_at(value, at) == 10:
                line = line + 1
        return line

    func column_of(value: String, cursor: Int) -> Int:
        var at = Text.line_start(value, cursor)
        var column = 0
        while at < cursor:
            at = Text.next_boundary(value, at)
            column = column + 1
        return column

    func line_at(value: String, wanted: Int) -> Int:
        var at = 0
        var line = 0
        while line < wanted and at < len(value):
            if byte_at(value, at) == 10:
                line = line + 1
            at = at + 1
        return at

    func at_column(value: String, start: Int, column: Int) -> Int:
        var at = start
        var current = 0
        let finish = Text.line_end(value, start)
        while at < finish and current < column:
            at = Text.next_boundary(value, at)
            current = current + 1
        return at

struct Editing:
    func insert(value: String, cursor: Int, text: String) -> String:
        return slice(value, 0, cursor) + text + slice(value, cursor, len(value))

    func erase_before(value: String, cursor: Int) -> String:
        let before = Text.previous_boundary(value, cursor)
        return slice(value, 0, before) + slice(value, cursor, len(value))

    func erase_at(value: String, cursor: Int) -> String:
        let after = Text.next_boundary(value, cursor)
        return slice(value, 0, cursor) + slice(value, after, len(value))

struct Rendering:
    func clipped_line(value: String, start: Int, cols: Int) -> String:
        let finish = Text.line_end(value, start)
        var at = start
        var width = 0
        while at < finish and width < cols:
            at = Text.next_boundary(value, at)
            width = width + 1
        return slice(value, start, at)

    func frame(value: String, scroll: Int, rows: Int, cols: Int) -> String:
        let visible = max(rows - 1, 1)
        var at = Text.line_at(value, scroll)
        var frame = ""
        for row in range(0, visible):
            if row > 0:
                frame = frame + "\n"
            if at <= len(value):
                frame = frame + Rendering.clipped_line(value, at, max(cols, 0))
            if at >= len(value):
                at = len(value) + 1
            else:
                at = Text.line_end(value, at) + 1
        return frame

func evaluate(input: Input, output: Output):
    var content = input.content
    var cursor = clamp(input.cursor, 0, len(content))
    var scroll = max(input.scroll, 0)
    var dirty = input.dirty
    var save = false
    var quit = false
    let wanted_column = Text.column_of(content, cursor)

    if input.key == "left":
        cursor = Text.previous_boundary(content, cursor)
    elif input.key == "right":
        cursor = Text.next_boundary(content, cursor)
    elif input.key == "up":
        let start = Text.line_start(content, cursor)
        if start > 0:
            cursor = Text.at_column(content, Text.line_start(content, start - 1), wanted_column)
    elif input.key == "down":
        let finish = Text.line_end(content, cursor)
        if finish < len(content):
            cursor = Text.at_column(content, finish + 1, wanted_column)
    elif input.key == "home":
        cursor = Text.line_start(content, cursor)
    elif input.key == "end":
        cursor = Text.line_end(content, cursor)
    elif input.key == "backspace":
        if cursor > 0:
            content = Editing.erase_before(content, cursor)
            cursor = Text.previous_boundary(input.content, cursor)
            dirty = true
    elif input.key == "delete":
        if cursor < len(content):
            content = Editing.erase_at(content, cursor)
            dirty = true
    elif input.key == "enter":
        content = Editing.insert(content, cursor, "\n")
        cursor = cursor + 1
        dirty = true
    elif input.key == "text":
        content = Editing.insert(content, cursor, input.text)
        cursor = cursor + len(input.text)
        dirty = true
    elif input.key == "save":
        save = true
        dirty = false
    elif input.key == "quit":
        quit = true

    let cursor_line = Text.line_of(content, cursor)
    let visible = max(input.rows - 1, 1)
    if cursor_line < scroll:
        scroll = cursor_line
    elif cursor_line >= scroll + visible:
        scroll = cursor_line - visible + 1

    var status = " clean"
    if dirty:
        status = " modified"
    output.content = content
    output.cursor = cursor
    output.scroll = scroll
    output.dirty = dirty
    output.interface = Rendering.frame(content, scroll, input.rows, input.cols) + "\n" + input.target + status + " | Ctrl-S save | Ctrl-Q quit"
    output.cursor_row = cursor_line - scroll
    output.cursor_col = Text.column_of(content, cursor)
    output.save = save
    output.quit = quit
