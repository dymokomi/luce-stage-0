func main():
    let files = script_directory()
    let editor_source = read_file(files, "editor_view.luc")
    let editor = create_texel("editor")

    texel_input(editor, "content", "text")
    texel_input(editor, "cursor", "int")
    texel_input(editor, "dirty", "bool")
    texel_input(editor, "key", "text")
    texel_input(editor, "text", "text")
    texel_input(editor, "scroll", "int")
    texel_input(editor, "rows", "int")
    texel_input(editor, "cols", "int")
    texel_input(editor, "target", "text")

    texel_output(editor, "content", "text")
    texel_output(editor, "cursor", "int")
    texel_output(editor, "dirty", "bool")
    texel_output(editor, "scroll", "int")
    texel_output(editor, "interface", "text")
    texel_output(editor, "cursor_row", "int")
    texel_output(editor, "cursor_col", "int")
    texel_output(editor, "save", "bool")
    texel_output(editor, "quit", "bool")

    texel_set(editor, "content", "")
    texel_set(editor, "cursor", 0)
    texel_set(editor, "dirty", false)
    texel_set(editor, "scroll", 0)
    texel_set(editor, "interface", "")
    texel_set(editor, "cursor_row", 0)
    texel_set(editor, "cursor_col", 0)
    texel_set(editor, "save", false)
    texel_set(editor, "quit", false)
    texel_content(editor, editor_source)
    texel_evaluator(editor, "luce")
