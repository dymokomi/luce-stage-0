# Sorting, searching, and joining a real list(long).
#
#   loom luce examples/sort/sort.luc

import std.strings

func main():
    var values = [42, 7, -3, 99, 0, 13, -40, 8, 77, 1]
    values.sort()

    var pieces: list(string) = []
    for value in values:
        pieces.append(string(value))
    print(pieces.join(" "))
    assert((values.find(13) else -1) == 6)
    assert(values.contains(99))
    assert(values[0] == -40)
    assert(values[9] == 99)
