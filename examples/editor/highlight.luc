# Luce syntax highlighting — a source line becomes a list of tokens.
#
# Pure classification: no terminal, no styles. It walks a scalar range
# and answers what each run *is* (a keyword, a str, a number, a
# comment, …); `theme` turns a kind into a colour and `paint` turns the
# tokens into a drawable line.  Keeping the classifier free of colour is
# what lets a test assert the tokens of a line directly.
#
# The word tables are the language's own words, held against the
# compiler's tables (`lex/token.zig` keywords, `support/types.zig`
# builtin types, `semantics/builtins.zig` builtins).  A method name
# is not here: it is only a name after a receiver and a dot, and this
# highlighter colours words, not receivers.

import document

# --- one character, before anything decides what it means ----------

func is_digit(code: char) -> bool:
    return code >= '0' and code <= '9'

func is_hex_digit(code: char) -> bool:
    return is_digit(code) or (code >= 'A' and code <= 'F') or (code >= 'a' and code <= 'f')

func is_upper(code: char) -> bool:
    return code >= 'A' and code <= 'Z'

func is_alpha(code: char) -> bool:
    return is_upper(code) or (code >= 'a' and code <= 'z')

func is_word_start(code: char) -> bool:
    return is_alpha(code) or code == '_' or u32(code) >= 128

func is_word(code: char) -> bool:
    return is_word_start(code) or is_digit(code)

# Where a quoted str that opens at `opening` closes, bounded by
# `finish`. A backslash escapes the next scalar.
func quoted_end(value: str, finish: i64, opening: i64) -> i64:
    var close = opening + 1
    var closed = false
    while close < finish and not closed:
        let code = value[close]
        if code == '\\':
            close = close + 2
        elif code == '"':
            closed = true
            close = close + 1
        else:
            close = close + 1
    return min(close, finish)

# --- the word tables -------------------------------------------------

private const keyword_words = {
    "alias": true, "and": true, "break": true, "catch": true, "class": true,
    "const": true, "continue": true, "deinit": true, "elif": true, "else": true,
    "enum": true, "false": true, "for": true, "func": true,
    "if": true, "import": true, "in": true, "init": true, "interface": true, "is": true,
    "let": true, "match": true, "mutating": true, "new": true, "none": true,
    "not": true, "or": true, "private": true, "public": true,
    "return": true, "self": true, "spawn": true, "static": true,
    "struct": true, "true": true, "try": true, "union": true,
    "var": true, "weak": true, "while": true,
}

private const type_words = {
    "bool": true, "u8": true, "u16": true, "u32": true, "u64": true,
    "i8": true, "i16": true, "i32": true, "i64": true,
    "f16": true, "f32": true, "f64": true,
    "char": true, "str": true, "bytes": true,
    "list": true, "map": true, "array": true,
    "builder": true, "task": true,
}

private const builtin_words = {
    "abs": true, "assert": true, "ceil": true,
    "clamp": true, "error": true, "exit": true, "floor": true,
    "len": true, "max": true, "min": true, "parse_f64": true,
    "parse_i64": true, "parse_str": true, "print": true,
    "range": true, "sqrt": true, "trap": true, "trunc": true,
}

# What a run of source is.  A `match` on this in `theme` and `paint`
# has an arm for every member and no `else`, so a new kind cannot be
# added without the compiler naming those sites.
enum TokenKind:
    keyword
    type_name
    builtin
    plain
    comment
    string_literal
    number
    punct

struct Token:
    text: str
    kind: TokenKind

# Which of the four word kinds a word is.  The order is the language's:
# a reserved word is a keyword before anything else, and a capitalized
# name is a type before a builtin (no builtin is capitalized).
func classify_word(text: str) -> TokenKind:
    if keyword_words.has(text):
        return TokenKind.keyword
    if type_words.has(text):
        return TokenKind.type_name
    if len(text) > 0 and is_upper(text[0]):
        return TokenKind.type_name
    if builtin_words.has(text):
        return TokenKind.builtin
    return TokenKind.plain

# Tokenize the scalar range `[from, to)` of `content`. Whole tokens are
# produced without clipping — display clipping is the surface's job at
# draw time — so a token may be wider than the pane it lands in.
func tokens(content: str, from: i64, to: i64) -> list[Token]:
    var out = new list[Token]
    var at = from
    while at < to:
        let code = content[at]
        if code == '#':
            out.append(Token(text = content[at:to], kind = TokenKind.comment))
            at = to
        elif code == 'f' and at + 1 < to and content[at + 1] == '"' and (at == from or not is_word(content[at - 1])):
            let close = quoted_end(content, to, at + 1)
            out.append(Token(text = content[at:close], kind = TokenKind.string_literal))
            at = close
        elif code == '"':
            let close = quoted_end(content, to, at)
            out.append(Token(text = content[at:close], kind = TokenKind.string_literal))
            at = close
        elif is_digit(code):
            var stop = at + 1
            if stop < to and (content[stop] == 'x' or content[stop] == 'X'):
                stop = stop + 1
                while stop < to and (is_hex_digit(content[stop]) or content[stop] == '_'):
                    stop = stop + 1
            elif stop < to and (content[stop] == 'b' or content[stop] == 'B'):
                stop = stop + 1
                while stop < to and (content[stop] == '0' or content[stop] == '1' or content[stop] == '_'):
                    stop = stop + 1
            else:
                while stop < to and (is_digit(content[stop]) or content[stop] == '_'):
                    stop = stop + 1
                if stop < to and content[stop] == '.':
                    stop = stop + 1
                    while stop < to and (is_digit(content[stop]) or content[stop] == '_'):
                        stop = stop + 1
                if stop < to and (content[stop] == 'e' or content[stop] == 'E'):
                    stop = stop + 1
                    if stop < to and (content[stop] == '+' or content[stop] == '-'):
                        stop = stop + 1
                    while stop < to and (is_digit(content[stop]) or content[stop] == '_'):
                        stop = stop + 1
            out.append(Token(text = content[at:stop], kind = TokenKind.number))
            at = stop
        elif is_word_start(code):
            var stop = at + 1
            while stop < to and is_word(content[stop]):
                stop = stop + 1
            out.append(Token(text = content[at:stop], kind = classify_word(content[at:stop])))
            at = stop
        else:
            var stop = document.next_boundary(content, at)
            stop = min(stop, to)
            out.append(Token(text = content[at:stop], kind = TokenKind.punct))
            at = stop
    return out
