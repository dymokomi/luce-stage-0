# Syntax highlighting — a source line becomes a list of tokens.
#
# Pure classification: no terminal, no styles.  The engine walks a
# scalar range and answers what each run *is* (a keyword, a str, a
# number, a comment, …); `theme` turns a kind into a colour.  Which
# words mean what belongs to the `Syntax` value handed in — one per
# language, each a file under `syntax/` — so a new language never
# changes this file.

from document import next_boundary
from syntax.definition import Syntax

# --- one character, before anything decides what it means ----------

func is_digit(code: char) -> bool:
    return code >= '0' and code <= '9'

func is_hex_digit(code: char) -> bool:
    return is_digit(code) or (code >= 'A' and code <= 'F') or (code >= 'a' and code <= 'f')

func is_upper(code: char) -> bool:
    return code >= 'A' and code <= 'Z'

func is_alpha(code: char) -> bool:
    return is_upper(code) or (code >= 'a' and code <= 'z')

func is_word_start(code: char) -> bool:
    return is_alpha(code) or code == '_' or u32(code) >= 128

func is_word(code: char) -> bool:
    return is_word_start(code) or is_digit(code)

# Where a quoted run that opens at `opening` closes, bounded by
# `finish`.  A backslash escapes the next scalar.
func quoted_end(value: str, finish: i64, opening: i64, quote: char) -> i64:
    var close = opening + 1
    var closed = false
    while close < finish and not closed:
        let code = value[close]
        if code == '\\':
            close = close + 2
        elif code == quote:
            closed = true
            close = close + 1
        else:
            close = close + 1
    return min(close, finish)

# What a run of source is.  A `match` on this in `theme` and `paint`
# has an arm for every member and no `else`, so a new kind cannot be
# added without the compiler naming those sites.
pub enum TokenKind:
    keyword
    type_name
    builtin
    plain
    comment
    string_literal
    number
    punct

pub struct Token:
    pub let text: str
    pub let kind: TokenKind

func listed(words: list[str], text: str) -> bool:
    for word in words:
        if word == text:
            return true
    return false

# Which of the four word kinds a word is under `language`.  A reserved
# word is a keyword before anything else, and where the convention
# holds, a capitalized name is a type before a builtin.
func classify_word(language: Syntax, text: str) -> TokenKind:
    if listed(language.keywords, text):
        return TokenKind.keyword
    if listed(language.types, text):
        return TokenKind.type_name
    if language.capitalized_types and len(text) > 0 and is_upper(text[0]):
        return TokenKind.type_name
    if listed(language.builtins, text):
        return TokenKind.builtin
    return TokenKind.plain

# Whether `content` opens a line comment at `at`.
func opens_comment(language: Syntax, content: str, at: i64, to: i64) -> bool:
    let marker = language.line_comment
    if len(marker) == 0:
        return false
    if at + len(marker) > to:
        return false
    var offset: i64 = 0
    while offset < len(marker):
        if content[at + offset] != marker[offset]:
            return false
        offset += 1
    return true

func is_quote(language: Syntax, code: char) -> bool:
    for quote in language.quotes:
        if code == quote:
            return true
    return false

func is_quote_prefix(language: Syntax, code: char) -> bool:
    for prefix in language.quote_prefixes:
        if code == prefix:
            return true
    return false

# Tokenize the scalar range `[from, to)` of `content` under
# `language`.  Whole tokens are produced without clipping — display
# clipping is the surface's job at draw time.
pub func tokens(language: Syntax, content: str, from: i64, to: i64) -> list[Token]:
    var out = list[Token]()
    var at = from
    while at < to:
        let code = content[at]
        if opens_comment(language, content, at, to):
            out.append(Token(text = content[at:to], kind = TokenKind.comment))
            at = to
        elif is_quote_prefix(language, code) and at + 1 < to and is_quote(language, content[at + 1]) and (at == from or not is_word(content[at - 1])):
            let close = quoted_end(content, to, at + 1, content[at + 1])
            out.append(Token(text = content[at:close], kind = TokenKind.string_literal))
            at = close
        elif is_quote(language, code):
            let close = quoted_end(content, to, at, code)
            out.append(Token(text = content[at:close], kind = TokenKind.string_literal))
            at = close
        elif is_digit(code):
            var stop = at + 1
            if stop < to and (content[stop] == 'x' or content[stop] == 'X'):
                stop = stop + 1
                while stop < to and (is_hex_digit(content[stop]) or content[stop] == '_'):
                    stop = stop + 1
            elif stop < to and (content[stop] == 'b' or content[stop] == 'B'):
                stop = stop + 1
                while stop < to and (content[stop] == '0' or content[stop] == '1' or content[stop] == '_'):
                    stop = stop + 1
            else:
                while stop < to and (is_digit(content[stop]) or content[stop] == '_'):
                    stop = stop + 1
                if stop < to and content[stop] == '.':
                    stop = stop + 1
                    while stop < to and (is_digit(content[stop]) or content[stop] == '_'):
                        stop = stop + 1
                if stop < to and (content[stop] == 'e' or content[stop] == 'E'):
                    stop = stop + 1
                    if stop < to and (content[stop] == '+' or content[stop] == '-'):
                        stop = stop + 1
                    while stop < to and (is_digit(content[stop]) or content[stop] == '_'):
                        stop = stop + 1
            out.append(Token(text = content[at:stop], kind = TokenKind.number))
            at = stop
        elif is_word_start(code):
            var stop = at + 1
            while stop < to and is_word(content[stop]):
                stop = stop + 1
            out.append(Token(text = content[at:stop], kind = classify_word(language, content[at:stop])))
            at = stop
        else:
            var stop = next_boundary(content, at)
            stop = min(stop, to)
            out.append(Token(text = content[at:stop], kind = TokenKind.punct))
            at = stop
    return out
