# The Luce editor — a modern terminal editor written in Luce, for Luce.
#
# The first Luce program to carry a dependency: it draws through
# **termui** (docs/TERMUI.md), which owns the cell grid, the diff, the
# rectangles and the event union, while the host owns raw mode and
# every escape byte and this program owns every editing decision.
# Per-line syntax highlighting for Luce: keywords, capitalized type
# names, builtins, strings, numbers, and comments.
#
#   editor FILE [FILE ...]
#   Ctrl-S save   Ctrl-B build/run   Ctrl-Q quit (twice to discard changes)
#   Ctrl-E files  Ctrl-O output     Ctrl-W focus next pane
#
# Nothing here is reachable from another module, so everything but
# `main` is `private` (docs/VISIBILITY.md): the file is the unit, and
# what a program's insides are called is nobody else's business.  What
# a *test* can drive — the layout arithmetic, the keymap — lives in
# `editor_model.luc` beside it, and `tests/` drives it there.

import editor_model as model
import std.files
import std.os
import std.paths
import std.strings
import std.term
import termui
import termui.events
import termui.rows
import termui.screen

# **termui ships no theme, deliberately** (docs/TERMUI.md D3): a
# library that owns the palette owns the app's identity, and the
# editor's syntax colours are the editor's.  A theme is a struct of
# styles the app declares as a constant, which is exactly what this is.
private struct Theme:
    keyword: termui.Style
    type_name: termui.Style
    builtin: termui.Style
    text: termui.Style
    number: termui.Style
    comment: termui.Style
    plain: termui.Style
    punct: termui.Style
    gutter: termui.Style
    gutter_current: termui.Style
    status: termui.Style
    selected: termui.Style
    pane_border: termui.Style
    pane_active: termui.Style

private const theme = Theme(
    keyword = termui.Style(foreground = 176, bold = true),
    type_name = termui.Style(foreground = 80),
    builtin = termui.Style(foreground = 74),
    text = termui.Style(foreground = 114),
    number = termui.Style(foreground = 215),
    comment = termui.Style(foreground = 244),
    plain = termui.Style(foreground = 252),
    punct = termui.Style(foreground = 249),
    gutter = termui.Style(foreground = 240),
    gutter_current = termui.Style(foreground = 250),
    status = termui.Style(foreground = 252, background = 237),
    selected = termui.Style(foreground = 252, background = 237, bold = true),
    pane_border = termui.Style(foreground = 238),
    pane_active = termui.Style(foreground = 255, background = 236, bold = true),
)

# Luce's lexer uses the same four-column step, and the editor writes
# spaces rather than tabs so what it creates is immediately valid source.
private const indent_unit = "    "

# What a single byte is, before anything has decided what it means.
# Every predicate here answers about one byte and reaches nothing.
private struct Bytes:
    static func continuation(byte: byte) -> bool:
        return byte >= 128 and byte < 192

    static func is_digit(byte: byte) -> bool:
        return byte >= 48 and byte <= 57

    static func is_hex_digit(byte: byte) -> bool:
        return Bytes.is_digit(byte) or (byte >= 65 and byte <= 70) or (byte >= 97 and byte <= 102)

    static func is_upper(byte: byte) -> bool:
        return byte >= 65 and byte <= 90

    static func is_alpha(byte: byte) -> bool:
        return Bytes.is_upper(byte) or (byte >= 97 and byte <= 122)

    static func is_word_start(byte: byte) -> bool:
        return Bytes.is_alpha(byte) or byte == 95 or byte >= 194

    static func is_word(byte: byte) -> bool:
        return Bytes.is_word_start(byte) or Bytes.is_digit(byte) or Bytes.continuation(byte)

# UTF-8 boundaries, lines and columns over a whole buffer.
#
# This is where the cursor lives, so it is bytes and boundaries rather
# than display cells; how wide a string *draws* is `strings.width`,
# which termui made the one answer to that question (D11).
private struct Text:
    static func previous_boundary(value: string, cursor: long) -> long:
        if cursor <= 0:
            return 0
        var at = cursor - 1
        while at > 0 and Bytes.continuation(value.byte_at(at)):
            at = at - 1
        return at

    static func next_boundary(value: string, cursor: long) -> long:
        if cursor >= len(value):
            return len(value)
        var at = cursor + 1
        while at < len(value) and Bytes.continuation(value.byte_at(at)):
            at = at + 1
        return at

    static func line_start(value: string, cursor: long) -> long:
        var at = cursor
        while at > 0 and value.byte_at(at - 1) != 10:
            at = at - 1
        return at

    static func line_end(value: string, cursor: long) -> long:
        var at = cursor
        while at < len(value) and value.byte_at(at) != 10:
            at = at + 1
        return at

    # The leading whitespace already in the line at the cursor.  The
    # result is borrowed from `value` and is safe to use while the
    # caller is still deciding what the next line should contain.
    static func indentation(value: string, cursor: long) -> string:
        let start = Text.line_start(value, cursor)
        var at = start
        while at < cursor:
            let byte = value.byte_at(at)
            if byte != 32 and byte != 9:
                break
            at = at + 1
        return value[start:at]

    # Whether the code before the cursor opens an indented block.  A
    # small lexical scan is enough here: comments and quoted strings
    # are not Luce layout, but a colon before a trailing comment is.
    static func opens_block(value: string, cursor: long) -> bool:
        let start = Text.line_start(value, cursor)
        var at = start
        var quoted = false
        var escaped = false
        var last: byte = 0
        while at < cursor:
            let byte = value.byte_at(at)
            if quoted:
                if escaped:
                    escaped = false
                elif byte == 92:
                    escaped = true
                elif byte == 34:
                    quoted = false
            elif byte == 35:
                break
            elif byte == 34:
                quoted = true
            elif byte != 32 and byte != 9:
                last = byte
            at = at + 1
        return not quoted and last == 58

    static func quoted_end(value: string, finish: long, opening: long) -> long:
        var close = opening + 1
        var closed = false
        while close < finish and not closed:
            let byte = value.byte_at(close)
            if byte == 92:
                close = close + 2
            elif byte == 34:
                closed = true
                close = close + 1
            else:
                close = close + 1
        return min(close, finish)

    static func line_of(value: string, cursor: long) -> long:
        var line = 0
        for at in range(0, cursor):
            if value.byte_at(at) == 10:
                line = line + 1
        return line

    static func count_lines(value: string) -> long:
        return Text.line_of(value, len(value)) + 1

    static func column_of(value: string, cursor: long) -> long:
        var at = Text.line_start(value, cursor)
        var column = 0
        while at < cursor:
            at = Text.next_boundary(value, at)
            column = column + 1
        return column

    static func line_at(value: string, wanted: long) -> long:
        var at = 0
        var line = 0
        while line < wanted and at < len(value):
            if value.byte_at(at) == 10:
                line = line + 1
            at = at + 1
        return at

    static func at_column(value: string, start: long, column: long) -> long:
        var at = start
        var current = 0
        let finish = Text.line_end(value, start)
        while at < finish and current < column:
            at = Text.next_boundary(value, at)
            current = current + 1
        return at

private struct Editing:
    static func splice(value: string, cursor: long, extra: string) -> string:
        return value[0:cursor] + extra + value[cursor:len(value)]

    static func erase_before(value: string, cursor: long) -> string:
        let before = Text.previous_boundary(value, cursor)
        return value[0:before] + value[cursor:len(value)]

    static func erase_at(value: string, cursor: long) -> string:
        let after = Text.next_boundary(value, cursor)
        return value[0:cursor] + value[after:len(value)]

# --- the word tables -------------------------------------------------
#
# **The language's own words, kept against their sources.** These used
# to be `word == "…"` comparisons — a hash set written as a truth table
# — and they had drifted eight language generations out of date:
# `enum`, `match`, `new`, `import`, `give`, `copy`, `none`, `try`,
# `catch`, `self`, `spawn` and `static` were all missing, and so were
# twenty-one builtins the language has gained since.  Ground truth is
# the compiler's own tables, which `tools/grammar.zig` reads for the
# VS Code grammar. The site build reads those same compiler tables and
# holds these three maps to exact set equality: `02_lex/token.zig`'s
# `keywords`, `support/types.zig`'s builtin types, and
# `04_semantics/builtins.zig`'s `builtins` plus `range`, which is syntax
# the parser recognises only inside a `for`.
#
# Two words came *out*.  `slice` is a name the language does not have
# at all any more, and `byte_at` is a **method**: it is only
# a name after a receiver and a dot, which is what the VS Code grammar
# gives its own rule for.  This highlighter colours words, not
# receivers, so a method list here would colour a program's own `find`
# and `get` and `build` as well — the two lists are the free builtins
# and nothing else.
#
# **An immutable lookup table, rather than a chain compared.**  Luce
# has no set type yet, so a program-root `map(string, bool)` is the
# exact membership table: one lookup, no fenced-string scan, and a
# duplicate spelling is a compile-time error.
private const keyword_words = {
    "and": true, "break": true, "catch": true, "const": true,
    "continue": true, "copy": true, "elif": true, "else": true,
    "enum": true, "false": true, "for": true, "func": true,
    "give": true, "if": true, "import": true, "in": true, "interface": true,
    "let": true, "match": true, "new": true, "none": true,
    "not": true, "or": true, "private": true, "public": true,
    "return": true, "self": true, "spawn": true, "static": true,
    "struct": true, "true": true, "try": true, "union": true,
    "var": true, "while": true,
}

# The language's lowercase builtin types are types too.  The original
# editor only treated capitalized user declarations as types, which left
# the current spellings in `std.os` signatures (`string!`, `long`, and
# `list(string)`) looking like ordinary identifiers.
private const type_words = {
    "bool": true, "byte": true, "short": true, "int": true,
    "long": true, "half": true, "float": true, "double": true,
    "string": true, "list": true, "map": true, "array": true,
    "builder": true, "file": true, "task": true,
}

private const builtin_words = {
    "abs": true, "assert": true, "ceil": true, "chr": true,
    "clamp": true, "clock_ms": true, "dir_create": true, "dir_list": true,
    "epoch_ms": true, "env": true,
    "error": true, "exit": true, "file_append": true, "file_delete": true,
    "path_kind": true, "file_open": true, "file_read": true,
    "file_rename": true, "file_write": true, "floor": true, "free": true,
    "key_read": true, "key_text": true, "len": true, "max": true,
    "min": true, "ord": true, "os_available_memory": true,
    "os_cpu_count": true, "os_total_memory": true, "parse_float": true,
    "parse_int": true, "parse_string": true, "print": true,
    "print_error": true, "range": true, "read_line": true,
    "shell_run": true, "sleep_ms": true, "sqrt": true, "term_clear": true, "term_cols": true,
    "term_event_data": true, "term_flush": true, "term_move": true,
    "term_rows": true, "term_style": true, "term_write": true,
    "trap": true, "trunc": true,
    "gpu_backend": true, "ui_window_open": true, "ui_window_surface": true,
    "gpu_surface_size": true, "gpu_surface_clear": true,
    "gpu_surface_fill_rect": true, "gpu_surface_present": true,
}

# What a word in a source line is, and the style that says so.
#
# This used to be a `long` and the comment `# 1 keyword, 2 type name,
# 3 builtin, 0 plain` — an enum written down in prose, dispatched on
# with an `elif` chain over numbers (docs/ENUMS.md's evidence).  The
# `match` below has an arm for every member and no `else`, so a fifth
# class of word cannot be added without the compiler naming this site.
private enum Word:
    # A reserved word: the shape of the program.
    keyword
    # A capitalized name — a struct, an enum, or anything else the
    # language's own convention says is a type.
    type_name
    # A name the language supplies rather than the program.
    builtin
    # A program's own names, and everything left over.
    plain

    # Which of the four a word is.  The order is the language's: a
    # reserved word is a keyword before it could be anything else, and
    # a capitalized name is a type before a builtin (no builtin is
    # capitalized, so the two never actually race).
    static func of(text: string) -> Word:
        if keyword_words.has(text):
            return Word.keyword
        if type_words.has(text):
            return Word.type_name
        if len(text) > 0 and Bytes.is_upper(text.byte_at(0)):
            return Word.type_name
        if builtin_words.has(text):
            return Word.builtin
        return Word.plain

    # A style is a value, so this answers one instead of performing
    # one: what the screen does with it is the screen's business.
    func style() -> termui.Style:
        match self:
            keyword:
                return theme.keyword
            type_name:
                return theme.type_name
            builtin:
                return theme.builtin
            plain:
                return theme.plain

# What the file pane shows, and the one thing that owns it.
#
# **This struct exists for an ownership reason, and it is the one thing
# the migration had to learn.**  A bound method takes its receiver by
# *borrow*: the function value's two-slot run holds the receiver's
# handles the way a struct copy would (docs/BINDING.md, OWNERSHIP.md
# S26).  So a receiver whose container field is later **replaced**
# leaves the provider pointing at a list that has since been freed —
# `use_after_free`, at the first row the pane draws.  A listing that is
# emptied and refilled in place can never do that, and a struct of its
# own is what makes the rule small enough to state and keep.
private struct Names:
    rows: list(string)

    # The provider: what row `index` says.
    func at(index: long) -> string:
        return self.rows[index]

    func count() -> long:
        return len(self.rows)

    # Replace the listing without replacing the list.
    func refill(fresh: list(string)):
        self.rows.clear()
        for name in fresh:
            self.rows.append(name)

# The editor's whole state, and the operations on it.
#
# `State` owns the text, the buffers, the listing behind the file pane
# and the file pane's own widget value.  What it does *not* own is the
# screen: a `Screen` is passed in to be drawn on, because the loop that
# owns it is `main`'s (docs/TERMUI.md D1).
private struct State:
    path: string
    content: string
    message: string
    buffers: list(model.Buffer)
    names: Names
    # The file pane.  A `Rows` holds no container — it holds counters
    # and a provider — so it is a value, and `self.files` is a field
    # like any other (docs/TERMUI.md D8).
    files: rows.Rows
    # Which directory the file pane is showing.  It starts where the
    # editor was started and moves when a person walks into a row.
    directory: string = "."
    active: long = 0
    output: string = ""
    output_scroll: long = 0
    file_pane: bool = false
    output_pane: bool = false
    focus: model.Focus = model.Focus.editor
    cursor: long = 0
    scroll: long = 0
    dirty: bool = false
    quit_pending: bool = false
    quit: bool = false

    # Park the active view before changing files.  Keeping this copy in
    # the module-owned buffer list is what lets two unsaved files live in
    # one editor session without making the terminal host know anything
    # about editor state.
    func remember():
        self.buffers[self.active].path = self.path
        self.buffers[self.active].content = self.content
        self.buffers[self.active].message = self.message
        self.buffers[self.active].cursor = self.cursor
        self.buffers[self.active].scroll = self.scroll
        self.buffers[self.active].dirty = self.dirty

    func restore():
        let buffer = self.buffers[self.active]
        self.path = buffer.path
        self.content = buffer.content
        self.message = buffer.message
        self.cursor = buffer.cursor
        self.scroll = buffer.scroll
        self.dirty = buffer.dirty
        self.quit_pending = false

    # One line of the build output, by index.
    func output_line(index: long) -> string:
        let start = Text.line_at(self.output, index)
        return self.output[start:Text.line_end(self.output, start)]

    # The directory one level up from `here`.
    #
    # `..` rather than a lexical parent, because a lexical one is
    # wrong across a symbolic link and this editor has no business
    # deciding that.  Climbing out of a path that is already climbing
    # adds another `..` instead of eating the one that is there.
    static func parent_of(here: string) -> string:
        if here == ".":
            return ".."
        if paths.base(here) == "..":
            return here + "/.."
        return paths.dir(here)

    # `name`, as a path, from a pane showing `here`.
    #
    # The bare name when the pane is showing the directory the editor
    # was started in, because that is what the command line said and
    # what the status bar has always shown: "./notes.txt" and
    # "notes.txt" are one file, and a pane that renamed it would open
    # a second buffer onto it.
    static func under(here: string, name: string) -> string:
        if here == ".":
            return name
        return paths.join(here, name)

    # Refresh the optional left pane from the directory it is showing.
    #
    # **The pane lists entries, not names** (`files.entries`), so it
    # knows which rows are directories and marks them with a trailing
    # "/" — the mark a reader expects and the editor could not draw
    # before, because `files.list` answered names with no kinds.  A
    # directory that is not the top of the tree gets a ".." row, so a
    # person who walked in can walk back out.
    #
    # The active path is retained even when it was opened as a new file
    # and is therefore not in the listing yet — but only while the pane
    # is showing the directory that file is in, since a name from
    # somewhere else in a listing of here would be a lie.
    func refresh_files():
        var found = new list(files.Entry)
        found = files.entries(self.directory) catch reason:
            self.message = reason
            return
        var names = new list(string)
        if self.directory != ".":
            names.append("../")
        for entry in found:
            match entry.kind:
                directory:
                    names.append(entry.name + "/")
                file:
                    names.append(entry.name)
                other:
                    names.append(entry.name)
        free(found)
        if paths.dir(self.path) == self.directory and not names.contains(paths.base(self.path)):
            names.append(paths.base(self.path))
        self.names.refill(names)
        free(names)
        self.files.selected = 0
        for index in range(0, self.names.count()):
            if State.under(self.directory, self.names.rows[index]) == self.path:
                self.files.selected = index
                return

    # Open the row at `index`, or walk into it.
    #
    # **Selecting a directory enters it**, which is the whole reason
    # the pane needed kinds: it used to hand a directory name to
    # `files.read` and answer "cannot read src", with nowhere to go
    # from there.  The mark and the walk are one decision — a row a
    # person can see is a directory is a row they will expect to open.
    func open_selected(index: long):
        if index < 0 or index >= self.names.count():
            return
        let row = self.names.rows[index]
        if strings.ends_with(row, "/"):
            if row == "../":
                self.directory = State.parent_of(self.directory)
            else:
                self.directory = State.under(self.directory, row[0:len(row) - 1])
            self.refresh_files()
            self.message = "in " + self.directory
            return
        let wanted = State.under(self.directory, row)
        if wanted == self.path:
            self.focus = model.Focus.editor
            return
        self.remember()
        for other in range(0, len(self.buffers)):
            if self.buffers[other].path == wanted:
                self.active = other
                self.restore()
                self.focus = model.Focus.editor
                return
        var content = ""
        content = files.read(wanted) catch reason:
            self.message = reason
            return
        self.buffers.append(model.Buffer(path = wanted, content = content))
        self.active = len(self.buffers) - 1
        self.restore()
        self.focus = model.Focus.editor

    # One shell word, including paths with spaces or shell punctuation.
    static func shell_quote(value: string) -> string:
        return "'" + strings.replace(value, "'", "'\\''") + "'"

    func build():
        self.save()
        if self.dirty:
            self.output = "build skipped: " + self.message + "\n"
        else:
            let output = self.path + ".run"
            let command = "luce build " + State.shell_quote(self.path) + " --emit=exe -o " + State.shell_quote(output) + " && " + State.shell_quote(output)
            var command_output = ""
            command_output = os.shell.run(command) catch reason:
                self.output = reason
            if len(command_output) > 0:
                self.output = command_output
            self.message = "build/run finished"
        self.output_scroll = 0
        self.output_pane = true
        self.focus = model.Focus.output

    func toggle_files():
        self.file_pane = not self.file_pane
        if self.file_pane:
            self.refresh_files()
        elif self.focus == model.Focus.files:
            self.focus = model.Focus.editor

    func toggle_output():
        self.output_pane = not self.output_pane
        if self.output_pane:
            self.focus = model.Focus.output
        elif self.focus == model.Focus.output:
            self.focus = model.Focus.editor

    func next_pane():
        if self.focus == model.Focus.editor:
            if self.file_pane:
                self.focus = model.Focus.files
            elif self.output_pane:
                self.focus = model.Focus.output
        elif self.focus == model.Focus.files:
            if self.output_pane:
                self.focus = model.Focus.output
            else:
                self.focus = model.Focus.editor
        else:
            if self.file_pane:
                self.focus = model.Focus.files
            else:
                self.focus = model.Focus.editor

    # A left click changes the active pane and, in the editor, lands the
    # cursor at the nearest UTF-8 boundary.  The host has already
    # converted terminal coordinates to zero based cells, and the whole
    # report arrives as one `Mouse` value with its numbers copied in
    # (docs/TERMUI.md D6) rather than as five host calls that the next
    # event would overwrite.  Where each pane sat is the layout the
    # frame was just drawn with, handed over rather than remembered.
    func pointer(mouse: events.Mouse, layout: model.Layout):
        if mouse.kind == events.Pointer.wheel:
            if self.focus == model.Focus.output:
                self.output_scroll = max(self.output_scroll - mouse.wheel, 0)
            elif self.focus == model.Focus.editor:
                self.scroll = max(self.scroll - mouse.wheel, 0)
            return
        if mouse.kind != events.Pointer.press or mouse.button != 0:
            return
        let where = layout.pane_at(mouse.row, mouse.column)
        if where == none:
            return
        match where:
            files:
                self.focus = model.Focus.files
                if mouse.row > 0:
                    let index = self.files.top + mouse.row - 1
                    if index < self.names.count():
                        self.files.selected = index
                        self.open_selected(index)
                        self.focus = model.Focus.files
            output:
                self.focus = model.Focus.output
                let line = mouse.row - layout.output.row - 1
                if line >= 0:
                    self.output_scroll = max(line, 0)
            editor:
                self.focus = model.Focus.editor
                let line_index = self.scroll + mouse.row
                if line_index < Text.count_lines(self.content):
                    let start = Text.line_at(self.content, line_index)
                    let wanted = max(mouse.column - layout.text_start(), 0)
                    self.cursor = Text.at_column(self.content, start, wanted)

    # The file pane's keys.  Movement is the widget's — `move_by`
    # answers where it landed — and Enter is `choose()`, whose answer
    # the editor reads as "open that row" (docs/TERMUI.md D9).
    func file_key(intent: model.Intent):
        if self.names.count() == 0:
            return
        if intent == model.Intent.newline:
            match self.files.choose():
                moved(index):
                    return
                chosen(index):
                    self.open_selected(index)
            return
        if intent == model.Intent.move_left or intent == model.Intent.escape:
            self.focus = model.Focus.editor
            return
        let steps = model.steps_of(intent)
        if steps == 0:
            return
        # A widget writer needs a bare `var` binding (docs/SELF.md), so
        # a pane held in a field is moved through one and put back.
        var pane = self.files
        pane.move_by(steps)
        self.files = pane

    func output_key(intent: model.Intent):
        let steps = model.steps_of(intent)
        if steps == 0:
            return
        let total = Text.count_lines(self.output)
        self.output_scroll = clamp(self.output_scroll + steps, 0, max(total - 1, 0))

    func vertical(target_line: long):
        let total = Text.count_lines(self.content)
        let wanted = Text.column_of(self.content, self.cursor)
        let landing = clamp(target_line, 0, total - 1)
        let start = Text.line_at(self.content, landing)
        self.cursor = Text.at_column(self.content, start, wanted)

    # Early return on failure is the shape errors are for: the handler
    # says what went wrong and leaves, and the success lines below it
    # run only where the write landed (docs/FAILURE.md).
    #
    # The status line used to say "cannot write " and the path, which
    # was the program *guessing* the sentence the runtime had already
    # written and happening to agree.  `catch reason:` reads it instead.
    func save():
        files.write(self.path, self.content) catch reason:
            self.message = reason
            return
        self.dirty = false
        self.message = f"saved {self.path}"
        self.remember()

    func key(intent: model.Intent, inserted: string, visible: long):
        if intent == model.Intent.save:
            self.save()
            return
        if intent == model.Intent.quit:
            if self.dirty and not self.quit_pending:
                self.quit_pending = true
                self.message = "unsaved changes; Ctrl-Q again to discard"
            else:
                self.quit = true
            return
        if intent == model.Intent.build:
            self.build()
            return
        if intent == model.Intent.toggle_files:
            self.toggle_files()
            return
        if intent == model.Intent.toggle_output:
            self.toggle_output()
            return
        if intent == model.Intent.next_pane:
            self.next_pane()
            return
        if intent == model.Intent.escape:
            self.focus = model.Focus.editor
            return
        if self.focus == model.Focus.files:
            self.file_key(intent)
            return
        if self.focus == model.Focus.output:
            self.output_key(intent)
            return
        let line = Text.line_of(self.content, self.cursor)
        self.quit_pending = false
        if len(self.message) > 0:
            self.message = ""

        match intent:
            move_left:
                self.cursor = Text.previous_boundary(self.content, self.cursor)
            move_right:
                self.cursor = Text.next_boundary(self.content, self.cursor)
            move_up:
                self.vertical(line - 1)
            move_down:
                self.vertical(line + 1)
            page_up:
                self.vertical(line - visible)
            page_down:
                self.vertical(line + visible)
            line_start:
                self.cursor = Text.line_start(self.content, self.cursor)
            line_end:
                self.cursor = Text.line_end(self.content, self.cursor)
            erase_left:
                if self.cursor > 0:
                    # **The line docs/METHODS.md named.**  This measures
                    # against the content as it was *before* the erase,
                    # and the copy-and-return shape gave that snapshot
                    # away for free: `state` was still the old one while
                    # `next` was the new.  With one in-place receiver
                    # there is one name, so the snapshot has to be
                    # taken out loud —
                    # and a conversion that missed it would move the
                    # cursor by the wrong number of bytes with nothing
                    # to catch it, which is why the editor got a
                    # behavioural test first.
                    let before = self.content
                    self.content = Editing.erase_before(self.content, self.cursor)
                    self.cursor = Text.previous_boundary(before, self.cursor)
                    self.dirty = true
            erase_right:
                if self.cursor < len(self.content):
                    self.content = Editing.erase_at(self.content, self.cursor)
                    self.dirty = true
            newline:
                let current_indent = Text.indentation(self.content, self.cursor)
                var line_break = "\n" + current_indent
                if Text.opens_block(self.content, self.cursor):
                    line_break = line_break + indent_unit
                self.content = Editing.splice(self.content, self.cursor, line_break)
                self.cursor = self.cursor + len(line_break)
                self.dirty = true
            indent:
                self.content = Editing.splice(self.content, self.cursor, indent_unit)
                self.cursor = self.cursor + len(indent_unit)
                self.dirty = true
            insert_text:
                self.content = Editing.splice(self.content, self.cursor, inserted)
                self.cursor = self.cursor + len(inserted)
                self.dirty = true
            save:
                return
            build:
                return
            toggle_files:
                return
            toggle_output:
                return
            next_pane:
                return
            escape:
                return
            quit:
                return
            ignored:
                return

    func adjust(visible: long):
        let cursor_line = Text.line_of(self.content, self.cursor)
        if cursor_line < self.scroll:
            self.scroll = cursor_line
        elif cursor_line >= self.scroll + visible:
            self.scroll = cursor_line - visible + 1

    # --- drawing -----------------------------------------------------
    #
    # Every frame is one `clear`, one pass of writes into the back
    # buffer, and one `present` that emits only the cells that changed
    # (docs/TERMUI.md D2).  Nothing below reaches the terminal: the
    # screen is handed in, and where each pane sits arrived as
    # rectangles.

    func paint(view: screen.Screen, layout: model.Layout):
        view.clear()
        self.paint_text(view, layout)
        if self.file_pane:
            self.paint_files(view, layout)
        if self.output_pane:
            self.paint_output(view, layout)
        self.paint_status(view, layout)

    func paint_text(view: screen.Screen, layout: model.Layout):
        let source = layout.source()
        let cursor_line = Text.line_of(self.content, self.cursor)
        let total = Text.count_lines(self.content)
        let active = self.focus == model.Focus.editor
        var at = Text.line_at(self.content, self.scroll)
        for row in range(0, layout.text.rows):
            let line_index = self.scroll + row
            if line_index >= total:
                view.write(layout.text, row, 0, "   ~", theme.gutter)
                continue
            Draw.gutter(
                view,
                layout.text,
                row,
                line_index + 1,
                current = line_index == cursor_line,
                active = active,
            )
            let finish = Text.line_end(self.content, at)
            Draw.line(view, source, row, self.content, from = at, to = finish)
            at = finish + 1

    func paint_files(view: screen.Screen, layout: model.Layout):
        let area = layout.files
        if area.columns < 2 or area.rows < 1:
            return
        let interior = Draw.inside(area)
        let active = self.focus == model.Focus.files
        var pane = self.files
        pane.count = self.names.count()
        # Where the window sits is the widget's answer, and the frame
        # needs it before it can highlight the selected row's edge.
        pane.adjust(interior.rows)
        Draw.pane_frame(view, area, " files ", active, pane.selected - pane.top + 1)
        # A selected row is a bar across the pane, so the row is filled
        # before the name is written over it: `Rows` writes the label
        # and no more, which is the right amount of opinion for a
        # widget to have about somebody else's palette.
        let picked = pane.selected - pane.top
        if pane.count > 0 and picked >= 0 and picked < interior.rows:
            view.fill(
                termui.Rect(
                    row = interior.row + picked,
                    column = interior.column,
                    rows = 1,
                    columns = interior.columns,
                ),
                " ",
                theme.selected,
            )
        pane.draw(view, interior, theme.plain, theme.selected)
        self.files = pane

    func paint_output(view: screen.Screen, layout: model.Layout):
        let area = layout.output
        if area.columns < 2 or area.rows < 1:
            return
        let active = self.focus == model.Focus.output
        Draw.output_frame(view, area, layout.split_column(), " output ", active)
        # The output pane is a viewport, not a selection list, so it is
        # the one pane `Rows` does not fit: `Rows` scrolls to follow a
        # selection and this scrolls because a person said down.  Four
        # lines of loop is the honest price (docs/TERMUI.md, as built).
        let interior = Draw.inside(area)
        let total = Text.count_lines(self.output)
        for row in range(0, interior.rows):
            let index = self.output_scroll + row
            if index >= total:
                return
            view.write(interior, row, 0, self.output_line(index), theme.plain)

    func paint_status(view: screen.Screen, layout: model.Layout):
        let area = layout.status
        let line = Text.line_of(self.content, self.cursor)
        let column = Text.column_of(self.content, self.cursor)
        var flag = ""
        if self.dirty:
            flag = " +"
        var left = f" {self.path}{flag}  {line + 1}:{column + 1}"
        if len(self.message) > 0:
            left = left + f"  — {self.message}"
        if self.focus == model.Focus.files:
            left = left + "  [files]"
        elif self.focus == model.Focus.output:
            left = left + "  [output]"
        else:
            left = left + "  [editor]"
        let hint = "Ctrl-B build/run  Ctrl-W focus  Ctrl-S save  Ctrl-Q quit "
        # Padded in one call rather than one append per column, and
        # written in one call rather than one per character: `repeat`
        # answers "" for a width already overrun, and the screen clips
        # what will not fit.
        let bar = left + strings.repeat(" ", area.columns - left.width() - hint.width()) + hint
        view.write(area, 0, 0, bar, theme.status)

    # Where the terminal's own cursor belongs after the frame.
    func cursor_at(layout: model.Layout) -> (long, long):
        if self.focus == model.Focus.files:
            return clamp(self.files.selected - self.files.top + 1, 0, max(layout.files.rows - 1, 0)), 0
        if self.focus == model.Focus.output:
            return layout.output.row, 0
        let line = Text.line_of(self.content, self.cursor)
        let column = Text.column_of(self.content, self.cursor)
        let last_row = max(layout.text.rows - 1, 0)
        let last_column = max(layout.text.column + layout.text.columns - 1, 0)
        let landing = clamp(layout.text_start() + column, 0, last_column)
        return clamp(line - self.scroll, 0, last_row), landing

# Everything that puts characters in the back buffer and is not about
# editing.
#
# What is left here after the migration is the syntax highlighter and
# the two frames the editor draws itself: both of its panes are
# three-sided and share their edges with each other, which is the
# junction-merging compositor `termui.border` deliberately defers to
# v0.2 (docs/TERMUI.md D12).  `Border.draw` would draw four sides and
# take a row of output away.
private struct Draw:
    static func pane_style(active: bool) -> termui.Style:
        if active:
            return theme.pane_active
        return theme.pane_border

    # The space inside one of the editor's three-sided frames: a rule
    # down each side, a title along the top, and the status bar where
    # a bottom edge would be.
    static func inside(area: termui.Rect) -> termui.Rect:
        return termui.Rect(
            row = area.row + 1,
            column = area.column + 1,
            rows = max(area.rows - 1, 0),
            columns = max(area.columns - 2, 0),
        )

    # Write `text` at `column` inside `area`, clipped to `remaining`
    # display columns, and answer the columns it took.
    static func emit(view: screen.Screen, area: termui.Rect, row: long, column: long, text: string, style: termui.Style, remaining: long) -> long:
        if remaining <= 0:
            return 0
        let shown = text.take(remaining)
        view.write(area, row, column, shown, style)
        return shown.width()

    # The file pane's frame: a corner, a title, and a rule down each
    # side.  There is no bottom edge — the status bar is the bottom —
    # and the right-hand rule is the one the text pane sits against.
    static func pane_frame(
        view: screen.Screen,
        area: termui.Rect,
        title: string,
        active: bool,
        highlight_row: long,
    ):
        let border = Draw.pane_style(active)
        let room = max(area.columns - 2, 0)
        view.write(area, 0, 0, term.ui.junction(top = false, right = true, bottom = true, left = false), border)
        let shown = title.take(room)
        view.write(area, 0, 1, shown, border)
        let used = shown.width()
        if used < room:
            view.write(area, 0, 1 + used, strings.repeat(term.ui.horizontal(), room - used), border)
        view.write(area, 0, area.columns - 1, term.ui.junction(top = false, right = false, bottom = true, left = true), border)
        for row in range(1, area.rows):
            view.write(area, row, 0, term.ui.vertical(), Draw.pane_style(active and row == highlight_row))
            view.write(area, row, area.columns - 1, term.ui.vertical(), border)

    # The output pane's frame: a top edge that meets the file pane's
    # rule where they cross, and a rule down each side.
    static func output_frame(
        view: screen.Screen,
        area: termui.Rect,
        split: long,
        title: string,
        active: bool,
    ):
        let border = Draw.pane_style(active)
        var title_at: long = 2
        if split > 0:
            title_at = split + 2
        if title_at + len(title) >= area.columns - 1:
            title_at = -1
        for column in range(0, area.columns):
            var glyph = term.ui.horizontal()
            if column == 0:
                glyph = term.ui.junction(top = split > 0, right = true, bottom = true, left = false)
            elif column == area.columns - 1:
                glyph = term.ui.junction(top = false, right = false, bottom = true, left = true)
            elif split > 0 and column == split:
                glyph = term.ui.junction(top = true, right = true, bottom = false, left = true)
            elif title_at >= 0 and column >= title_at and column < title_at + len(title):
                let offset = column - title_at
                glyph = title[offset:offset + 1]
            view.write(area, 0, column, glyph, border)
        for row in range(1, area.rows):
            view.write(area, row, 0, term.ui.vertical(), border)
            view.write(area, row, area.columns - 1, term.ui.vertical(), border)

    # One source line with Luce highlighting, clipped to `area`.
    static func line(view: screen.Screen, area: termui.Rect, row: long, content: string, from: long, to: long):
        var at = from
        var used: long = 0
        let width = area.columns
        while at < to and used < width:
            let byte = content.byte_at(at)
            if byte == 35:
                used = used + Draw.emit(view, area, row, used, content[at:to], theme.comment, width - used)
                at = to
            elif byte == 102 and at + 1 < to and content.byte_at(at + 1) == 34 and (at == from or not Bytes.is_word(content.byte_at(at - 1))):
                let close = Text.quoted_end(content, to, at + 1)
                used = used + Draw.emit(view, area, row, used, content[at:close], theme.text, width - used)
                at = close
            elif byte == 34:
                let close = Text.quoted_end(content, to, at)
                used = used + Draw.emit(view, area, row, used, content[at:close], theme.text, width - used)
                at = close
            elif Bytes.is_digit(byte):
                var stop = at + 1
                if stop < to and (content.byte_at(stop) == 120 or content.byte_at(stop) == 88):
                    stop = stop + 1
                    while stop < to and (Bytes.is_hex_digit(content.byte_at(stop)) or content.byte_at(stop) == 95):
                        stop = stop + 1
                elif stop < to and (content.byte_at(stop) == 98 or content.byte_at(stop) == 66):
                    stop = stop + 1
                    while stop < to and (content.byte_at(stop) == 48 or content.byte_at(stop) == 49 or content.byte_at(stop) == 95):
                        stop = stop + 1
                else:
                    while stop < to and (Bytes.is_digit(content.byte_at(stop)) or content.byte_at(stop) == 95):
                        stop = stop + 1
                    if stop < to and content.byte_at(stop) == 46:
                        stop = stop + 1
                        while stop < to and (Bytes.is_digit(content.byte_at(stop)) or content.byte_at(stop) == 95):
                            stop = stop + 1
                    if stop < to and (content.byte_at(stop) == 101 or content.byte_at(stop) == 69):
                        stop = stop + 1
                        if stop < to and (content.byte_at(stop) == 43 or content.byte_at(stop) == 45):
                            stop = stop + 1
                        while stop < to and (Bytes.is_digit(content.byte_at(stop)) or content.byte_at(stop) == 95):
                            stop = stop + 1
                used = used + Draw.emit(view, area, row, used, content[at:stop], theme.number, width - used)
                at = stop
            elif Bytes.is_word_start(byte):
                var stop = at + 1
                while stop < to and Bytes.is_word(content.byte_at(stop)):
                    stop = stop + 1
                let word = Word.of(content[at:stop])
                used = used + Draw.emit(view, area, row, used, content[at:stop], word.style(), width - used)
                at = stop
            else:
                var stop = Text.next_boundary(content, at)
                stop = min(stop, to)
                used = used + Draw.emit(view, area, row, used, content[at:stop], theme.punct, width - used)
                at = stop

    static func gutter(view: screen.Screen, area: termui.Rect, row: long, number: long, current: bool, active: bool):
        var style = theme.gutter
        if current and active:
            style = theme.gutter_current
        view.write(area, row, 0, strings.pad_left(string(number), 4) + " ", style)

func main(args: list(string)):
    if len(args) == 0:
        print("usage: editor FILE [FILE ...]")
        return
    var buffers = new list(model.Buffer)
    for path in args:
        # One read, and what it answers decides the greeting.  The
        # exists-then-read this used to write had a window between the two
        # calls that nothing could close, and it could not tell "not
        # there" from "would not open" either (docs/FAILURE.md).
        var opening = ""
        var greeting = ""
        opening = files.read(path) catch:
            greeting = "new file"
        buffers.append(model.Buffer(
            path = path,
            content = opening,
            message = greeting,
        ))
    let first = buffers[0]
    # The active view is a small cache of the selected module-owned
    # buffer.  `remember` and `restore` make switching explicit and keep
    # all editing operations on the same simple fields as before.
    var state = State(
        path = first.path,
        content = first.content,
        message = first.message,
        buffers = give buffers,
        names = Names(rows = new list(string)),
        files = rows.Rows(render = none),
        cursor = first.cursor,
        scroll = first.scroll,
        dirty = first.dirty,
    )
    # **The wiring line the package was designed around**: the pane
    # reads the editor's listing through a bound method, which borrows
    # the receiver rather than taking it, so the list stays the
    # editor's (docs/BINDING.md, docs/TERMUI.md D8).
    state.files.render = state.names.at
    state.refresh_files()
    # The app owns the loop (D1): termui supplies a screen, a layout
    # vocabulary and an event stream, and never takes control.
    var view = screen.Screen.of(term.rows(), term.cols())
    var input = events.Events()
    while not state.quit:
        # A resize is a new grid and a full repaint; an unchanged size
        # answers immediately, so this is the whole of resize handling.
        view.resize(term.rows(), term.cols())
        let layout = model.Layout.of(view.area(), state.file_pane, state.output_pane)
        state.adjust(layout.text.rows)
        state.paint(view, layout)
        view.present()
        let cursor_row, cursor_column = state.cursor_at(layout)
        term.move(cursor_row, cursor_column)
        term.flush()
        match input.next():
            closed:
                # The keyboard ran dry — a pipe that ended, a terminal
                # that closed — and there is no one left to ask what to
                # do about unsaved work, so the editor stops rather
                # than asking forever.
                break
            resize:
                continue
            key(pressed):
                state.key(model.intent_of(pressed), "", layout.text.rows)
            text(typed):
                state.key(model.Intent.insert_text, typed, layout.text.rows)
            mouse(pointer):
                state.pointer(pointer, layout)
