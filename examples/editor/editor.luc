# The Luce editor — a terminal editor for Luce, written in Luce.
#
#   editor FILE [FILE ...]
#   ^S save   ^B build/run   ^F find   ^Z undo   ^Y redo   ^Q quit
#   ^E files  ^O output      ^W focus next pane
#
# The screen is a retained tree: each component is constructed once
# with the shared model, owns its pane's drawing and behavior, and the
# workbench reshapes the stacks through its model subscription.
# termui owns the application loop, terminal lifecycle, layout,
# drawing, input routing and shutdown.

import std.strings
from termui import Application
from termui.layout import VStack, HStack
from termui.constraints import Fixed, Grow
import model
from ui.filelist import FileList
from ui.source import Editor
from ui.console import Console
from ui.statusbar import StatusBar
from ui.workbench import Workbench

pub func main(args: list[str]):
    if len(args) == 0:
        print("usage: editor FILE [FILE ...]")
        return
    let shared = model.open(args)

    var across = HStack()
    across.add(FileList(shared), Fixed(0))
    across.add(Editor(shared), Grow(minimum = Editor.minimum_columns()))

    var screen = VStack()
    screen.add(across, Grow(minimum = 1))
    screen.add(Console(shared), Fixed(0))
    screen.add(StatusBar(shared), Fixed(1))

    var app = Application()
    app.set_layout(Workbench(shared, across, screen))
    # A Luce buffer gets the toolchain's language server, held through
    # the loop's idle tick; the command is data, so another language's
    # server plugs in the same way.  A world without the server leaves
    # the editor exactly as it was.
    if strings.ends_with(shared.document().path, ".luc"):
        # The installed stage-0 server is `luce-lsp-0`; a development
        # tree still builds `luce-lsp`.  `attach_lsp` takes the command
        # as data, so the editor prefers the installed name and the
        # client's spawn failure path covers a tree with neither.
        shared.attach_lsp("luce-lsp-0")
        app.set_tick(100)
    app.start()
