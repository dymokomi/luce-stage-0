# The loom editor — a modern terminal editor written in Luce, for Luce.
#
# Runs on the loom terminal builtins: the host owns raw mode and escape
# sequences, this program owns every editing decision.  Per-line syntax
# highlighting for Luce: keywords, capitalized type names, builtins,
# strings, numbers, and comments.
#
#   loom edit FILE [FILE ...] (or: loom run editor.lc FILE [FILE ...])
#   Ctrl-S save   Ctrl-B build/run   Ctrl-Q quit (twice to discard changes)
#   Ctrl-E files  Ctrl-O output     Ctrl-W focus next pane
#
# Nothing here is reachable from another module, so everything but
# `main` is `private` (docs/VISIBILITY.md): the file is the unit, and
# what a program's insides are called is nobody else's business.

import editor_model
import std.files
import std.os
import std.strings

private struct Theme:
    keyword: long
    type_name: long
    builtin: long
    text: long
    number: long
    comment: long
    plain: long
    punct: long
    gutter: long
    gutter_current: long
    status_fg: long
    status_bg: long
    alert: long
    pane_border: long
    pane_active: long
    pane_active_bg: long

# One file-scope constant instead of a function per color.
private const theme = Theme(
    keyword = 176,
    type_name = 80,
    builtin = 74,
    text = 114,
    number = 215,
    comment = 244,
    plain = 252,
    punct = 249,
    gutter = 240,
    gutter_current = 250,
    status_fg = 252,
    status_bg = 237,
    alert = 215,
    pane_border = 238,
    pane_active = 255,
    pane_active_bg = 236,
)

# Luce's lexer uses the same four-column step, and the editor writes
# spaces rather than tabs so what it creates is immediately valid source.
private const indent_unit = "    "

# What a single byte is, before anything has decided what it means.
# Every predicate here answers about one byte and reaches nothing.
private struct Bytes:
    static func continuation(byte: byte) -> bool:
        return byte >= 128 and byte < 192

    static func is_digit(byte: byte) -> bool:
        return byte >= 48 and byte <= 57

    static func is_hex_digit(byte: byte) -> bool:
        return Bytes.is_digit(byte) or (byte >= 65 and byte <= 70) or (byte >= 97 and byte <= 102)

    static func is_upper(byte: byte) -> bool:
        return byte >= 65 and byte <= 90

    static func is_alpha(byte: byte) -> bool:
        return Bytes.is_upper(byte) or (byte >= 97 and byte <= 122)

    static func is_word_start(byte: byte) -> bool:
        return Bytes.is_alpha(byte) or byte == 95 or byte >= 194

    static func is_word(byte: byte) -> bool:
        return Bytes.is_word_start(byte) or Bytes.is_digit(byte) or Bytes.continuation(byte)

# UTF-8 boundaries, lines and columns over a whole buffer.
private struct Text:
    static func previous_boundary(value: string, cursor: long) -> long:
        if cursor <= 0:
            return 0
        var at = cursor - 1
        while at > 0 and Bytes.continuation(value.byte_at(at)):
            at = at - 1
        return at

    static func next_boundary(value: string, cursor: long) -> long:
        if cursor >= len(value):
            return len(value)
        var at = cursor + 1
        while at < len(value) and Bytes.continuation(value.byte_at(at)):
            at = at + 1
        return at

    static func line_start(value: string, cursor: long) -> long:
        var at = cursor
        while at > 0 and value.byte_at(at - 1) != 10:
            at = at - 1
        return at

    static func line_end(value: string, cursor: long) -> long:
        var at = cursor
        while at < len(value) and value.byte_at(at) != 10:
            at = at + 1
        return at

    # The leading whitespace already in the line at the cursor.  The
    # result is borrowed from `value` and is safe to use while the
    # caller is still deciding what the next line should contain.
    static func indentation(value: string, cursor: long) -> string:
        let start = Text.line_start(value, cursor)
        var at = start
        while at < cursor:
            let byte = value.byte_at(at)
            if byte != 32 and byte != 9:
                break
            at = at + 1
        return value[start:at]

    # Whether the code before the cursor opens an indented block.  A
    # small lexical scan is enough here: comments and quoted strings
    # are not Luce layout, but a colon before a trailing comment is.
    static func opens_block(value: string, cursor: long) -> bool:
        let start = Text.line_start(value, cursor)
        var at = start
        var quoted = false
        var escaped = false
        var last: byte = 0
        while at < cursor:
            let byte = value.byte_at(at)
            if quoted:
                if escaped:
                    escaped = false
                elif byte == 92:
                    escaped = true
                elif byte == 34:
                    quoted = false
            elif byte == 35:
                break
            elif byte == 34:
                quoted = true
            elif byte != 32 and byte != 9:
                last = byte
            at = at + 1
        return not quoted and last == 58

    static func quoted_end(value: string, finish: long, opening: long) -> long:
        var close = opening + 1
        var closed = false
        while close < finish and not closed:
            let byte = value.byte_at(close)
            if byte == 92:
                close = close + 2
            elif byte == 34:
                closed = true
                close = close + 1
            else:
                close = close + 1
        return min(close, finish)

    static func line_of(value: string, cursor: long) -> long:
        var line = 0
        for at in range(0, cursor):
            if value.byte_at(at) == 10:
                line = line + 1
        return line

    static func count_lines(value: string) -> long:
        return Text.line_of(value, len(value)) + 1

    static func column_of(value: string, cursor: long) -> long:
        var at = Text.line_start(value, cursor)
        var column = 0
        while at < cursor:
            at = Text.next_boundary(value, at)
            column = column + 1
        return column

    static func line_at(value: string, wanted: long) -> long:
        var at = 0
        var line = 0
        while line < wanted and at < len(value):
            if value.byte_at(at) == 10:
                line = line + 1
            at = at + 1
        return at

    static func at_column(value: string, start: long, column: long) -> long:
        var at = start
        var current = 0
        let finish = Text.line_end(value, start)
        while at < finish and current < column:
            at = Text.next_boundary(value, at)
            current = current + 1
        return at

    static func width(value: string) -> long:
        var at: long = 0
        var columns = 0
        while at < len(value):
            at = Text.next_boundary(value, at)
            columns = columns + 1
        return columns

private struct Editing:
    static func splice(value: string, cursor: long, extra: string) -> string:
        return value[0:cursor] + extra + value[cursor:len(value)]

    static func erase_before(value: string, cursor: long) -> string:
        let before = Text.previous_boundary(value, cursor)
        return value[0:before] + value[cursor:len(value)]

    static func erase_at(value: string, cursor: long) -> string:
        let after = Text.next_boundary(value, cursor)
        return value[0:cursor] + value[after:len(value)]

# --- the word tables -------------------------------------------------
#
# **The language's own words, spelled once each.**  These used to be
# forty-six `word == "…"` comparisons — a hash set written as a truth
# table — and they had drifted eight language generations out of date:
# `enum`, `match`, `new`, `import`, `give`, `copy`, `none`, `try`,
# `catch`, `self`, `spawn` and `static` were all missing, and so were
# twenty-one builtins the language has gained since.  Ground truth is
# the compiler's own tables, which `tools/grammar.zig` reads for the
# VS Code grammar:
# `02_lex/token.zig`'s `keywords` (thirty-three words) and
# `04_semantics/builtins.zig`'s `builtins` (forty-six), plus `range`,
# which is syntax the parser recognises only inside a `for`.
#
# Two words came *out*.  `slice` is a name the language does not have
# at all any more, and `byte_at` is a **method**: it is only
# a name after a receiver and a dot, which is what the VS Code grammar
# gives its own rule for.  This highlighter colours words, not
# receivers, so a method list here would colour a program's own `find`
# and `get` and `build` as well — the two lists are the free builtins
# and nothing else.
#
# **An immutable lookup table, rather than a chain compared.**  Luce
# has no set type yet, so a program-root `map(string, bool)` is the
# exact membership table: one lookup, no fenced-string scan, and a
# duplicate spelling is a compile-time error.
private const keyword_words = {
    "and": true, "break": true, "catch": true, "const": true,
    "continue": true, "copy": true, "elif": true, "else": true,
    "enum": true, "false": true, "for": true, "func": true,
    "give": true, "if": true, "import": true, "in": true,
    "let": true, "match": true, "new": true, "none": true,
    "not": true, "or": true, "private": true, "public": true,
    "return": true, "self": true, "spawn": true, "static": true,
    "struct": true, "true": true, "try": true, "var": true,
    "while": true,
}

# The language's lowercase builtin types are types too.  The original
# editor only treated capitalized user declarations as types, which left
# the current spellings in `std.os` signatures (`string!`, `long`, and
# `list(string)`) looking like ordinary identifiers.
private const type_words = {
    "bool": true, "byte": true, "short": true, "int": true,
    "long": true, "half": true, "float": true, "double": true,
    "string": true, "list": true, "map": true, "array": true,
    "builder": true, "file": true, "task": true,
}

private const builtin_words = {
    "abs": true, "assert": true, "ceil": true, "chr": true,
    "clamp": true, "clock_ms": true, "dir_list": true, "env": true,
    "error": true, "exit": true, "file_append": true, "file_delete": true,
    "file_exists": true, "file_open": true, "file_read": true,
    "file_rename": true, "file_write": true, "floor": true, "free": true,
    "key_read": true, "key_text": true, "len": true, "max": true,
    "min": true, "ord": true, "os_available_memory": true,
    "os_cpu_count": true, "os_total_memory": true, "parse_float": true,
    "parse_int": true, "parse_string": true, "print": true,
    "print_error": true, "range": true, "read_line": true,
    "shell_run": true, "sleep_ms": true, "sqrt": true, "term_clear": true, "term_cols": true,
    "term_flush": true, "term_move": true, "term_rows": true,
    "term_style": true, "term_write": true, "trap": true, "trunc": true,
}

# What a word in a source line is, and the color that says so.
#
# This used to be a `long` and the comment `# 1 keyword, 2 type name,
# 3 builtin, 0 plain` — an enum written down in prose, dispatched on
# with an `elif` chain over numbers (docs/ENUMS.md's evidence).  The
# `match` below has an arm for every member and no `else`, so a fifth
# class of word cannot be added without the compiler naming this site.
private enum Word:
    # A reserved word: the shape of the program.
    keyword
    # A capitalized name — a struct, an enum, or anything else the
    # language's own convention says is a type.
    type_name
    # A name the language supplies rather than the program.
    builtin
    # A program's own names, and everything left over.
    plain

    # Which of the four a word is.  The order is the language's: a
    # reserved word is a keyword before it could be anything else, and
    # a capitalized name is a type before a builtin (no builtin is
    # capitalized, so the two never actually race).
    static func of(text: string) -> Word:
        if keyword_words.has(text):
            return Word.keyword
        if type_words.has(text):
            return Word.type_name
        if len(text) > 0 and Bytes.is_upper(text.byte_at(0)):
            return Word.type_name
        if builtin_words.has(text):
            return Word.builtin
        return Word.plain

    func style():
        match self:
            keyword:
                os.term.style(theme.keyword, bold = true)
            type_name:
                os.term.style(theme.type_name)
            builtin:
                os.term.style(theme.builtin)
            plain:
                os.term.style(theme.plain)

# What a keystroke means to the editor.
#
# **The wart this deletes.**  `State.key` used to take the host's key
# *name* and dispatch on it with fifteen string comparisons in one
# `elif` chain with no final `else`: a misspelled `"page_dwon"`
# compiled and silently did nothing, and exhaustiveness is exactly the
# property a chain of comparisons cannot state (docs/ENUMS.md).  The
# host's stable key names (`src/apps/host.zig`'s `keyView`) are
# translated to intents *once*, here at the edge, and every key the
# editor does not bind arrives as `ignored` — named, not fallen
# through.  Past this function the editor never compares a string to
# decide what to do, and `match` refuses to compile with a member
# missing an arm.
private enum Intent:
    move_left
    move_right
    move_up
    move_down
    page_up
    page_down
    line_start
    line_end
    erase_left
    erase_right
    newline
    indent
    # `insert_text` rather than `insert`: `insert` is a list method,
    # and the language reserves the method names for the receivers
    # that answer to them (`luce.sema.reserved`).
    insert_text
    save
    build
    toggle_files
    toggle_output
    next_pane
    escape
    quit
    # Every other key the terminal can send — `escape`, `ctrl_a`, a
    # control the editor has no use for.  It is a member, so the
    # `match` that handles it has to say so out loud.
    ignored

    # The whole of the translation, and the only place in the editor
    # a key name is a string.  A name this does not know is `ignored`
    # by the last line rather than by falling off the end of a chain.
    static func of(name: string) -> Intent:
        if name == "left":
            return Intent.move_left
        if name == "right":
            return Intent.move_right
        if name == "up":
            return Intent.move_up
        if name == "down":
            return Intent.move_down
        if name == "page_up":
            return Intent.page_up
        if name == "page_down":
            return Intent.page_down
        if name == "home":
            return Intent.line_start
        if name == "end":
            return Intent.line_end
        if name == "backspace":
            return Intent.erase_left
        if name == "delete":
            return Intent.erase_right
        if name == "enter":
            return Intent.newline
        if name == "tab":
            return Intent.indent
        if name == "text":
            return Intent.insert_text
        if name == "ctrl_s":
            return Intent.save
        if name == "ctrl_b":
            return Intent.build
        if name == "ctrl_e":
            return Intent.toggle_files
        if name == "ctrl_o":
            return Intent.toggle_output
        if name == "ctrl_w":
            return Intent.next_pane
        if name == "escape":
            return Intent.escape
        if name == "ctrl_q":
            return Intent.quit
        return Intent.ignored

# The editor's whole state, and the operations on it.
#
# `Handle` used to stand at the bottom of this file with four
# functions that all took `state: State`, opened with `var next =
# state` and ended with `return next`; every call site wrote `state =
# Handle.key(state, …)`.  Those were the two halves of a write-back
# spelled by hand at seven sites.  The methods below update their
# implied receiver directly, so every call site says only `state.key(…)`.
#
# `State` happens to carry only string, long and bool; receiver syntax
# does not expose that representation fact at the call site.
private enum Focus:
    editor
    files
    output

private struct State:
    path: string
    content: string
    message: string
    buffers: list(editor_model.Buffer)
    file_names: list(string)
    active: long = 0
    file_selected: long = 0
    output: string = ""
    output_scroll: long = 0
    file_pane: bool = false
    output_pane: bool = false
    focus: Focus = Focus.editor
    cursor: long = 0
    scroll: long = 0
    dirty: bool = false
    quit_pending: bool = false
    quit: bool = false

    # Park the active view before changing files.  Keeping this copy in
    # the module-owned buffer list is what lets two unsaved files live in
    # one editor session without making the terminal host know anything
    # about editor state.
    func remember():
        self.buffers[self.active].path = self.path
        self.buffers[self.active].content = self.content
        self.buffers[self.active].message = self.message
        self.buffers[self.active].cursor = self.cursor
        self.buffers[self.active].scroll = self.scroll
        self.buffers[self.active].dirty = self.dirty

    func restore():
        let buffer = self.buffers[self.active]
        self.path = buffer.path
        self.content = buffer.content
        self.message = buffer.message
        self.cursor = buffer.cursor
        self.scroll = buffer.scroll
        self.dirty = buffer.dirty
        self.quit_pending = false

    # Refresh the optional left pane from the current directory.  The
    # active path is retained even when it was opened as a new file and
    # therefore is not in the directory listing yet.
    func refresh_files():
        self.file_names = files.list(".") catch reason:
            self.message = reason
            return
        if not self.file_names.contains(self.path):
            self.file_names.append(self.path)
        self.file_selected = 0
        for index in range(0, len(self.file_names)):
            if self.file_names[index] == self.path:
                self.file_selected = index
                return

    func open_selected():
        if len(self.file_names) == 0:
            return
        let wanted = self.file_names[self.file_selected]
        if wanted == self.path:
            self.focus = Focus.editor
            return
        self.remember()
        for index in range(0, len(self.buffers)):
            if self.buffers[index].path == wanted:
                self.active = index
                self.restore()
                self.focus = Focus.editor
                return
        var content = ""
        content = files.read(wanted) catch reason:
            self.message = reason
            return
        self.buffers.append(editor_model.Buffer(path = wanted, content = content))
        self.active = len(self.buffers) - 1
        self.restore()
        self.focus = Focus.editor

    # One shell word, including paths with spaces or shell punctuation.
    static func shell_quote(value: string) -> string:
        return "'" + strings.replace(value, "'", "'\\''") + "'"

    func build():
        self.save()
        if self.dirty:
            self.output = "build skipped: " + self.message + "\n"
        else:
            let command = "loom luce " + State.shell_quote(self.path)
            var command_output = ""
            command_output = os.shell.run(command) catch reason:
                self.output = reason
            if len(command_output) > 0:
                self.output = command_output
            self.message = "build/run finished"
        self.output_scroll = 0
        self.output_pane = true
        self.focus = Focus.output

    func toggle_files():
        self.file_pane = not self.file_pane
        if self.file_pane:
            self.refresh_files()
        elif self.focus == Focus.files:
            self.focus = Focus.editor

    func toggle_output():
        self.output_pane = not self.output_pane
        if self.output_pane:
            self.focus = Focus.output
        elif self.focus == Focus.output:
            self.focus = Focus.editor

    func next_pane():
        if self.focus == Focus.editor:
            if self.file_pane:
                self.focus = Focus.files
            elif self.output_pane:
                self.focus = Focus.output
        elif self.focus == Focus.files:
            if self.output_pane:
                self.focus = Focus.output
            else:
                self.focus = Focus.editor
        else:
            if self.file_pane:
                self.focus = Focus.files
            else:
                self.focus = Focus.editor

    func file_key(intent: Intent):
        let total = len(self.file_names)
        if total == 0:
            return
        match intent:
            move_up:
                self.file_selected = max(self.file_selected - 1, 0)
            move_down:
                self.file_selected = min(self.file_selected + 1, total - 1)
            page_up:
                self.file_selected = max(self.file_selected - 8, 0)
            page_down:
                self.file_selected = min(self.file_selected + 8, total - 1)
            newline:
                self.open_selected()
            move_left:
                self.focus = Focus.editor
            escape:
                self.focus = Focus.editor
            ignored:
                return
            move_right:
                return
            line_start:
                return
            line_end:
                return
            erase_left:
                return
            erase_right:
                return
            indent:
                return
            insert_text:
                return
            save:
                return
            build:
                return
            toggle_files:
                return
            toggle_output:
                return
            next_pane:
                return
            quit:
                return

    func output_key(intent: Intent):
        let total = Text.count_lines(self.output)
        match intent:
            move_up:
                self.output_scroll = max(self.output_scroll - 1, 0)
            move_down:
                self.output_scroll = min(self.output_scroll + 1, max(total - 1, 0))
            page_up:
                self.output_scroll = max(self.output_scroll - 8, 0)
            page_down:
                self.output_scroll = min(self.output_scroll + 8, max(total - 1, 0))
            move_left:
                return
            move_right:
                return
            line_start:
                return
            line_end:
                return
            erase_left:
                return
            erase_right:
                return
            newline:
                return
            indent:
                return
            insert_text:
                return
            save:
                return
            build:
                return
            toggle_files:
                return
            toggle_output:
                return
            next_pane:
                return
            escape:
                return
            quit:
                return
            ignored:
                return

    func vertical(target_line: long):
        let total = Text.count_lines(self.content)
        let wanted = Text.column_of(self.content, self.cursor)
        let landing = clamp(target_line, 0, total - 1)
        let start = Text.line_at(self.content, landing)
        self.cursor = Text.at_column(self.content, start, wanted)

    # Early return on failure is the shape errors are for: the handler
    # says what went wrong and leaves, and the success lines below it
    # run only where the write landed (docs/FAILURE.md).
    #
    # The status line used to say "cannot write " and the path, which
    # was the program *guessing* the sentence the runtime had already
    # written and happening to agree.  `catch reason:` reads it instead.
    func save():
        files.write(self.path, self.content) catch reason:
            self.message = reason
            return
        self.dirty = false
        self.message = f"saved {self.path}"
        self.remember()

    func key(intent: Intent, inserted: string, visible: long):
        if intent == Intent.save:
            self.save()
            return
        if intent == Intent.quit:
            if self.dirty and not self.quit_pending:
                self.quit_pending = true
                self.message = "unsaved changes; Ctrl-Q again to discard"
            else:
                self.quit = true
            return
        if intent == Intent.build:
            self.build()
            return
        if intent == Intent.toggle_files:
            self.toggle_files()
            return
        if intent == Intent.toggle_output:
            self.toggle_output()
            return
        if intent == Intent.next_pane:
            self.next_pane()
            return
        if intent == Intent.escape:
            self.focus = Focus.editor
            return
        if self.focus == Focus.files:
            self.file_key(intent)
            return
        if self.focus == Focus.output:
            self.output_key(intent)
            return
        let line = Text.line_of(self.content, self.cursor)
        self.quit_pending = false
        if len(self.message) > 0:
            self.message = ""

        match intent:
            move_left:
                self.cursor = Text.previous_boundary(self.content, self.cursor)
            move_right:
                self.cursor = Text.next_boundary(self.content, self.cursor)
            move_up:
                self.vertical(line - 1)
            move_down:
                self.vertical(line + 1)
            page_up:
                self.vertical(line - visible)
            page_down:
                self.vertical(line + visible)
            line_start:
                self.cursor = Text.line_start(self.content, self.cursor)
            line_end:
                self.cursor = Text.line_end(self.content, self.cursor)
            erase_left:
                if self.cursor > 0:
                    # **The line docs/METHODS.md named.**  This measures
                    # against the content as it was *before* the erase,
                    # and the copy-and-return shape gave that snapshot
                    # away for free: `state` was still the old one while
                    # `next` was the new.  With one in-place receiver
                    # there is one name, so the snapshot has to be
                    # taken out loud —
                    # and a conversion that missed it would move the
                    # cursor by the wrong number of bytes with nothing
                    # to catch it, which is why the editor got a
                    # behavioural test first.
                    let before = self.content
                    self.content = Editing.erase_before(self.content, self.cursor)
                    self.cursor = Text.previous_boundary(before, self.cursor)
                    self.dirty = true
            erase_right:
                if self.cursor < len(self.content):
                    self.content = Editing.erase_at(self.content, self.cursor)
                    self.dirty = true
            newline:
                let current_indent = Text.indentation(self.content, self.cursor)
                var line_break = "\n" + current_indent
                if Text.opens_block(self.content, self.cursor):
                    line_break = line_break + indent_unit
                self.content = Editing.splice(self.content, self.cursor, line_break)
                self.cursor = self.cursor + len(line_break)
                self.dirty = true
            indent:
                self.content = Editing.splice(self.content, self.cursor, indent_unit)
                self.cursor = self.cursor + len(indent_unit)
                self.dirty = true
            insert_text:
                self.content = Editing.splice(self.content, self.cursor, inserted)
                self.cursor = self.cursor + len(inserted)
                self.dirty = true
            save:
                return
            build:
                return
            toggle_files:
                return
            toggle_output:
                return
            next_pane:
                return
            escape:
                return
            quit:
                return
            ignored:
                return

    func adjust(visible: long):
        let cursor_line = Text.line_of(self.content, self.cursor)
        if cursor_line < self.scroll:
            self.scroll = cursor_line
        elif cursor_line >= self.scroll + visible:
            self.scroll = cursor_line - visible + 1

    # The two `Draw` functions that took a `State`: they read their
    # implied receiver and perform no receiver writes.  Everything else
    # in `Draw` operates on text and columns rather than on the editor,
    # and remains a static namespace function.
    func status(rows: long, cols: long, line: long, column: long):
        os.term.move(rows - 1, 0)
        var flag = ""
        if self.dirty:
            flag = " +"
        var left = f" {self.path}{flag}  {line + 1}:{column + 1}"
        if len(self.message) > 0:
            left = left + f"  — {self.message}"
        if self.focus == Focus.files:
            left = left + "  [files]"
        elif self.focus == Focus.output:
            left = left + "  [output]"
        else:
            left = left + "  [editor]"
        let hint = "Ctrl-B build/run  Ctrl-W focus  Ctrl-S save  Ctrl-Q quit "
        # Padded in one call rather than one append per column: the
        # loop this replaces built a fresh string per space, every
        # frame.  `repeat` answers "" for a width already overrun.
        let bar = left + strings.repeat(" ", cols - Text.width(left) - Text.width(hint)) + hint
        os.term.style(theme.status_fg, theme.status_bg)
        let ignored = Draw.emit(bar, from = 0, to = len(bar), remaining = cols)

    func frame():
        let rows = max(os.term.rows(), 2)
        let cols = max(os.term.cols(), 10)
        var output_height: long = 0
        if self.output_pane:
            output_height = long(rows / 3)
            if output_height < 3:
                output_height = 3
            if output_height > 8:
                output_height = 8
            if output_height > rows - 2:
                output_height = rows - 2
            if output_height < 0:
                output_height = 0
        let editor_height = max(rows - 1 - output_height, 1)
        let visible = editor_height
        let side: long = 5
        var file_width: long = 0
        if self.file_pane:
            file_width = long(cols / 4)
            if file_width < 18:
                file_width = 18
            if file_width > 24:
                file_width = 24
            if file_width + side + 1 >= cols:
                file_width = max(cols - side - 1, 1)
        var text_start = side
        if self.file_pane:
            text_start = file_width + 1 + side
        let text_width = max(cols - text_start, 1)
        let cursor_line = Text.line_of(self.content, self.cursor)
        let cursor_column = Text.column_of(self.content, self.cursor)
        let total = Text.count_lines(self.content)

        os.term.clear()
        var at = Text.line_at(self.content, self.scroll)
        for row in range(0, visible):
            let line_index = self.scroll + row
            os.term.move(row, 0)
            if self.file_pane:
                Draw.file_line(
                    self.file_names,
                    row,
                    self.file_selected,
                    file_width,
                    active = self.focus == Focus.files,
                )
                os.term.move(row, file_width)
                Draw.pane_style(self.focus == Focus.files)
                if row == 0:
                    os.term.write(os.term.ui.junction(top = false, right = false, bottom = true, left = true))
                else:
                    os.term.write(os.term.ui.vertical())
                os.term.move(row, file_width + 1)
            if line_index < total:
                Draw.gutter(
                    line_index + 1,
                    current = line_index == cursor_line,
                    active = self.focus == Focus.editor,
                )
                let finish = Text.line_end(self.content, at)
                Draw.line(self.content, from = at, to = finish, width = text_width)
                at = finish + 1
            else:
                os.term.style(theme.gutter)
                os.term.write("   ~")
        if self.output_pane:
            var split: long = 0
            if self.file_pane:
                split = file_width
            self.output_frame(
                start = editor_height,
                finish = rows - 1,
                cols = cols,
                split = split,
            )
        self.status(rows = rows, cols = cols, line = cursor_line, column = cursor_column)
        if self.focus == Focus.files:
            os.term.move(clamp(self.file_selected, 0, visible - 1), 0)
        elif self.focus == Focus.output:
            os.term.move(editor_height, 0)
        else:
            os.term.move(
                clamp(cursor_line - self.scroll, 0, visible - 1),
                clamp(text_start + cursor_column, 0, cols - 1),
            )
        os.term.flush()

    func output_frame(start: long, finish: long, cols: long, split: long):
        let total = Text.count_lines(self.output)
        let interior = max(cols - 2, 0)
        for row in range(start, finish):
            os.term.move(row, 0)
            if row == start:
                Draw.horizontal_border(
                    cols,
                    split,
                    "output",
                    active = self.focus == Focus.output,
                )
            else:
                Draw.pane_style(self.focus == Focus.output)
                os.term.write(os.term.ui.vertical())
                let line_index = self.output_scroll + row - start - 1
                var used: long = 0
                if line_index < total:
                    let line_start = Text.line_at(self.output, line_index)
                    let line_finish = Text.line_end(self.output, line_start)
                    os.term.style(theme.plain)
                    used = Draw.emit(
                        self.output,
                        from = line_start,
                        to = line_finish,
                        remaining = interior,
                    )
                if used < interior:
                    os.term.write(strings.repeat(" ", interior - used))
                os.term.move(row, cols - 1)
                Draw.pane_style(self.focus == Focus.output)
                os.term.write(os.term.ui.vertical())

private struct Draw:
    static func pane_style(active: bool):
        if active:
            os.term.style(theme.pane_active, theme.pane_active_bg, bold = true)
        else:
            os.term.style(theme.pane_border)

    static func horizontal_border(width: long, split: long, label: string, active: bool):
        Draw.pane_style(active)
        let title = " " + label + " "
        var title_at: long = 2
        if split > 0:
            title_at = split + 2
        if title_at + len(title) >= width - 1:
            title_at = -1
        for column in range(0, width):
            if column == 0:
                if split > 0:
                    os.term.write(os.term.ui.junction(top = true, right = true, bottom = true, left = false))
                else:
                    os.term.write(os.term.ui.junction(top = false, right = true, bottom = true, left = false))
            elif column == width - 1:
                os.term.write(os.term.ui.junction(top = false, right = false, bottom = true, left = true))
            elif split > 0 and column == split:
                os.term.write(os.term.ui.junction(top = true, right = true, bottom = false, left = true))
            elif title_at >= 0 and column >= title_at and column < title_at + len(title):
                let offset = column - title_at
                os.term.write(title[offset:offset + 1])
            else:
                os.term.write(os.term.ui.horizontal())

    # Write [from, to) clipped to `remaining` display columns; returns
    # the columns actually used.
    static func emit(value: string, from: long, to: long, remaining: long) -> long:
        var at = from
        var used = 0
        while at < to and used < remaining:
            let stop = Text.next_boundary(value, at)
            os.term.write(value[at:stop])
            at = stop
            used = used + 1
        return used

    static func file_line(names: list(string), row: long, selected: long, width: long, active: bool):
        if row == 0:
            Draw.pane_style(active)
            os.term.write(os.term.ui.junction(top = false, right = true, bottom = true, left = false))
            let title = " files "
            let room = max(width - 1, 0)
            let shown = min(len(title), room)
            os.term.write(title[0:shown])
            if shown < room:
                os.term.write(strings.repeat(os.term.ui.horizontal(), room - shown))
            return
        Draw.pane_style(active and row == selected + 1)
        os.term.write(os.term.ui.vertical())
        let room = max(width - 1, 0)
        let index = row - 1
        if index < len(names):
            if index == selected:
                os.term.style(theme.status_fg, theme.status_bg, bold = true)
            else:
                os.term.style(theme.plain)
            let name = names[index]
            let used = Draw.emit(name, from = 0, to = len(name), remaining = room)
            if used < room:
                os.term.write(strings.repeat(" ", room - used))
        else:
            os.term.write(strings.repeat(" ", room))

    # One source line with Luce highlighting, clipped to `width`.
    static func line(content: string, from: long, to: long, width: long):
        var at = from
        var used: long = 0
        while at < to and used < width:
            let byte = content.byte_at(at)
            if byte == 35:
                os.term.style(theme.comment)
                used = used + Draw.emit(content, from = at, to = to, remaining = width - used)
                at = to
            elif byte == 102 and at + 1 < to and content.byte_at(at + 1) == 34 and (at == from or not Bytes.is_word(content.byte_at(at - 1))):
                let close = Text.quoted_end(content, to, at + 1)
                os.term.style(theme.text)
                used = used + Draw.emit(content, from = at, to = close, remaining = width - used)
                at = close
            elif byte == 34:
                let close = Text.quoted_end(content, to, at)
                os.term.style(theme.text)
                used = used + Draw.emit(content, from = at, to = close, remaining = width - used)
                at = close
            elif Bytes.is_digit(byte):
                var stop = at + 1
                if stop < to and (content.byte_at(stop) == 120 or content.byte_at(stop) == 88):
                    stop = stop + 1
                    while stop < to and (Bytes.is_hex_digit(content.byte_at(stop)) or content.byte_at(stop) == 95):
                        stop = stop + 1
                elif stop < to and (content.byte_at(stop) == 98 or content.byte_at(stop) == 66):
                    stop = stop + 1
                    while stop < to and (content.byte_at(stop) == 48 or content.byte_at(stop) == 49 or content.byte_at(stop) == 95):
                        stop = stop + 1
                else:
                    while stop < to and (Bytes.is_digit(content.byte_at(stop)) or content.byte_at(stop) == 95):
                        stop = stop + 1
                    if stop < to and content.byte_at(stop) == 46:
                        stop = stop + 1
                        while stop < to and (Bytes.is_digit(content.byte_at(stop)) or content.byte_at(stop) == 95):
                            stop = stop + 1
                    if stop < to and (content.byte_at(stop) == 101 or content.byte_at(stop) == 69):
                        stop = stop + 1
                        if stop < to and (content.byte_at(stop) == 43 or content.byte_at(stop) == 45):
                            stop = stop + 1
                        while stop < to and (Bytes.is_digit(content.byte_at(stop)) or content.byte_at(stop) == 95):
                            stop = stop + 1
                os.term.style(theme.number)
                used = used + Draw.emit(content, from = at, to = stop, remaining = width - used)
                at = stop
            elif Bytes.is_word_start(byte):
                var stop = at + 1
                while stop < to and Bytes.is_word(content.byte_at(stop)):
                    stop = stop + 1
                let word = Word.of(content[at:stop])
                word.style()
                used = used + Draw.emit(content, from = at, to = stop, remaining = width - used)
                at = stop
            else:
                var stop = Text.next_boundary(content, at)
                stop = min(stop, to)
                os.term.style(theme.punct)
                used = used + Draw.emit(content, from = at, to = stop, remaining = width - used)
                at = stop

    static func gutter(number: long, current: bool, active: bool):
        if current and active:
            os.term.style(theme.gutter_current)
        else:
            os.term.style(theme.gutter)
        os.term.write(strings.pad_left(string(number), 4) + " ")

func main(args: list(string)):
    if len(args) == 0:
        print("usage: editor FILE [FILE ...]")
        return
    var buffers = new list(editor_model.Buffer)
    for path in args:
        # One read, and what it answers decides the greeting.  The
        # exists-then-read this used to write had a window between the two
        # calls that nothing could close, and it could not tell "not
        # there" from "would not open" either (docs/FAILURE.md).
        var opening = ""
        var greeting = ""
        opening = files.read(path) catch:
            greeting = "new file"
        buffers.append(editor_model.Buffer(
            path = path,
            content = opening,
            message = greeting,
        ))
    let first = buffers[0]
    # The active view is a small cache of the selected module-owned
    # buffer.  `remember` and `restore` make switching explicit and keep
    # all editing operations on the same simple fields as before.
    var state = State(
        path = first.path,
        content = first.content,
        message = first.message,
            buffers = give buffers,
        file_names = new list(string),
        cursor = first.cursor,
        scroll = first.scroll,
        dirty = first.dirty,
    )
    state.refresh_files()
    while not state.quit:
        let visible = max(os.term.rows() - 1, 1)
        state.adjust(visible)
        state.frame()
        # `key_read` answers `string?`: `none` is the keyboard running
        # dry — a pipe that ended, a terminal that closed — and there
        # is no one left to ask what to do about unsaved work, so the
        # editor stops rather than asking forever.
        let name = os.term.key()
        if name == none:
            break
        state.key(Intent.of(name), os.term.text(), visible)
