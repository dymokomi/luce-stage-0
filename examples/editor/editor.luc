# The Luce editor — a terminal editor for Luce, written in Luce.
#
#   editor FILE [FILE ...]
#   ^S save   ^B build/run   ^F find   ^Z undo   ^Y redo   ^Q quit
#   ^E files  ^O output      ^W focus next pane
#
# The screen is a retained tree: each component is constructed once
# with the shared model, owns its pane's drawing and behavior, and the
# workbench reshapes the stacks through its model subscription.
# termui owns the application loop, terminal lifecycle, layout,
# drawing, input routing and shutdown.

import termui
from termui import VStack, HStack, fixed, grow
import model
from filelist import FileList
from source import Editor, gutter_width
from console import Console
from statusbar import StatusBar
from workbench import Workbench

func main(args: list[str]):
    if len(args) == 0:
        print("usage: editor FILE [FILE ...]")
        return
    let shared = model.open(args)

    var across = new HStack()
    across.add(new FileList(shared), fixed(0))
    across.add(new Editor(shared), grow(minimum = gutter_width + 1))

    var screen = new VStack()
    screen.add(across, grow(minimum = 1))
    screen.add(new Console(shared), fixed(0))
    screen.add(new StatusBar(shared), fixed(1))

    var app = new termui.Application()
    app.set_layout(new Workbench(shared, across, screen))
    app.start()
