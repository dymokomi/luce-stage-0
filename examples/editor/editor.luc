# The Luce editor — a terminal editor for Luce, written in Luce.
#
#   editor FILE [FILE ...]
#   ^S save   ^B build/run   ^F find   ^Z undo   ^Y redo   ^Q quit
#   ^E files  ^O output      ^W focus next pane
#
# `application.App` describes the screen. TermUI owns the application loop,
# terminal lifecycle, layout, drawing, input routing and shutdown.

import application
import termui

func main(args: list[str]):
    if len(args) == 0:
        print("usage: editor FILE [FILE ...]")
        return
    termui.run(application.open(args))
