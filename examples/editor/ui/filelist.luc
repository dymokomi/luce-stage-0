# The file pane: the retained component that lists the directory,
# opens rows, and starts the divider drag on its own right border.

from termui import View, Surface, Response, Rect, Event, Cursor, Line, Pointer, Edges, plain, route
from termui.widgets import Rows, Panel, EventHost, CursorHost
from model import Model, Drag, Focus, Intent
from ui.keymap import intent_of
from ui.theme import palette, pane_style

pub class FileList: View:
    var model: Model

    pub init(shared: Model):
        self.model = shared

    # --- data provider ----------------------------------------------

    pub func file_line(index: i64) -> Line:
        return plain(self.model.name_at(index), palette.plain)

    # --- cursor projection ------------------------------------------

    pub func file_cursor(area: Rect) -> Cursor?:
        if self.model.focus != Focus.files or area.is_empty():
            return none
        let top = Rows.visible_top(
            self.model.files.top,
            len(self.model.names),
            self.model.files.selected,
            area.rows,
        )
        return Cursor(
            row = area.row + clamp(self.model.files.selected - top, 0, max(area.rows - 1, 0)),
            column = area.column,
        )

    # --- events ------------------------------------------------------

    pub func frame_event(event: Event, area: Rect) -> Response:
        match event:
            mouse(pointer):
                if pointer.kind == Pointer.press and pointer.button == 0 and pointer.column == area.column + area.columns - 1:
                    self.model.dragging = Drag.files
                    return Response.handled
            else:
                return Response.ignored
        return Response.ignored

    pub func file_event(event: Event, area: Rect) -> Response:
        match event:
            key(press):
                if self.model.focus != Focus.files:
                    return Response.ignored
                let intent = intent_of(press)
                if intent == Intent.ignored:
                    return Response.ignored
                self.model.key(intent, "", area.rows)
                self.model.adjust_files(area.rows)
                return Response.handled
            mouse(pointer):
                if pointer.kind == Pointer.wheel:
                    self.model.focus = Focus.files
                    self.model.files.move_by(-pointer.wheel)
                    self.model.adjust_files(area.rows)
                    return Response.handled
                if pointer.kind != Pointer.press or pointer.button != 0:
                    return Response.ignored
                self.model.focus = Focus.files
                let top = Rows.visible_top(
                    self.model.files.top,
                    len(self.model.names),
                    self.model.files.selected,
                    area.rows,
                )
                let index = top + pointer.row - area.row
                if index >= 0 and index < len(self.model.names):
                    self.model.files.selected = index
                    self.model.open_row(index)
                    self.model.focus = Focus.files
                return Response.handled
            else:
                return Response.ignored

    # --- the View contract ------------------------------------------

    func composed() -> View:
        let rows = Rows(
            len(self.model.names),
            self.file_line,
            top = self.model.files.top,
            anchor = self.model.files.selected,
            selected = self.model.files.selected,
            selected_style = palette.selected,
        )
        let listing = CursorHost(
            EventHost(rows, self.file_event),
            self.file_cursor,
        )
        let framed = Panel(
            "files",
            listing,
            style = pane_style(self.model.focus == Focus.files),
            edges = Edges(bottom = false),
        )
        return EventHost(framed, self.frame_event)

    pub func draw(surface: Surface, area: Rect) -> Cursor?:
        return self.composed().draw(surface, area)

    pub func dispatch(event: Event, area: Rect) -> Response:
        return route(self.composed(), event, area)
