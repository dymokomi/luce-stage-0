# The workbench: the one component above the panes.  It owns the
# global keys, the divider drags, and — through its model
# subscription — the retained layout: when a toggle or a drag changes
# what should be visible, the workbench resizes the stacks' slots and
# the next frame draws the new arrangement.

import std.os
from termui import View, Surface, Response, Rect, Event, Cursor, Pointer, route
from termui.layout import VStack, HStack
from termui.constraints import Constraint, Fixed, Ratio, Preferred
from model import Model, Drag, Intent
from ui.keymap import intent_of

func is_global(intent: Intent) -> bool:
    match intent:
        save:
            return true
        build:
            return true
        toggle_files:
            return true
        toggle_output:
            return true
        next_pane:
            return true
        find:
            return true
        undo:
            return true
        redo:
            return true
        escape:
            return true
        quit:
            return true
        else:
            return false

pub class Workbench: View:
    var model: Model
    let across: HStack
    let screen: VStack
    var subscribed: bool

    pub init(shared: Model, across: HStack, screen: VStack):
        self.model = shared
        self.across = across
        self.screen = screen
        self.subscribed = false

    # A component may not capture itself while it is being built, so
    # the subscription lands on first use instead of in init.
    func attach():
        if self.subscribed:
            return
        self.subscribed = true
        let watcher: func() = [weak self] func():
            let live = self
            if live != none:
                live.apply_layout()
        self.model.subscribe(watcher)
        self.apply_layout()

    # The retained tree's shape, derived from the model: a hidden pane
    # is a zero-cell slot, a dragged divider is a preferred size.
    pub func apply_layout():
        var files_size: Constraint = Fixed(0)
        if self.model.file_pane:
            files_size = Ratio(8, 24, 25)
            if self.model.files_width > 0:
                files_size = Preferred(8, self.model.files_width, 240)
        self.across.resize(0, files_size)
        var output_size: Constraint = Fixed(0)
        if self.model.output_pane:
            output_size = Ratio(3, 8, 33)
            if self.model.output_height > 0:
                output_size = Preferred(3, self.model.output_height, 80)
        self.screen.resize(1, output_size)

    pub func draw(surface: Surface, area: Rect) -> Cursor?:
        self.attach()
        return self.screen.draw(surface, area)

    pub func dispatch(event: Event, area: Rect) -> Response:
        self.attach()
        self.model.autosave(os.clock_ms())
        match event:
            idle:
                # The quiet turn: send the buffer if it moved, drain
                # the language server, and let the redraw show what
                # arrived.  Never blocks — the ready poll gates it.
                self.model.pump_lsp()
                return Response.handled
            key(press):
                let intent = intent_of(press)
                if is_global(intent):
                    self.model.key(intent, "", max(area.rows - 1, 0))
                    if self.model.quit:
                        return Response.quit
                    return Response.handled
            mouse(pointer):
                if pointer.kind == Pointer.release and self.model.dragging != Drag.idle:
                    self.model.dragging = Drag.idle
                    return Response.handled
                if pointer.kind == Pointer.drag:
                    if self.model.dragging == Drag.files:
                        self.model.files_width = max(pointer.column - area.column + 1, 0)
                        self.apply_layout()
                        return Response.handled
                    if self.model.dragging == Drag.output:
                        self.model.output_height = max(area.row + area.rows - 1 - pointer.row, 0)
                        self.apply_layout()
                        return Response.handled
            else:
                return route(self.screen, event, area)
        return route(self.screen, event, area)
