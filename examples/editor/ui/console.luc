# The output pane: the retained component that shows build output and
# starts the divider drag on its own top border.

from termui import View, Surface, Response, Rect, Event, Cursor, Line, Edges, Pointer, plain, route
from termui.widgets import Rows, Panel, EventHost, CursorHost
from document import count_lines, line_at, line_end
from model import Model, Drag, Focus, Intent
from ui.keymap import intent_of
from ui.theme import palette, pane_style

class Console: View:
    private model: Model

    init(shared: Model):
        self.model = shared

    # --- data provider ----------------------------------------------

    func output_line(index: i64) -> Line:
        let start = line_at(self.model.output, index)
        let finish = line_end(self.model.output, start)
        return plain(self.model.output[start:finish], palette.plain)

    # --- cursor projection ------------------------------------------

    func output_cursor(area: Rect) -> Cursor?:
        if self.model.focus != Focus.output or area.is_empty():
            return none
        return Cursor(row = area.row, column = area.column)

    # --- events ------------------------------------------------------

    func frame_event(event: Event, area: Rect) -> Response:
        match event:
            mouse(pointer):
                if pointer.kind == Pointer.press and pointer.button == 0 and pointer.row == area.row:
                    self.model.dragging = Drag.output
                    return Response.handled
            else:
                return Response.ignored
        return Response.ignored

    func output_event(event: Event, area: Rect) -> Response:
        match event:
            key(pressed):
                if self.model.focus != Focus.output:
                    return Response.ignored
                let intent = intent_of(pressed)
                if intent == Intent.ignored:
                    return Response.ignored
                self.model.key(intent, "", area.rows)
                return Response.handled
            mouse(pointer):
                if pointer.kind == Pointer.wheel:
                    self.model.focus = Focus.output
                    self.model.output_scroll = max(self.model.output_scroll - pointer.wheel, 0)
                    return Response.handled
                if pointer.kind == Pointer.press and pointer.button == 0:
                    self.model.focus = Focus.output
                    self.model.output_scroll = max(self.model.output_scroll + pointer.row - area.row, 0)
                    return Response.handled
                return Response.ignored
            else:
                return Response.ignored

    # --- the View contract ------------------------------------------

    private func composed() -> View:
        let rows = Rows(
            count_lines(self.model.output),
            self.output_line,
            top = self.model.output_scroll,
        )
        let pane = CursorHost(
            EventHost(rows, self.output_event),
            self.output_cursor,
        )
        let framed = Panel(
            "output",
            pane,
            style = pane_style(self.model.focus == Focus.output),
            edges = Edges(bottom = false),
        )
        return EventHost(framed, self.frame_event)

    func draw(surface: Surface, area: Rect) -> Cursor?:
        return self.composed().draw(surface, area)

    func dispatch(event: Event, area: Rect) -> Response:
        return route(self.composed(), event, area)
