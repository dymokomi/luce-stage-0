# What a keystroke means to the editor, as data.
#
# termui ships no keymap, deliberately: a keymap maps a key to *the
# app's* intent, and no library can name that type.  So the app writes
# the table, and an enum keys a map, so it is written the way it reads.
# The host's key names never reach the editor — termui answers a `Key`, and
# the table below is the whole translation.

from termui import Key, KeyPress
from model import Intent

const INTENTS = {
    Key.left: Intent.move_left,
    Key.right: Intent.move_right,
    Key.up: Intent.move_up,
    Key.down: Intent.move_down,
    Key.page_up: Intent.page_up,
    Key.page_down: Intent.page_down,
    Key.home: Intent.line_start,
    Key.end: Intent.line_end,
    Key.backspace: Intent.erase_left,
    Key.delete: Intent.erase_right,
    Key.enter: Intent.newline,
    Key.tab: Intent.indent,
    Key.ctrl_s: Intent.save,
    Key.ctrl_b: Intent.build,
    Key.ctrl_e: Intent.toggle_files,
    Key.ctrl_o: Intent.toggle_output,
    Key.ctrl_w: Intent.next_pane,
    Key.ctrl_f: Intent.find,
    Key.ctrl_z: Intent.undo,
    Key.ctrl_y: Intent.redo,
    Key.escape: Intent.escape,
    Key.ctrl_q: Intent.quit,
}

# How far a movement intent scrolls a list: one row, or a page of eight.
# A key that moves nothing is not in the table, read as zero.
# What a key means.  A key the editor does not bind is `ignored`.
func intent_of(press: KeyPress) -> Intent:
    let found = INTENTS.get(press.key)
    if found == none:
        return Intent.ignored
    return found

# How far this intent scrolls a list of rows; zero for every intent
# that is not a movement.
