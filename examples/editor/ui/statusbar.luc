# The status line: path, position, messages, the search prompt, and
# the hint strip.  It answers a cursor only while the find bar is open.

import std.strings
from termui import View, Surface, Response, Rect, Event, Cursor
from termui.layout import HStack, ZStack
from termui.constraints import Grow, Preferred
from termui.widgets import Label, Fill, CursorHost
from model import Model, Focus
from ui.theme import palette

private func focus_label(where: Focus) -> str:
    match where:
        editor:
            return "  [editor]"
        files:
            return "  [files]"
        output:
            return "  [output]"
        search:
            return "  [search]"

class StatusBar: View:
    private model: Model

    init(shared: Model):
        self.model = shared

    func status_text() -> str:
        if self.model.focus == Focus.search:
            var prompt = f" find: {self.model.search_query}"
            if len(self.model.search_matches) > 0:
                prompt += f"    {self.model.search_current + 1} of {len(self.model.search_matches)}"
            elif self.model.search_query != "":
                prompt += "    no matches"
            return prompt + "    Enter next   Esc close"
        let doc = self.model.document()
        let line = doc.line_of(doc.cursor)
        let column = doc.column_of(doc.cursor)
        var flag = ""
        if doc.dirty:
            flag = " +"
        var left = f" {doc.path}{flag}  {line + 1}:{column + 1}"
        if len(doc.message) > 0:
            left += f"  — {doc.message}"
        else:
            # With nothing of the editor's own to say, the line under
            # the cursor speaks: the language server's sentence for it.
            let problem = self.model.diagnostic_here()
            if problem != none:
                left += f"  — {problem.message}"
        return left + focus_label(self.model.focus)

    func status_cursor(area: Rect) -> Cursor?:
        if self.model.focus != Focus.search or area.is_empty():
            return none
        return Cursor(
            row = area.row,
            column = min(area.column + 7 + self.model.search_query.width(), area.column + area.columns - 1),
        )

    # --- the View contract ------------------------------------------

    private func composed() -> View:
        let line = self.status_text()
        let background = Fill(" ", palette.status)
        if self.model.focus == Focus.search:
            var prompt = ZStack()
            prompt.add(background)
            prompt.add(Label(line, palette.status))
            return CursorHost(prompt, self.status_cursor)
        let hint = "^F find  ^B build  ^W focus  ^S save  ^Z undo  ^Q quit "
        var pieces = HStack()
        pieces.add(Label(line, palette.status), Grow(minimum = line.width()))
        pieces.add(Label(hint, palette.status), Preferred(0, hint.width(), hint.width()))
        var layered = ZStack()
        layered.add(background)
        layered.add(pieces)
        return CursorHost(layered, self.status_cursor)

    func draw(surface: Surface, area: Rect) -> Cursor?:
        return self.composed().draw(surface, area)

    func dispatch(event: Event, area: Rect) -> Response:
        return Response.ignored
