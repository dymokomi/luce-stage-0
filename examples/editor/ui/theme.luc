# The editor's colours.
#
# termui ships no theme, deliberately (docs/TERMUI.md): a library that
# owns the palette owns the app's identity.  A theme is a struct of
# styles the app declares as a constant, and `style_for` is the one map
# from a highlighter token to a colour — the seam between the pure
# classifier and the drawn frame.

from termui import Style
import highlight

struct Theme:
    keyword: Style
    type_name: Style
    builtin: Style
    text: Style
    number: Style
    comment: Style
    plain: Style
    punct: Style
    gutter: Style
    gutter_current: Style
    status: Style
    status_key: Style
    selected: Style
    # The text-selection background; `in_selection` keeps each token's
    # own foreground over it.
    selection: i64
    pane_border: Style
    pane_active: Style
    match_here: Style

const palette = Theme(
    keyword = Style(foreground = 176, bold = true),
    type_name = Style(foreground = 80),
    builtin = Style(foreground = 74),
    text = Style(foreground = 114),
    number = Style(foreground = 215),
    comment = Style(foreground = 244),
    plain = Style(foreground = 252),
    punct = Style(foreground = 249),
    gutter = Style(foreground = 240),
    gutter_current = Style(foreground = 250),
    status = Style(foreground = 252, background = 237),
    status_key = Style(foreground = 214, background = 237, bold = true),
    selected = Style(foreground = 252, background = 237, bold = true),
    selection = 24,
    pane_border = Style(foreground = 238),
    pane_active = Style(foreground = 255, background = 236, bold = true),
    match_here = Style(foreground = 236, background = 179, bold = true),
)

# The colour for a highlighter token.  Every member has an arm and there
# is no `else`, so a new token kind is a compile error here.
func style_for(theme: Theme, kind: highlight.TokenKind) -> Style:
    match kind:
        keyword:
            return theme.keyword
        type_name:
            return theme.type_name
        builtin:
            return theme.builtin
        plain:
            return theme.plain
        comment:
            return theme.comment
        string_literal:
            return theme.text
        number:
            return theme.number
        punct:
            return theme.punct

# A token's style over the selection background: the syntax colour
# stays, the background says "selected".
func in_selection(theme: Theme, style: Style) -> Style:
    return Style(foreground = style.foreground, background = theme.selection, bold = style.bold)

# The pane-border style for a pane that does or does not hold focus.
# Here rather than in each component, because every framed pane asks
# the same question of the same palette.
func pane_style(active: bool) -> Style:
    if active:
        return palette.pane_active
    return palette.pane_border
