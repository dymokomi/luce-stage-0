# The text buffer and the pure arithmetic over it.
#
# Everything here is pure — no host, no terminal, no editing state —
# so it is the core of the editor a test drives directly. A cursor is
# a Unicode-scalar position; how wide a str *draws* is
# `strings.width`, a display question this file never asks.  The
# functions move a cursor between boundaries, find line starts and
# columns, and splice or erase text, each answering a value the caller
# stores.

# The editor's durable per-file state.  A view may switch away from a
# file, but a buffer keeps its text, cursor and scroll so returning to
# it does not lose work that is not on disk yet.  Plain data: it carries
# no container, so the session can hold a list of them and the active
# one's fields can be cached and restored (OWNERSHIP.md S22 forbids
# editing a carrying element through its index).
struct Buffer:
    path: str = ""
    content: str = ""
    message: str = ""
    cursor: i64 = 0
    scroll: i64 = 0
    dirty: bool = false

# --- cursor motion over Unicode scalars ------------------------------

func previous_boundary(value: str, cursor: i64) -> i64:
    if cursor <= 0:
        return 0
    return cursor - 1

func next_boundary(value: str, cursor: i64) -> i64:
    if cursor >= len(value):
        return len(value)
    return cursor + 1

# --- lines and columns -----------------------------------------------

func line_start(value: str, cursor: i64) -> i64:
    var at = cursor
    while at > 0 and value[at - 1] != '\n':
        at = at - 1
    return at

func line_end(value: str, cursor: i64) -> i64:
    var at = cursor
    while at < len(value) and value[at] != '\n':
        at = at + 1
    return at

func line_of(value: str, cursor: i64) -> i64:
    var line = 0
    for at in range(0, cursor):
        if value[at] == '\n':
            line = line + 1
    return line

func count_lines(value: str) -> i64:
    return line_of(value, len(value)) + 1

func column_of(value: str, cursor: i64) -> i64:
    var at = line_start(value, cursor)
    var column = 0
    while at < cursor:
        at = next_boundary(value, at)
        column = column + 1
    return column

# The scalar position where line `wanted` begins.
func line_at(value: str, wanted: i64) -> i64:
    var at = 0
    var line = 0
    while line < wanted and at < len(value):
        if value[at] == '\n':
            line = line + 1
        at = at + 1
    return at

# The scalar position at display `column` in the line beginning at `start`.
func at_column(value: str, start: i64, column: i64) -> i64:
    var at = start
    var current = 0
    let finish = line_end(value, start)
    while at < finish and current < column:
        at = next_boundary(value, at)
        current = current + 1
    return at

# --- indentation policy ----------------------------------------------

# The leading whitespace of the line at the cursor, borrowed from
# `value` and safe to use while the caller decides the next line.
func indentation(value: str, cursor: i64) -> str:
    let start = line_start(value, cursor)
    var at = start
    while at < cursor:
        let code = value[at]
        if code != ' ' and code != '\t':
            break
        at = at + 1
    return value[start:at]

# Whether the code before the cursor opens an indented block.  A small
# lexical scan is enough: comments and quoted strings are not layout,
# but a colon before a trailing comment is.
func opens_block(value: str, cursor: i64) -> bool:
    let start = line_start(value, cursor)
    var at = start
    var quoted = false
    var escaped = false
    var last: char = char(0)
    while at < cursor:
        let code = value[at]
        if quoted:
            if escaped:
                escaped = false
            elif code == '\\':
                escaped = true
            elif code == '"':
                quoted = false
        elif code == '#':
            break
        elif code == '"':
            quoted = true
        elif code != ' ' and code != '\t':
            last = code
        at = at + 1
    return not quoted and last == ':'

# --- editing (str in, str out) ---------------------------------

func splice(value: str, cursor: i64, extra: str) -> str:
    return value[0:cursor] + extra + value[cursor:len(value)]

func erase_before(value: str, cursor: i64) -> str:
    let before = previous_boundary(value, cursor)
    return value[0:before] + value[cursor:len(value)]

func erase_at(value: str, cursor: i64) -> str:
    let after = next_boundary(value, cursor)
    return value[0:cursor] + value[after:len(value)]
