# The text buffer and the pure arithmetic over it.
#
# Everything here is pure — no host, no terminal, no editing state —
# so it is the core of the editor a test drives directly. A cursor is
# a Unicode-scalar position; how wide a str *draws* is
# `strings.width`, a display question this file never asks.  The
# functions move a cursor between boundaries, find line starts and
# columns, and splice or erase text, each answering a value the caller
# stores.

from history import History

# One open file: the text, the editing position, and the undo stack
# that belongs to them.  A Document is a class — a reference the model
# and every pane share — so switching files is switching which
# reference is active, and the park-and-restore dance a value buffer
# forced is simply gone.  The pure str arithmetic below stays free:
# it answers questions about any text (the output pane's transcript
# included), while a Document owns one text and moves it.
pub class Document:
    pub path: str
    pub content: str
    pub message: str
    pub cursor: i64
    pub scroll: i64
    pub dirty: bool
    pub history: History
    # Where a selection began, or `none` when nothing is selected.  The
    # selection is everything between the anchor and the cursor, in
    # whichever order the two sit; extending a selection moves only the
    # cursor, so shift+arrow and a mouse drag are the same gesture.
    pub anchor: i64?

    pub init(
        path: str = "",
        content: str = "",
        message: str = "",
        cursor: i64 = 0,
        scroll: i64 = 0,
        dirty: bool = false,
    ):
        self.path = path
        self.content = content
        self.message = message
        self.cursor = cursor
        self.scroll = scroll
        self.dirty = dirty
        self.history = History()
        self.anchor = none

    # The status line's message.  A setter because the model often
    # says one thing about the active document in passing —
    # `self.document().set_message(...)` — and Luce assigns fields
    # through a binding, not through a call's result.
    pub func set_message(text: str):
        self.message = text

    # --- the selection -------------------------------------------------

    pub func has_selection() -> bool:
        let anchor = self.anchor
        if anchor == none:
            return false
        return anchor != self.cursor

    pub func selection_start() -> i64:
        let anchor = self.anchor
        if anchor == none:
            return self.cursor
        return min(anchor, self.cursor)

    pub func selection_end() -> i64:
        let anchor = self.anchor
        if anchor == none:
            return self.cursor
        return max(anchor, self.cursor)

    pub func selected_text() -> str:
        return self.content[self.selection_start():self.selection_end()]

    pub func select_all():
        self.anchor = 0
        self.cursor = len(self.content)

    pub func drop_selection():
        self.anchor = none

    # Pin the anchor before an extending motion.  The first extension
    # anchors where the cursor stands; later ones keep the anchor and
    # move only the cursor.
    pub func extend():
        if self.anchor == none:
            self.anchor = self.cursor

    # Erase the selected range, landing the cursor where it began.
    pub func erase_selection():
        if not self.has_selection():
            return
        let start = self.selection_start()
        let finish = self.selection_end()
        self.content = self.content[0:start] + self.content[finish:len(self.content)]
        self.cursor = start
        self.anchor = none
        self.dirty = true

    # --- questions about this text -----------------------------------

    pub func line_of(at: i64) -> i64:
        return line_of(self.content, at)

    pub func line_start(at: i64) -> i64:
        return line_start(self.content, at)

    pub func line_end(at: i64) -> i64:
        return line_end(self.content, at)

    pub func line_at(index: i64) -> i64:
        return line_at(self.content, index)

    pub func at_column(start: i64, column: i64) -> i64:
        return at_column(self.content, start, column)

    pub func column_of(at: i64) -> i64:
        return column_of(self.content, at)

    pub func count_lines() -> i64:
        return count_lines(self.content)

    # --- cursor motion ------------------------------------------------

    pub func move_left():
        self.cursor = previous_boundary(self.content, self.cursor)

    pub func move_right():
        self.cursor = next_boundary(self.content, self.cursor)

    pub func to_line_start():
        self.cursor = line_start(self.content, self.cursor)

    pub func to_line_end():
        self.cursor = line_end(self.content, self.cursor)

    # Land on `target_line`, keeping the column the cursor had where
    # the landing line is long enough to offer it.
    pub func vertical(target_line: i64):
        let total = count_lines(self.content)
        let wanted = column_of(self.content, self.cursor)
        let landing = clamp(target_line, 0, total - 1)
        let start = line_at(self.content, landing)
        self.cursor = at_column(self.content, start, wanted)

    pub func to_word_left():
        self.cursor = previous_word(self.content, self.cursor)

    pub func to_word_right():
        self.cursor = next_word(self.content, self.cursor)

    # --- editing ------------------------------------------------------
    #
    # Every edit is selection-aware here, so no caller can splice text
    # while a selection silently survives: typing replaces the
    # selection, and an erase with a selection erases exactly it.

    pub func insert(extra: str):
        self.erase_selection()
        self.content = splice(self.content, self.cursor, extra)
        self.cursor = self.cursor + len(extra)
        self.dirty = true

    # Open a new line, carrying the current line's indentation and one
    # more unit after a code colon.
    pub func break_line(unit: str):
        self.erase_selection()
        let current_indent = indentation(self.content, self.cursor)
        var line_break = "\n" + current_indent
        if opens_block(self.content, self.cursor):
            line_break = line_break + unit
        self.content = splice(self.content, self.cursor, line_break)
        self.cursor = self.cursor + len(line_break)
        self.dirty = true

    # Erase the character before the cursor.  **The cursor moves by
    # the content as it was before the erase** (docs/SELF.md): after
    # the erase, the byte at the old cursor's left belongs to what
    # followed, and measuring against it lands wrong in exactly one
    # multi-byte shape the differential suite pins.
    pub func erase_left():
        if self.has_selection():
            self.erase_selection()
            return
        if self.cursor <= 0:
            return
        let before = self.content
        self.content = erase_before(self.content, self.cursor)
        self.cursor = previous_boundary(before, self.cursor)
        self.dirty = true

    pub func erase_right():
        if self.has_selection():
            self.erase_selection()
            return
        if self.cursor >= len(self.content):
            return
        self.content = erase_at(self.content, self.cursor)
        self.dirty = true

    # Erase from the previous word boundary to the cursor — one word,
    # or the separators behind the cursor when it sits between words.
    pub func erase_word_left():
        if self.has_selection():
            self.erase_selection()
            return
        let start = previous_word(self.content, self.cursor)
        if start >= self.cursor:
            return
        self.content = self.content[0:start] + self.content[self.cursor:len(self.content)]
        self.cursor = start
        self.dirty = true

# --- cursor motion over Unicode scalars ------------------------------

pub func previous_boundary(value: str, cursor: i64) -> i64:
    if cursor <= 0:
        return 0
    return cursor - 1

pub func next_boundary(value: str, cursor: i64) -> i64:
    if cursor >= len(value):
        return len(value)
    return cursor + 1

# --- words -----------------------------------------------------------

# A word scalar the way the highlighter counts one: letters, digits,
# underscore, and everything beyond ASCII.
pub func is_word_scalar(code: char) -> bool:
    if code >= '0' and code <= '9':
        return true
    if code >= 'A' and code <= 'Z':
        return true
    if code >= 'a' and code <= 'z':
        return true
    return code == '_' or u32(code) >= 128

# The start of the word behind `at`: separators first, then the word
# they end.  Behind the first word this is position zero.
pub func previous_word(value: str, at: i64) -> i64:
    var here = at
    while here > 0 and not is_word_scalar(value[here - 1]):
        here = here - 1
    while here > 0 and is_word_scalar(value[here - 1]):
        here = here - 1
    return here

# The end of the word ahead of `at`, skipping separators to reach it.
pub func next_word(value: str, at: i64) -> i64:
    var here = at
    let finish = len(value)
    while here < finish and not is_word_scalar(value[here]):
        here = here + 1
    while here < finish and is_word_scalar(value[here]):
        here = here + 1
    return here

# --- lines and columns -----------------------------------------------

pub func line_start(value: str, cursor: i64) -> i64:
    var at = cursor
    while at > 0 and value[at - 1] != '\n':
        at = at - 1
    return at

pub func line_end(value: str, cursor: i64) -> i64:
    var at = cursor
    while at < len(value) and value[at] != '\n':
        at = at + 1
    return at

pub func line_of(value: str, cursor: i64) -> i64:
    var line = 0
    for at in range(0, cursor):
        if value[at] == '\n':
            line = line + 1
    return line

pub func count_lines(value: str) -> i64:
    return line_of(value, len(value)) + 1

pub func column_of(value: str, cursor: i64) -> i64:
    var at = line_start(value, cursor)
    var column = 0
    while at < cursor:
        at = next_boundary(value, at)
        column = column + 1
    return column

# The scalar position where line `wanted` begins.
pub func line_at(value: str, wanted: i64) -> i64:
    var at = 0
    var line = 0
    while line < wanted and at < len(value):
        if value[at] == '\n':
            line = line + 1
        at = at + 1
    return at

# The scalar position at display `column` in the line beginning at `start`.
pub func at_column(value: str, start: i64, column: i64) -> i64:
    var at = start
    var current = 0
    let finish = line_end(value, start)
    while at < finish and current < column:
        at = next_boundary(value, at)
        current = current + 1
    return at

# --- indentation policy ----------------------------------------------

# The leading whitespace of the line at the cursor, borrowed from
# `value` and safe to use while the caller decides the next line.
pub func indentation(value: str, cursor: i64) -> str:
    let start = line_start(value, cursor)
    var at = start
    while at < cursor:
        let code = value[at]
        if code != ' ' and code != '\t':
            break
        at = at + 1
    return value[start:at]

# Whether the code before the cursor opens an indented block.  A small
# lexical scan is enough: comments and quoted strings are not layout,
# but a colon before a trailing comment is.
pub func opens_block(value: str, cursor: i64) -> bool:
    let start = line_start(value, cursor)
    var at = start
    var quoted = false
    var escaped = false
    var last: char = char(0)
    while at < cursor:
        let code = value[at]
        if quoted:
            if escaped:
                escaped = false
            elif code == '\\':
                escaped = true
            elif code == '"':
                quoted = false
        elif code == '#':
            break
        elif code == '"':
            quoted = true
        elif code != ' ' and code != '\t':
            last = code
        at = at + 1
    return not quoted and last == ':'

# --- editing (str in, str out) ---------------------------------

pub func splice(value: str, cursor: i64, extra: str) -> str:
    return value[0:cursor] + extra + value[cursor:len(value)]

pub func erase_before(value: str, cursor: i64) -> str:
    let before = previous_boundary(value, cursor)
    return value[0:before] + value[cursor:len(value)]

pub func erase_at(value: str, cursor: i64) -> str:
    let after = next_boundary(value, cursor)
    return value[0:cursor] + value[after:len(value)]
