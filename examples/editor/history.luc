# Undo and redo — a bounded revision stack with identity.
#
# A revision is the minimum that restores a valid prior state: the
# content and where the cursor was.  A `History` is a class because a
# stack is an accumulator with identity — every holder must see the
# one stack, not a silently shared copy — and each Document owns its
# own.  The coalescing rule that decides when to `record` lives in the
# editor, which knows the sequence of keys.

pub struct Revision:
    pub let content: str
    pub let cursor: i64

# Keep undo bounded so a long session over a large file does not grow
# without limit; the oldest revision is the first to go.
pub const depth = 200

pub class History:
    let past: list[Revision]
    let future: list[Revision]

    pub init():
        self.past = list[Revision]()
        self.future = list[Revision]()

    # Record the state *before* an edit.  A new edit invalidates redo,
    # so the future stack is cleared.  Call this once per undo group —
    # the editor coalesces a run of plain insertions into one group.
    pub func record(content: str, cursor: i64):
        self.past.append(Revision(content = content, cursor = cursor))
        self.future.clear()
        while len(self.past) > depth:
            self.past.remove(0)

    # Undo: move the current state onto the redo stack and answer the
    # prior revision to apply, or `none` when there is nothing to undo.
    pub func undo(content: str, cursor: i64) -> Revision?:
        if len(self.past) == 0:
            return none
        self.future.append(Revision(content = content, cursor = cursor))
        return self.past.pop()

    # Redo: the mirror of undo.
    pub func redo(content: str, cursor: i64) -> Revision?:
        if len(self.future) == 0:
            return none
        self.past.append(Revision(content = content, cursor = cursor))
        return self.future.pop()
