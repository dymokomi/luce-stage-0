# The editor's model: what a buffer parks, what a keystroke means, and
# where each pane sits.
#
# Everything here is pure — no host effects, no terminal, no editing —
# so it is the half of the editor a test can drive directly
# (`tests/`, docs/TESTING.md).  The root editor owns the effects and
# the text; this module owns the arithmetic and the tables.

import termui
import termui.events

# The editor's durable per-file state.
#
# The terminal view may switch away from a file, but a buffer keeps its
# text, cursor and scroll position so returning to it does not lose the
# work that is not on disk yet.
struct Buffer:
    path: string
    content: string
    message: string = ""
    cursor: long = 0
    scroll: long = 0
    dirty: bool = false

# Which pane the keyboard is talking to.
enum Focus:
    editor
    files
    output

# What a keystroke means to the editor.
#
# **The wart this deletes.**  `State.key` used to take the host's key
# *name* and dispatch on it with fifteen string comparisons in one
# `elif` chain with no final `else`: a misspelled `"page_dwon"`
# compiled and silently did nothing, and exhaustiveness is exactly the
# property a chain of comparisons cannot state (docs/ENUMS.md).  Then
# the translation itself was fifty lines of `if name == "…"`.  Now the
# host's key names never reach the editor at all: `termui.events`
# answers a `Key`, and the table below is the whole translation.
enum Intent:
    move_left
    move_right
    move_up
    move_down
    page_up
    page_down
    line_start
    line_end
    erase_left
    erase_right
    newline
    indent
    # `insert_text` rather than `insert`: `insert` is a list method,
    # and the language reserves the method names for the receivers
    # that answer to them (`luce.sema.reserved`).
    insert_text
    save
    build
    toggle_files
    toggle_output
    next_pane
    escape
    quit
    # Every other key the terminal can send — a control the editor has
    # no use for.  It is a member, so the `match` that handles it has
    # to say so out loud.
    ignored

# The keymap, as data (docs/TERMUI.md D10).
#
# termui ships no keymap, deliberately: a keymap maps a key to *the
# app's* intent, and no library can name that type.  So the app writes
# the table, and an enum keys a map, so it is written the way it reads.
const INTENTS = {
    events.Key.left: Intent.move_left,
    events.Key.right: Intent.move_right,
    events.Key.up: Intent.move_up,
    events.Key.down: Intent.move_down,
    events.Key.page_up: Intent.page_up,
    events.Key.page_down: Intent.page_down,
    events.Key.home: Intent.line_start,
    events.Key.end: Intent.line_end,
    events.Key.backspace: Intent.erase_left,
    events.Key.delete: Intent.erase_right,
    events.Key.enter: Intent.newline,
    events.Key.tab: Intent.indent,
    events.Key.ctrl_s: Intent.save,
    events.Key.ctrl_b: Intent.build,
    events.Key.ctrl_e: Intent.toggle_files,
    events.Key.ctrl_o: Intent.toggle_output,
    events.Key.ctrl_w: Intent.next_pane,
    events.Key.escape: Intent.escape,
    events.Key.ctrl_q: Intent.quit,
}

# How far a movement intent moves a list: one row, or a page of eight.
# A key that moves nothing is not in the table, and the editor reads
# that as zero.
const STEPS = {
    Intent.move_up: -1,
    Intent.move_down: 1,
    Intent.page_up: -8,
    Intent.page_down: 8,
}

# What a key means.  A key the editor does not bind is `ignored` —
# named, not fallen through.
func intent_of(pressed: events.Key) -> Intent:
    let found = INTENTS.get(pressed)
    if found == none:
        return Intent.ignored
    return found

# How far this intent scrolls a list of rows; zero for every intent
# that is not a movement.
func steps_of(intent: Intent) -> long:
    let steps = STEPS.get(intent)
    if steps == none:
        return 0
    return steps

# Where each pane sits this frame.
#
# The splits are termui's arithmetic and the clamps are the editor's
# policy (docs/TERMUI.md D4): the file pane is a quarter of the width
# between 18 and 24 columns, the output pane a third of the height
# between 3 and 8 rows, and both give way before the text does.  A
# hidden pane is the empty rectangle rather than a flag, because every
# rectangle operation is total and an empty one draws nothing.
struct Layout:
    # Line numbers and source, the panes taken out.
    text: termui.Rect
    # The file pane, its border columns included.
    files: termui.Rect
    # The output pane, its top border row included.
    output: termui.Rect
    status: termui.Rect
    # The line-number column, inside `text`.
    gutter: long = 5

    static func of(area: termui.Rect, files_shown: bool, output_shown: bool) -> Layout:
        var status, body = area.split_bottom(1)
        var text = body
        var output = termui.Rect()
        if output_shown:
            var height = clamp(long(area.rows / 3), 3, 8)
            height = min(height, max(area.rows - 2, 0))
            output, text = text.split_bottom(height)
        var files = termui.Rect()
        if files_shown:
            var width = clamp(long(area.columns / 4), 18, 24)
            # The pane gives way rather than the text: one column for
            # the shared rule and the gutter's five have to stay.
            if width + 1 + 5 >= area.columns:
                width = max(area.columns - 1 - 5, 1)
            files, text = text.split_left(width + 1)
        return Layout(text = text, files = files, output = output, status = status)

    # The source text, with the line numbers taken off the left.
    func source() -> termui.Rect:
        let numbers, rest = self.text.split_left(self.gutter)
        return rest

    # The screen column the source starts at, which is what a mouse
    # click has to be measured from.
    func text_start() -> long:
        return self.text.column + self.gutter

    # The column the file pane's rule stands in, or 0 when it is
    # hidden — the junction the output pane's top edge has to meet.
    func split_column() -> long:
        if self.files.is_empty():
            return 0
        return self.files.columns - 1

    # Which pane a click landed in, or `none` for the status bar.
    #
    # The order is the one the editor has always used: the file pane
    # owns its columns for the whole height of the frame, and the
    # output pane owns the rows below the text.
    func pane_at(row: long, column: long) -> Focus?:
        if row < 0 or row >= self.status.row:
            return none
        if not self.files.is_empty() and column >= 0 and column < self.files.columns - 1:
            return Focus.files
        if not self.output.is_empty() and row >= self.output.row:
            return Focus.output
        return Focus.editor
