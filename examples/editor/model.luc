# The editor's state, and the operations that change it.
#
# This is the coordinator.  It necessarily owns the mutable editing
# state — content, cursor, scroll — because Luce mutates scalar state
# only through a method's `self` (a free function cannot, docs/
# OWNERSHIP.md).  What it does *not* own is logic: text arithmetic is
# `document`, undo is `history`, search is `search`, file listing is
# `browser`, build is `shell`, drafts are `session`.  Each method here
# is thin — it calls one of those and stores the answer.
#
# The open files are Documents — classes, so the model and every pane
# share the one reference `document()` answers, switching files is
# switching the active index, and each Document carries its own text,
# cursor, scroll, and undo History.

import std.files
from document import Document, count_lines, previous_boundary
import search
import browser
import shell
import session
from keymap import Intent, steps_of
from focus import Focus

# Luce's lexer steps four columns; the editor writes spaces so what it
# makes is immediately valid source.
const indent_unit = "    "

# The file pane's ordinary domain state. Geometry belongs to the declarative
# view; this value only remembers which result is selected and where its
# visible window begins.
class Selection:
    count: i64
    top: i64
    selected: i64

    init():
        self.count = 0
        self.top = 0
        self.selected = 0

    func adjust(height: i64):
        if self.count <= 0:
            self.top = 0
            self.selected = 0
            return
        self.selected = clamp(self.selected, 0, self.count - 1)
        if self.selected < self.top:
            self.top = self.selected
        if height > 0 and self.selected >= self.top + height:
            self.top = self.selected - height + 1
        self.top = clamp(self.top, 0, max(self.count - 1, 0))

    func move_by(steps: i64):
        self.selected = clamp(self.selected + steps, 0, max(self.count - 1, 0))

# Which divider a pointer is dragging.  Model state rather than a
# pane's, because the pane that starts a drag (a border press) and the
# component that applies it (the workbench resizing slots) are
# different objects sharing only this model.
enum Drag:
    idle
    files
    output

class Model:
    documents: list[Document]
    names: list[str]
    search_matches: list[i64]
    files: Selection
    directory: str = "."
    output: str = ""
    search_query: str = ""
    active: i64 = 0
    output_scroll: i64 = 0
    search_current: i64 = -1
    last_draft_ms: i64 = 0
    file_pane: bool = false
    output_pane: bool = false
    quit_pending: bool = false
    coalescing: bool = false
    quit: bool = false
    focus: Focus = Focus.editor
    dragging: Drag = Drag.idle
    files_width: i64 = 0
    output_height: i64 = 0
    private watchers: list[(func())?]

    init(documents: list[Document]):
        self.documents = documents
        self.names = list[str]()
        self.search_matches = list[i64]()
        self.files = Selection()
        self.watchers = list[(func())?]()

    # The active file.  A Document is a reference, so panes and model
    # read and mutate the same one; switching files is switching which
    # reference this answers.
    func document() -> Document:
        return self.documents[self.active]

    # --- subscriptions ------------------------------------------------

    # A component subscribes with a `[weak self]` closure — the model
    # must never own its watchers, because they own the model — and is
    # told after every compound change: a routed keystroke, an opened
    # row, a finished build.  Watchers update their own derived state;
    # the frame that follows reads the result.
    func subscribe(watcher: func()):
        self.watchers.append(watcher)

    private func notify():
        for held in self.watchers:
            let watcher = held
            if watcher != none:
                watcher()

    # --- switching between files ---------------------------------------

    # What every switch resets: a Document keeps its own text, cursor
    # and scroll (it is the same reference it always was), and the
    # model's cross-file state starts fresh — the autosave debounce is
    # per working file, so the next edit to the file just entered
    # writes its own draft without waiting on the one before it.
    private func switched():
        self.quit_pending = false
        self.coalescing = false
        self.last_draft_ms = 0

    # The provider the file pane reads its labels through.
    func name_at(index: i64) -> str:
        if index < 0 or index >= len(self.names):
            return ""
        return self.names[index]

    # --- the file pane -----------------------------------------------

    func refresh_files():
        let doc = self.document()
        let failure = browser.refresh(self.names, self.directory, doc.path)
        if failure != none:
            doc.message = failure
            return
        self.files.count = len(self.names)
        self.files.selected = browser.select_index(self.names, self.directory, doc.path)

    # Keep the file pane's scroll window on its selection.  `files` is
    # a class, so the frame and a mouse click read the same window this
    # writes — no copy-out, no copy-back.
    func adjust_files(height: i64):
        self.files.count = len(self.names)
        self.files.adjust(height)

    func open_row(index: i64):
        if index < 0 or index >= len(self.names):
            return
        match browser.classify(self.names[index], self.directory):
            entered(directory):
                self.directory = directory
                self.refresh_files()
                self.document().set_message("in " + self.directory)
            file(path):
                self.open_file(path)
        self.notify()

    func open_file(path: str):
        if path == self.document().path:
            self.focus = Focus.editor
            return
        for other in range(0, len(self.documents)):
            if self.documents[other].path == path:
                self.active = other
                self.switched()
                self.focus = Focus.editor
                return
        # `session.load` rather than a bare read, so a file opened from
        # the pane recovers a draft exactly as one named on the command
        # line does; a recovered draft seeds undo with the on-disk file
        # so Ctrl-Z discards the recovery.
        let loaded = session.load(path)
        if loaded.recovered:
            loaded.opened.history.record(loaded.base, 0)
        self.documents.append(loaded.opened)
        self.active = len(self.documents) - 1
        self.switched()
        self.focus = Focus.editor

    # --- undo and redo -----------------------------------------------

    # Record the state before an edit.  A run of plain insertions is one
    # undo group: the first records, the rest coalesce.  Any other edit
    # records and breaks the run.
    func begin_edit(coalesce: bool):
        if coalesce and self.coalescing:
            return
        let doc = self.document()
        doc.history.record(doc.content, doc.cursor)
        self.coalescing = coalesce

    func undo():
        let doc = self.document()
        let prior = doc.history.undo(doc.content, doc.cursor)
        if prior == none:
            doc.message = "nothing to undo"
            return
        doc.content = prior.content
        doc.cursor = prior.cursor
        doc.dirty = true
        self.coalescing = false

    func redo():
        let doc = self.document()
        let ahead = doc.history.redo(doc.content, doc.cursor)
        if ahead == none:
            doc.message = "nothing to redo"
            return
        doc.content = ahead.content
        doc.cursor = ahead.cursor
        doc.dirty = true
        self.coalescing = false

    # --- search ------------------------------------------------------

    func open_search():
        self.focus = Focus.search
        self.search_query = ""
        self.search_matches.clear()
        self.search_current = -1
        self.document().set_message("")
        # A search jumps the cursor, so the next typed run is its own undo
        # group rather than coalescing with text typed before the search.
        self.coalescing = false

    func close_search():
        self.focus = Focus.editor
        self.document().set_message("")
        self.coalescing = false

    func rescan():
        let doc = self.document()
        search.scan(self.search_matches, doc.content, self.search_query)
        if len(self.search_matches) > 0:
            self.search_current = 0
            doc.cursor = self.search_matches[0]
        else:
            self.search_current = -1

    func jump_match(direction: i64):
        let next = search.step(len(self.search_matches), self.search_current, direction)
        if next < 0:
            return
        self.search_current = next
        let doc = self.document()
        doc.cursor = self.search_matches[next]

    func search_key(intent: Intent, inserted: str):
        if intent == Intent.escape:
            self.close_search()
        elif intent == Intent.newline or intent == Intent.move_down or intent == Intent.move_right:
            self.jump_match(1)
        elif intent == Intent.move_up or intent == Intent.move_left:
            self.jump_match(-1)
        elif intent == Intent.erase_left:
            if len(self.search_query) > 0:
                let back = previous_boundary(self.search_query, len(self.search_query))
                self.search_query = self.search_query[0:back]
                self.rescan()
        elif intent == Intent.insert_text:
            self.search_query = self.search_query + inserted
            self.rescan()

    # --- the other panes ---------------------------------------------

    func file_key(intent: Intent):
        if len(self.names) == 0:
            return
        if intent == Intent.newline:
            self.open_row(self.files.selected)
            return
        if intent == Intent.move_left or intent == Intent.escape:
            self.focus = Focus.editor
            return
        let steps = steps_of(intent)
        if steps == 0:
            return
        self.files.count = len(self.names)
        self.files.move_by(steps)

    func output_key(intent: Intent):
        let steps = steps_of(intent)
        if steps == 0:
            return
        let total = count_lines(self.output)
        self.output_scroll = clamp(self.output_scroll + steps, 0, max(total - 1, 0))

    func toggle_files():
        self.file_pane = not self.file_pane
        if self.file_pane:
            self.refresh_files()
        elif self.focus == Focus.files:
            self.focus = Focus.editor

    func toggle_output():
        self.output_pane = not self.output_pane
        if self.output_pane:
            self.focus = Focus.output
        elif self.focus == Focus.output:
            self.focus = Focus.editor

    func next_pane():
        if self.focus == Focus.editor:
            if self.file_pane:
                self.focus = Focus.files
            elif self.output_pane:
                self.focus = Focus.output
        elif self.focus == Focus.files:
            if self.output_pane:
                self.focus = Focus.output
            else:
                self.focus = Focus.editor
        else:
            if self.file_pane:
                self.focus = Focus.files
            else:
                self.focus = Focus.editor

    # --- build and save ----------------------------------------------

    func build():
        self.save()
        let doc = self.document()
        if doc.dirty:
            self.output = "build skipped: " + doc.message + "\n"
        else:
            self.output = shell.run(shell.build_command(doc.path))
            doc.message = "build/run finished"
        self.output_scroll = 0
        self.output_pane = true
        self.focus = Focus.output

    func save():
        let doc = self.document()
        files.write(doc.path, doc.content) catch reason:
            doc.message = reason
            return
        doc.dirty = false
        doc.message = f"saved {doc.path}"
        session.discard_draft(doc.path)
        # A save closes the current undo group, so edits after it start a
        # fresh one rather than coalescing across the saved boundary.
        self.coalescing = false

    # Write a draft when the file has been dirty past a short idle, so
    # a crash loses at most a second or two of edits.
    func autosave(now: i64):
        let doc = self.document()
        if not doc.dirty:
            return
        if now - self.last_draft_ms < 1500:
            return
        self.last_draft_ms = now
        session.save_draft(doc.path, doc.content)

    # --- the keystroke router ----------------------------------------

    func key(intent: Intent, inserted: str, visible: i64):
        self.routed(intent, inserted, visible)
        self.notify()

    private func routed(intent: Intent, inserted: str, visible: i64):
        if intent == Intent.quit:
            let doc = self.document()
            if doc.dirty and not self.quit_pending:
                self.quit_pending = true
                doc.message = "unsaved changes; Ctrl-Q again to discard"
            else:
                self.quit = true
            return
        if intent == Intent.save:
            self.save()
            return
        if intent == Intent.build:
            self.build()
            return
        if intent == Intent.toggle_files:
            self.toggle_files()
            return
        if intent == Intent.toggle_output:
            self.toggle_output()
            return
        if intent == Intent.next_pane:
            self.next_pane()
            return
        if intent == Intent.find:
            self.open_search()
            return
        if intent == Intent.undo:
            self.undo()
            return
        if intent == Intent.redo:
            self.redo()
            return
        if intent == Intent.escape:
            # Escape always returns to the text; in search it closes the
            # find bar first.  Handled before pane dispatch so a pane that
            # ignores movement still gives focus back (an earlier version
            # let Escape fall into the output pane, which dropped it).
            if self.focus == Focus.search:
                self.close_search()
            else:
                self.focus = Focus.editor
            return
        if self.focus == Focus.search:
            self.search_key(intent, inserted)
            return
        if self.focus == Focus.files:
            self.file_key(intent)
            return
        if self.focus == Focus.output:
            self.output_key(intent)
            return
        self.edit(intent, inserted, visible)

    # The editor pane's own keys.  Movement breaks an insert run; each
    # text change records undo first.  The undo-grouping policy stays
    # here — the model knows the sequence of keys — and the Document
    # owns the text arithmetic each arm asks for.
    func edit(intent: Intent, inserted: str, visible: i64):
        let doc = self.document()
        let line = doc.line_of(doc.cursor)
        self.quit_pending = false
        if len(doc.message) > 0:
            doc.message = ""
        match intent:
            move_left:
                doc.move_left()
                self.coalescing = false
            move_right:
                doc.move_right()
                self.coalescing = false
            move_up:
                doc.vertical(line - 1)
                self.coalescing = false
            move_down:
                doc.vertical(line + 1)
                self.coalescing = false
            page_up:
                doc.vertical(line - visible)
                self.coalescing = false
            page_down:
                doc.vertical(line + visible)
                self.coalescing = false
            line_start:
                doc.to_line_start()
                self.coalescing = false
            line_end:
                doc.to_line_end()
                self.coalescing = false
            erase_left:
                if doc.cursor > 0:
                    self.begin_edit(false)
                    doc.erase_left()
            erase_right:
                if doc.cursor < len(doc.content):
                    self.begin_edit(false)
                    doc.erase_right()
            newline:
                self.begin_edit(false)
                doc.break_line(indent_unit)
            indent:
                self.begin_edit(false)
                doc.insert(indent_unit)
            insert_text:
                self.begin_edit(true)
                doc.insert(inserted)
            save:
                return
            build:
                return
            toggle_files:
                return
            toggle_output:
                return
            next_pane:
                return
            find:
                return
            undo:
                return
            redo:
                return
            escape:
                self.focus = Focus.editor
            quit:
                return
            ignored:
                return

# Build a model from command-line paths.  File and draft loading
# belongs at this boundary; the components receive the finished model.
func open(paths: list[str]) -> Model:
    var documents = list[Document]()
    for path in paths:
        let loaded = session.load(path)
        if loaded.recovered:
            loaded.opened.history.record(loaded.base, 0)
        documents.append(loaded.opened)
    return Model(documents)
