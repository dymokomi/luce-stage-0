# The buffer arithmetic is pure: boundaries, lines, columns, edits.

import document

func test_boundaries_step_over_multibyte_characters():
    # "héllo" has five scalar positions; moving once crosses é no
    # matter how many bytes encode it.
    let value = "héllo"
    assert(document.next_boundary(value, 1) == 2)
    assert(document.previous_boundary(value, 2) == 1)
    assert(document.next_boundary(value, len(value)) == len(value))
    assert(document.previous_boundary(value, 0) == 0)

func test_lines_and_columns():
    let value = "ab\ncde\nf"
    assert(document.count_lines(value) == 3)
    assert(document.line_of(value, 0) == 0)
    assert(document.line_of(value, 4) == 1)
    assert(document.line_start(value, 5) == 3)
    assert(document.line_end(value, 3) == 6)
    assert(document.column_of(value, 5) == 2)

func test_line_at_and_at_column():
    let value = "ab\ncde\nf"
    assert(document.line_at(value, 1) == 3)
    let start = document.line_at(value, 1)
    # Column 2 of "cde" is the 'e' at scalar position 5.
    assert(document.at_column(value, start, 2) == 5)
    # A column past the line's end clamps to the line end.
    assert(document.at_column(value, start, 99) == 6)

func test_splice_and_erase():
    assert(document.splice("world", 0, "hello ") == "hello world")
    assert(document.erase_before("abc", 2) == "ac")
    assert(document.erase_at("abc", 1) == "ac")

func test_indentation_is_the_leading_whitespace():
    let value = "    x = 1"
    assert(document.indentation(value, len(value)) == "    ")
    assert(document.indentation("no indent", 3) == "")

func test_opens_block_sees_a_trailing_colon():
    assert(document.opens_block("if x:", 5))
    assert(document.opens_block("if x:  # note", 13))
    assert(not document.opens_block("x = 1", 5))
    # A colon inside a str is not layout.
    assert(not document.opens_block("s = \":\"", 7))
