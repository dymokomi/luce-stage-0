# The editor's complete retained screen, rendered without a terminal.

import std.strings
import termui
from termui import Rect, Event, Cursor, Key, KeyPress, Mouse, Pointer, Response, snapshot
from termui.layout import VStack, HStack
from termui.constraints import Fixed, Grow
from document import Document
import model
from model import Model, Drag, Focus
from ui.filelist import FileList
from ui.source import Editor
from ui.console import Console
from ui.statusbar import StatusBar
from ui.workbench import Workbench

pub func model_of() -> Model:
    var documents = list[Document]()
    documents.append(Document(
        path = "sample.luc",
        content = "func main():\n    let x = 42",
    ))
    let shared = Model(documents)
    shared.names = ["a.luc", "b.luc"]
    shared.files.count = len(shared.names)
    shared.output = "build ok"
    return shared

# The entry's composition, handed back with the parts a test drives.
pub func built(shared: Model) -> (Workbench, Editor, FileList):
    var across = HStack()
    let files = FileList(shared)
    let pane = Editor(shared)
    across.add(files, Fixed(0))
    across.add(pane, Grow(minimum = Editor.minimum_columns()))
    var screen = VStack()
    screen.add(across, Grow(minimum = 1))
    screen.add(Console(shared), Fixed(0))
    screen.add(StatusBar(shared), Fixed(1))
    return Workbench(shared, across, screen), pane, files

pub func test_the_retained_tree_describes_source_status_and_cursor():
    let bench, pane, files = built(model_of())
    let screen = snapshot(bench, 12, 60)
    assert(strings.contains(screen.line(0), "1 func main():"))
    assert(strings.contains(screen.line(1), "2     let x = 42"))
    assert(strings.contains(screen.line(11), "sample.luc"))
    assert(strings.contains(screen.line(11), "[editor]"))
    let cursor = screen.cursor else Cursor()
    assert(cursor.row == 0)
    assert(cursor.column == 5)

pub func test_hidden_panes_are_zero_slots_the_subscription_reopens():
    let shared = model_of()
    let bench, pane, files = built(shared)
    shared.file_pane = true
    shared.output_pane = true
    let screen = snapshot(bench, 18, 78)
    assert(strings.contains(screen.line(0), "files"))
    assert(strings.contains(screen.line(0), "func main():"))
    assert(strings.contains(screen.line(12), "output"))
    assert(strings.contains(screen.line(13), "build ok"))
    assert(strings.contains(screen.line(17), "sample.luc"))

pub func test_source_events_update_the_model_and_the_next_frame():
    let shared = model_of()
    let bench, pane, files = built(shared)
    let doc = shared.document()
    doc.cursor = len(doc.content)
    let response = pane.source_event(
        Event.text(typed = "!"),
        Rect(rows = 10, columns = 60),
    )
    assert(response == Response.handled)
    assert(strings.ends_with(shared.document().content, "!"))
    let screen = snapshot(bench, 12, 60)
    assert(strings.contains(screen.line(1), "let x = 42!"))

pub func test_global_commands_and_search_are_reflected_in_the_frame():
    let shared = model_of()
    let bench, pane, files = built(shared)
    assert(bench.dispatch(
        Event.key(press = KeyPress(key = Key.ctrl_f)),
        Rect(rows = 12, columns = 60),
    ) == Response.handled)
    assert(shared.focus == Focus.search)
    pane.source_event(
        Event.text(typed = "let"),
        Rect(rows = 11, columns = 60),
    )
    let screen = snapshot(bench, 12, 60)
    assert(strings.contains(screen.line(11), "find: let"))
    assert(strings.contains(screen.line(11), "1 of 1"))

pub func test_divider_drag_crosses_panes_through_the_model():
    let shared = model_of()
    let bench, pane, files = built(shared)
    shared.file_pane = true
    let pane_area = Rect(rows = 11, columns = 20)
    assert(files.frame_event(
        Event.mouse(pointer = Mouse(
            kind = Pointer.press,
            row = 3,
            column = 19,
            button = 0,
        )),
        pane_area,
    ) == Response.handled)
    bench.dispatch(
        Event.mouse(pointer = Mouse(kind = Pointer.drag, row = 3, column = 13)),
        Rect(rows = 12, columns = 60),
    )
    assert(shared.files_width == 14)
    bench.dispatch(
        Event.mouse(pointer = Mouse(kind = Pointer.release, row = 3, column = 13)),
        Rect(rows = 12, columns = 60),
    )
    assert(shared.dragging == Drag.idle)
