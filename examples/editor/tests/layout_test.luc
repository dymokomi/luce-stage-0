# Where the panes land, at sizes nobody wants to reach by hand.

import layout as panes
import focus
import termui

func screen_of(rows: i64, columns: i64) -> termui.Rect:
    return termui.Rect(rows = rows, columns = columns)

func test_a_bare_terminal_is_text_and_a_status_bar():
    let view = panes.Layout.of(screen_of(24, 80), false, false)
    assert(view.text.row == 0)
    assert(view.text.rows == 23)
    assert(view.text.columns == 80)
    assert(view.status.row == 23)
    assert(view.status.rows == 1)
    assert(view.files.is_empty())
    assert(view.output.is_empty())
    assert(view.source().column == 5)
    assert(view.source().columns == 75)
    assert(view.text_start() == 5)
    assert(view.split_column() == 0)

func test_the_file_pane_is_a_quarter_of_the_width_between_18_and_24():
    let wide = panes.Layout.of(screen_of(24, 200), true, false)
    assert(wide.files.columns == 25)
    let ordinary = panes.Layout.of(screen_of(24, 80), true, false)
    assert(ordinary.files.columns == 21)
    assert(ordinary.text.column == 21)
    assert(ordinary.text_start() == 26)
    assert(ordinary.split_column() == 20)
    let narrow = panes.Layout.of(screen_of(24, 60), true, false)
    assert(narrow.files.columns == 19)

func test_the_file_pane_gives_way_before_the_text_does():
    let cramped = panes.Layout.of(screen_of(24, 20), true, false)
    assert(cramped.files.columns == 15)
    assert(cramped.text.columns == 5)
    assert(cramped.text.column == 15)

func test_the_output_pane_is_a_third_of_the_height_between_3_and_8():
    let tall = panes.Layout.of(screen_of(48, 80), false, true)
    assert(tall.output.rows == 8)
    assert(tall.output.row == 39)
    assert(tall.text.rows == 39)
    let ordinary = panes.Layout.of(screen_of(24, 80), false, true)
    assert(ordinary.output.rows == 8)
    assert(ordinary.text.rows == 15)
    let compact = panes.Layout.of(screen_of(9, 80), false, true)
    assert(compact.output.rows == 3)
    assert(compact.text.rows == 5)

func test_a_window_too_small_for_a_pane_is_a_resize_and_not_a_bug():
    let tiny = panes.Layout.of(screen_of(2, 40), true, true)
    assert(tiny.text.rows == 1)
    assert(tiny.output.is_empty())
    assert(tiny.status.rows == 1)
    let sliver = panes.Layout.of(screen_of(1, 1), true, true)
    assert(sliver.status.rows == 1)
    assert(sliver.text.is_empty())

func test_both_panes_share_the_frame():
    let view = panes.Layout.of(screen_of(24, 80), true, true)
    assert(view.files.columns == 21)
    assert(view.output.row == 15)
    assert(view.output.columns == 80)
    assert(view.text.rows == 15)
    assert(view.text.column == 21)
    assert(view.split_column() == 20)

func pane_name(where: focus.Focus?) -> str:
    if where == none:
        return "none"
    match where:
        editor:
            return "editor"
        files:
            return "files"
        output:
            return "output"
        search:
            return "search"

func test_a_click_names_the_pane_it_landed_in():
    let view = panes.Layout.of(screen_of(24, 80), true, true)
    assert(pane_name(view.pane_at(3, 40)) == "editor")
    assert(pane_name(view.pane_at(3, 5)) == "files")
    assert(pane_name(view.pane_at(3, 20)) == "editor")
    assert(pane_name(view.pane_at(18, 40)) == "output")
    assert(pane_name(view.pane_at(23, 10)) == "none")
    assert(pane_name(view.pane_at(-1, 10)) == "none")
