# Search finds every match and steps through them, wrapping at the ends.

import search

func test_scan_finds_every_occurrence():
    var matches = list[i64]()
    search.scan(matches, "the cat sat on the mat", "at")
    # "cat", "sat", "mat" — the 'at' at bytes 5, 9, 20.
    assert(len(matches) == 3)
    assert(matches[0] == 5)
    assert(matches[1] == 9)
    assert(matches[2] == 20)

func test_scan_counts_overlapping_matches():
    var matches = list[i64]()
    search.scan(matches, "aaa", "aa")
    assert(len(matches) == 2)
    assert(matches[0] == 0)
    assert(matches[1] == 1)

func test_an_empty_query_matches_nothing():
    var matches = list[i64]()
    search.scan(matches, "anything", "")
    assert(len(matches) == 0)

func test_no_match_leaves_an_empty_list():
    var matches = list[i64]()
    search.scan(matches, "hello", "zzz")
    assert(len(matches) == 0)

func test_step_wraps_at_both_ends():
    assert(search.step(3, 0, 1) == 1)
    assert(search.step(3, 2, 1) == 0)
    assert(search.step(3, 0, -1) == 2)
    assert(search.step(0, 0, 1) == -1)
