# The whole frame, painted into a surface and read back — the one test
# that proves layout, highlighting and the merged pane frames together,
# without a terminal.  A visual or lifecycle regression cannot hide
# behind a unit test that only checks a helper.

import std.strings
import state
import paint
import layout as panes
import history
import document
import focus
import termui.surface as surface

# Build an editor over fixed content, with both side panes open, and no
# file listing (so the frame geometry does not depend on the directory).
func editor_of() -> state.Editor:
    var buffers = new list(document.Buffer)
    buffers.append(document.Buffer(path = "sample.luc"))
    var histories = new list(history.Stacks)
    histories.append(history.Stacks(past = new list(history.Revision), future = new list(history.Revision)))
    var names = new list(string)
    names.append("a.luc")
    names.append("b.luc")
    return state.Editor(
        buffers = buffers,
        histories = histories,
        names = names,
        search_matches = new list(long),
        path = "sample.luc",
        content = "func main():\n    let x = 42",
        output = "build ok",
        file_pane = true,
        output_pane = true,
    )

func row_text(view: surface.Surface, row: long) -> string:
    var line = new builder()
    for column in range(0, view.columns):
        line.append(view.back[row, column].text)
    return line.build()

func test_a_painted_frame_has_panes_gutter_and_status():
    var ed = editor_of()
    ed.files.count = len(ed.names)
    var view = surface.Surface.of(18, 78)
    let layout = panes.Layout.of(view.area(), true, true)
    paint.frame(ed, view, layout)
    # The file pane's titled top-left corner.
    assert(view.back[0, 0].text == "┌")
    let top = row_text(view, 0)
    assert(strings.contains(top, "files"))
    # The file pane is 20 columns; the gutter numbers the first source
    # line right-aligned in five, and the source follows.
    assert(view.back[0, 23].text == "1")
    assert(view.back[0, 25].text == "f")
    # The second line's number.
    assert(view.back[1, 23].text == "2")

func test_the_pane_frames_merge_at_their_junctions():
    var ed = editor_of()
    var view = surface.Surface.of(18, 78)
    let layout = panes.Layout.of(view.area(), true, true)
    paint.frame(ed, view, layout)
    # The file pane's rule stands in this column; the output pane's top
    # edge meets it as an up-tee, and the left border as a right-tee —
    # neither glyph chosen by the editor.
    let split = layout.split_column()
    assert(view.back[layout.output.row, split].text == "┴")
    assert(view.back[layout.output.row, 0].text == "├")

func test_the_status_bar_shows_the_path_and_the_focus():
    var ed = editor_of()
    var view = surface.Surface.of(18, 78)
    let layout = panes.Layout.of(view.area(), true, true)
    paint.frame(ed, view, layout)
    let status = row_text(view, 17)
    assert(strings.contains(status, "sample.luc"))
    assert(strings.contains(status, "[editor]"))

func test_search_focus_shows_the_prompt():
    var ed = editor_of()
    ed.open_search()
    ed.search_query = "let"
    ed.rescan()
    var view = surface.Surface.of(18, 78)
    let layout = panes.Layout.of(view.area(), true, true)
    paint.frame(ed, view, layout)
    let status = row_text(view, 17)
    assert(strings.contains(status, "find: let"))
