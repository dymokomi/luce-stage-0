# Undo/redo round-trips content and cursor; a new edit clears redo.

import history

pub func test_undo_returns_the_prior_revision():
    let stack = history.History()
    # Record the state before typing " world".
    stack.record("hello", 5)
    # Now the live state is the edited one; undo hands back the prior.
    let prior = stack.undo("hello world", 11)
    if prior == none:
        assert(false)
        return
    assert(prior.content == "hello")
    assert(prior.cursor == 5)
    # Redo hands back the state undo moved onto the future stack.
    let ahead = stack.redo("hello", 5)
    if ahead == none:
        assert(false)
        return
    assert(ahead.content == "hello world")
    assert(ahead.cursor == 11)

pub func test_undo_on_an_empty_stack_answers_none():
    let stack = history.History()
    assert(stack.undo("x", 1) == none)
    assert(stack.redo("x", 1) == none)

pub func test_a_new_edit_invalidates_redo():
    let stack = history.History()
    stack.record("a", 1)
    let undone = stack.undo("ab", 2)
    assert(undone != none)
    # A fresh edit records over the top and drops the redo history:
    # after it, there is nothing ahead to redo.
    stack.record("a", 1)
    assert(stack.redo("a", 1) == none)

pub func test_the_stack_is_bounded():
    let stack = history.History()
    for i in range(0, history.depth + 50):
        stack.record("s" + str(i), i)
    # Undo everything the stack kept: exactly `depth` revisions come
    # back, and the oldest one standing is revision 50 — the bottom
    # fell out first.
    var count = 0
    var oldest = -1
    var content = "live"
    var cursor = history.depth + 50
    while true:
        let prior = stack.undo(content, cursor)
        if prior == none:
            break
        count += 1
        oldest = prior.cursor
        content = prior.content
        cursor = prior.cursor
    assert(count == history.depth)
    assert(oldest == 50)
