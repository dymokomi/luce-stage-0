# Build and run the current file, and hold the output.
#
# The command is built here so the quoting rule lives in one place; the
# run is a single shell call whose whole output — success or failure —
# is the text the output pane shows.

import std.os
import std.strings

# One shell word, including paths with spaces or shell punctuation.
func shell_quote(value: str) -> str:
    return "'" + strings.replace(value, "'", "'\\''") + "'"

# Compile `path` to a sibling executable and run it, so a person sees
# both the compiler's diagnostics and the program's output in one pass.
func build_command(path: str) -> str:
    let output = path + ".run"
    return "luce build " + shell_quote(path) + " --emit=exe -o " + shell_quote(output) + " && " + shell_quote(output)

# Run a command and answer its combined output, or the failure message
# if the shell service itself refused.
func run(command: str) -> str:
    var output = ""
    output = os.shell.run(command) catch reason:
        return reason
    return output
