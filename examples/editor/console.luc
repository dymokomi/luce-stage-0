# The output pane: the retained component that shows build output and
# starts the divider drag on its own top border.

import termui
import document
import focus
import keymap
import model
import theme

class Console: termui.View:
    private model: model.Model

    init(shared: model.Model):
        self.model = shared

    # --- data provider ----------------------------------------------

    func output_line(index: i64) -> termui.Line:
        let start = document.line_at(self.model.output, index)
        let finish = document.line_end(self.model.output, start)
        return termui.plain(self.model.output[start:finish], theme.palette.plain)

    # --- cursor projection ------------------------------------------

    func output_cursor(area: termui.Rect) -> termui.Cursor?:
        if self.model.focus != focus.Focus.output or area.is_empty():
            return none
        return termui.Cursor(row = area.row, column = area.column)

    # --- events ------------------------------------------------------

    func frame_event(event: termui.Event, area: termui.Rect) -> termui.Response:
        match event:
            mouse(pointer):
                if pointer.kind == termui.Pointer.press and pointer.button == 0 and pointer.row == area.row:
                    self.model.dragging = model.Drag.output
                    return termui.Response.handled
            else:
                return termui.Response.ignored
        return termui.Response.ignored

    func output_event(event: termui.Event, area: termui.Rect) -> termui.Response:
        match event:
            key(pressed):
                if self.model.focus != focus.Focus.output:
                    return termui.Response.ignored
                let intent = keymap.intent_of(pressed)
                if intent == keymap.Intent.ignored:
                    return termui.Response.ignored
                self.model.key(intent, "", area.rows)
                return termui.Response.handled
            mouse(pointer):
                if pointer.kind == termui.Pointer.wheel:
                    self.model.focus = focus.Focus.output
                    self.model.output_scroll = max(self.model.output_scroll - pointer.wheel, 0)
                    return termui.Response.handled
                if pointer.kind == termui.Pointer.press and pointer.button == 0:
                    self.model.focus = focus.Focus.output
                    self.model.output_scroll = max(self.model.output_scroll + pointer.row - area.row, 0)
                    return termui.Response.handled
                return termui.Response.ignored
            else:
                return termui.Response.ignored

    # --- the View contract ------------------------------------------

    private func composed() -> termui.View:
        let rows = new termui.Rows(
            document.count_lines(self.model.output),
            self.output_line,
            top = self.model.output_scroll,
        )
        let pane = new termui.CursorHost(
            new termui.EventHost(rows, self.output_event),
            self.output_cursor,
        )
        let framed = new termui.Panel(
            "output",
            pane,
            style = theme.pane_style(self.model.focus == focus.Focus.output),
            edges = termui.Edges(bottom = false),
        )
        return new termui.EventHost(framed, self.frame_event)

    func draw(surface: termui.Surface, area: termui.Rect) -> termui.Cursor?:
        return self.composed().draw(surface, area)

    func dispatch(event: termui.Event, area: termui.Rect) -> termui.Response:
        return termui.route(self.composed(), event, area)
