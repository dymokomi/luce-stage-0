# The server's conversation, with a scripted compiler: requests get
# responses, changed buffers publish diagnostics, closing publishes
# them away, and exit leaves.

import std.strings
from frames import framed
from server import Server, Compiler

# The toolchain as a script: whatever the test says the compiler said.
class Scripted: Compiler:
    answer: str

    init(answer: str):
        self.answer = answer

    func diagnostics(content: str) -> str!:
        return self.answer

private func body_of(frame: list[u8]) -> str:
    let text = strings.from_bytes(frame) else ""
    let split = strings.find(text, str(char(13)) + "\n" + str(char(13)) + "\n") else -1
    return text[split + 2:len(text)]

func test_initialize_answers_capabilities():
    let server = Server(Scripted("[]"))
    let outcome = server.handle("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}")
    assert(len(outcome.frames) == 1)
    assert(not outcome.leaving)
    let reply = body_of(outcome.frames[0])
    assert(strings.contains(reply, "\"textDocumentSync\":1"))
    assert(strings.contains(reply, "\"id\":1"))

func test_did_open_publishes_the_compilers_findings():
    let server = Server(Scripted("[{\"code\":\"luce.sema.name\",\"severity\":\"error\",\"message\":\"unknown name x\",\"path\":\"<stdin>\",\"line\":2,\"column\":5,\"end_line\":2,\"end_column\":6}]"))
    let opened = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///f.luc\",\"text\":\"func main():\\n    x\\n\"}}}"
    let outcome = server.handle(opened)
    assert(len(outcome.frames) == 1)
    let told = body_of(outcome.frames[0])
    assert(strings.contains(told, "publishDiagnostics"))
    assert(strings.contains(told, "\"uri\":\"file:///f.luc\""))
    assert(strings.contains(told, "unknown name x"))
    # 1-based (2,5) becomes 0-based (1,4).
    assert(strings.contains(told, "\"line\":1"))
    assert(strings.contains(told, "\"character\":4"))

func test_did_close_publishes_nothing_outstanding():
    let server = Server(Scripted("[]"))
    let opened = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///f.luc\",\"text\":\"\"}}}"
    var outcome = server.handle(opened)
    let closed = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\",\"params\":{\"textDocument\":{\"uri\":\"file:///f.luc\"}}}"
    outcome = server.handle(closed)
    assert(len(outcome.frames) == 1)
    assert(strings.contains(body_of(outcome.frames[0]), "\"diagnostics\":[]"))

func test_an_unknown_request_is_refused_and_a_notification_ignored():
    let server = Server(Scripted("[]"))
    var outcome = server.handle("{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"textDocument/hover\",\"params\":{}}")
    assert(len(outcome.frames) == 1)
    assert(strings.contains(body_of(outcome.frames[0]), "-32601"))
    outcome = server.handle("{\"jsonrpc\":\"2.0\",\"method\":\"$/cancelRequest\",\"params\":{}}")
    assert(len(outcome.frames) == 0)

func test_shutdown_then_exit_leaves():
    let server = Server(Scripted("[]"))
    var outcome = server.handle("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"shutdown\"}")
    assert(len(outcome.frames) == 1)
    assert(not outcome.leaving)
    outcome = server.handle("{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}")
    assert(outcome.leaving)
