# zipper — ZIP archives from the command line.
#
#   loom run zipper.lc list ARCHIVE.zip
#   loom run zipper.lc unzip ARCHIVE.zip [DIRECTORY]
#   loom run zipper.lc zip ARCHIVE.zip FILE [FILE ...]
#
# `std.zip` is the format and `std.files` is the disk; this program is
# the two hundred lines between them, and it exists because a library
# nobody can run is a claim rather than a capability.  Everything here
# is ordinary Luce: `main(args)`, `try`, scope ownership, and the u8
# path `std.files` grew (docs/BYTES.md).
#
# **Names out of an archive are not trusted.**  An entry's name is
# whatever the person who wrote the archive put there, and "../../..
# /etc/passwd" is a name.  `safe_name` is the one gate every extracted
# path goes through, and it refuses by name rather than by silence —
# the attack has been called zip-slip since 2018 and every extractor
# that skipped this check was where it was found.  `zip` puts names
# through the same gate: zipper will not author an archive it would
# refuse to extract.
#
# **A bad name stops the run before anything is written; a bad u8
# stops it where it is.**  Every name is checked before the first file
# is created, so a hostile archive leaves the disk as it found it.  A
# checksum that fails is a different thing — it is found on the entry
# it belongs to, halfway through — and the entries already written stay
# where they are, exactly as `unzip` leaves them.
#
# **Directories an archive names, zipper makes.**  `files.make_directory`
# makes the parents too and treats one already there as success, so
# extracting `papers/note.txt` into an empty directory works the way
# `unzip` does — no flattened names, and no asking the person to go and
# make the tree by hand first.  The names are still checked whole before
# anything is written, so a hostile archive leaves the disk untouched.

import std.zip
import std.files
import std.paths
import std.strings
import std.os

const usage = "usage: zipper list ARCHIVE.zip | zipper unzip ARCHIVE.zip [DIRECTORY] | zipper zip ARCHIVE.zip FILE [FILE ...]"

# How many, said the way a person says it.  "1 entries" is the kind of
# small dishonesty that makes a tool feel machine-written.
func counted(amount: i64, one: str, many: str) -> str:
    if amount == 1:
        return "1 " + one
    return str(amount) + " " + many

# --- the name gate ---------------------------------------------------

# The name an entry may be written under, or an error saying why it
# may not be written at all.
#
# APPNOTE 4.4.17.1 says an entry's name is a relative path with "/"
# between its parts and no drive letter — so every shape refused here
# is a name that does not conform *and* a name that reaches outside
# the directory it was asked to go into.  The two facts are the same
# fact, which is why one gate can be both the format check and the
# security check.
func safe_name(name: str) -> str!:
    if len(name) == 0:
        error("zipper: an entry with no name")
    if paths.is_absolute(name):
        error("zipper: " + name + " is an absolute path, and an entry may not name where it lands")
    if strings.contains(name, "\\"):
        error("zipper: " + name + " separates its parts with a backslash, which an archive's names may not (APPNOTE 4.4.17.1)")
    if len(name) >= 2 and name[1] == ':' and is_letter(name[0]):
        error("zipper: " + name + " names a drive, and an entry may not name where it lands")
    let parts = strings.split(name, "/")
    for part in parts:
        if part == "..":
            error("zipper: " + name + " climbs out of the directory it would be extracted into")
    return name

func is_letter(value: char) -> bool:
    if value >= 'a' and value <= 'z':
        return true
    return value >= 'A' and value <= 'Z'

# --- list ------------------------------------------------------------

func list_archive(path: str) -> !:
    let archive = try zip.read(path)
    let entries = try zip.entries(archive)
    print(counted(len(entries), "entry", "entries") + " in " + path + ", " + counted(len(archive), "byte", "bytes"))
    for entry in entries:
        var line = new builder
        line.append("  ")
        line.append(strings.pad_right(method_of(entry), 9))
        line.append(strings.pad_left(str(entry.size()), 10))
        line.append(strings.pad_left(str(entry.packed()), 10))
        line.append("  ")
        line.append(entry.name())
        print(line.build())

func method_of(entry: zip.Entry) -> str:
    if entry.deflated():
        return "deflated"
    return "stored"

# --- unzip -----------------------------------------------------------

# Extract every entry into `into`, which must already be there.
#
# Two passes on purpose, and the first one still writes nothing: every
# name in the archive goes through the gate before the first u8 lands,
# so a hostile archive is refused whole and leaves the disk exactly as
# it found it.  The second pass makes each entry's directory as it
# reaches it — `make_directory` makes the parents and does not mind one
# that is already there, so this is a call and not a bookkeeping
# problem.
func unzip_archive(path: str, into: str) -> !:
    let archive = try zip.read(path)
    let entries = try zip.entries(archive)
    # The question this gate actually asks is "is there a *directory*
    # here", and `exists` answered "is there an entry" — so a file
    # holding the name sailed through and the run failed later, on the
    # first `make_directory`, with a message about a directory nobody
    # had asked for.  `is_dir` asks what the next twenty lines mean.
    if not try files.is_dir(into):
        error("zipper: " + into + " is not a directory to extract into")

    var names: list[str] = []
    for entry in entries:
        let name = try safe_name(entry.name())
        names.append(name)

    var written: i64 = 0
    for index, entry in entries:
        let name = names[index]
        let target = paths.join(into, name)
        if strings.ends_with(name, "/"):
            # A name ending in "/" is a directory and has no contents
            # (APPNOTE 4.4.17.1) — so making it is the whole of
            # extracting it.
            try files.make_directory(target)
        else:
            try files.make_directory(paths.dir(target))
            let data = try zip.extract(archive, entry)
            try files.write_bytes(target, data)
            print("  " + strings.pad_left(str(len(data)), 10) + "  " + target)
            written += 1
    print(counted(written, "file", "files") + " extracted into " + into)

# --- zip -------------------------------------------------------------

# Build an archive out of files on disk, storing each under the path it
# was named by — the way `zip` itself does, so an archive zipper writes
# and an archive zipper reads are the same kind of thing.
#
# Every entry is offered to DEFLATE and keeps whichever of the two is
# smaller (`Writer.add`), so an entry never grows by being compressed.
func zip_files(path: str, sources: list[str]) -> !:
    var maker = zip.writer()
    var total: i64 = 0
    for source in sources:
        let name = try safe_name(source)
        let data = try files.read_bytes(source)
        try maker.add(name, data, true)
        total += len(data)
        print("  " + strings.pad_left(str(len(data)), 10) + "  " + name)
    let archive = maker.finish()
    try zip.write(path, archive)
    print(counted(len(sources), "file", "files") + " (" + counted(total, "byte", "bytes") + ") into " + path + ", " + counted(len(archive), "byte", "bytes"))

# --- the command line ------------------------------------------------

func main(args: list[str]) -> !:
    if len(args) == 0:
        os.print_error(usage)
        exit(2)
    let command = args[0]
    if command == "list":
        if len(args) != 2:
            os.print_error("usage: zipper list ARCHIVE.zip")
            exit(2)
        try list_archive(args[1])
    elif command == "unzip":
        if len(args) < 2 or len(args) > 3:
            os.print_error("usage: zipper unzip ARCHIVE.zip [DIRECTORY]")
            exit(2)
        var into = "."
        if len(args) == 3:
            into = args[2]
        try unzip_archive(args[1], into)
    elif command == "zip":
        if len(args) < 3:
            os.print_error("usage: zipper zip ARCHIVE.zip FILE [FILE ...]")
            exit(2)
        var sources: list[str] = []
        for index in range(2, len(args)):
            sources.append(args[index])
        try zip_files(args[1], sources)
    else:
        os.print_error("zipper: no command called " + command)
        os.print_error(usage)
        exit(2)
