# world — the model a text adventure is played on: the rooms, the ways
# between them, and the things lying about in them.
#
# Nothing here knows what the game is about.  `story.luc` says that,
# `adventure.luc` runs the loop, and a `Realm` only answers questions
# and takes changes: no key is read here and no line is printed.
#
# **The tables are flat and indexed, on purpose.**  A room does not
# hold its own exits and does not hold its own things — a `Way`
# records the room it leads *from* and a `Thing` records the room it
# is *in*, and the three lists live side by side in the `Realm`.  The
# tree would read better right up until something had to change:
# Luce refuses to assign through an index into elements that carry
# objects (OWNERSHIP.md S22), so a `list[Room]` whose rooms held
# lists of their own would be a table nothing could ever mark as
# visited.  Flat tables of plain-value structs have no such trouble —
# a field of an element is an ordinary place — and the indices are
# what the save file writes down anyway.
#
# Every field that is not a name is `private`, so the three structs
# are built through the `make` functions beside them and read through
# the questions below.  That is not ceremony: `Thing.origin` is set
# from `at` and never separately, which is a promise the module can
# only keep if no outside site can name it (docs/VISIBILITY.md §6).

import std.strings

# Where a thing is when it is in no room: in the player's hands.
const carried = -1

# "A brass key", "An iron crank": the article an English name takes.
# Wrong for a handful of words and right for a table of them, which
# is the trade every adventure game has made since 1976.
func article(name: str) -> str:
    if len(name) == 0:
        return "A"
    let opening = name[0]
    if opening == 'a' or opening == 'e' or opening == 'i':
        return "An"
    if opening == 'o' or opening == 'u':
        return "An"
    return "A"

# A place, and what is said on arriving.
pub struct Room:
    pub name: str

    description: str
    visited: bool = false

    pub static func make(name: str, description: str) -> Room:
        return Room(name = name, description = description)

    # The full arrival, or the one line a room already seen gets.
    pub func told(brief: bool = false) -> str:
        if brief:
            return self.name
        return self.name + "\n" + self.description

# A one-way passage.  Two of them make a door that opens both ways,
# which is what `story.luc` writes and why `link` below takes both.
pub struct Way:
    pub direction: str

    from: i64
    to: i64
    locked: bool = false
    needs: str = ""

    # Half a door, and marked because half a door is not something a
    # story should be able to write: `Realm.link` below makes both
    # halves out of one line, and two halves written separately can
    # disagree about which of them is locked.
    static func make(
        from: i64,
        direction: str,
        to: i64,
        locked: bool = false,
        needs: str = "",
    ) -> Way:
        return Way(from = from, direction = direction, to = to, locked = locked, needs = needs)

    pub func leaves(from: i64, direction: str) -> bool:
        return self.from == from and self.direction == direction

    pub func starts_at(from: i64) -> bool:
        return self.from == from

    # True for both halves of one door, whichever way it was written.
    pub func joins(one: i64, other: i64) -> bool:
        if self.from == one and self.to == other:
            return true
        return self.from == other and self.to == one

    pub func shut() -> bool:
        return self.locked

    pub func opens_with() -> str:
        return self.needs

    pub func beyond() -> i64:
        return self.to

# Something to pick up, or something too heavy to.
pub struct Thing:
    pub name: str

    description: str
    at: i64
    origin: i64
    portable: bool = true

    # `origin` is `at` and can be nothing else, which is why the field
    # is private and this is the only way to make a Thing: `forget`
    # below puts everything back where the story left it, and a caller
    # that could name the two separately could make that a lie.
    pub static func make(name: str, description: str, at: i64, portable: bool = true) -> Thing:
        return Thing(
            name = name,
            description = description,
            at = at,
            origin = at,
            portable = portable,
        )

    pub func described() -> str:
        return self.description

    pub func lying_in(at: i64) -> bool:
        return self.at == at

    pub func held() -> bool:
        return self.at == carried

    pub func liftable() -> bool:
        return self.portable

# The three tables, and every question and change the game makes of
# them.  `Realm` carries objects, so its methods use their implied
# receiver to work through the lists rather than replacing the Realm
# value; the lists are the state, and a borrow may edit what it may not
# keep (OWNERSHIP.md S38).
pub struct Realm:
    rooms: list[Room]
    ways: list[Way]
    things: list[Thing]

    pub static func empty() -> Realm:
        return Realm(
            rooms = list[Room](),
            ways = list[Way](),
            things = list[Thing](),
        )

    # -- building, which is story.luc's f16 ---------------------------

    pub func add_room(made: Room) -> i64:
        self.rooms.append(made)
        return len(self.rooms) - 1

    func add_way(made: Way):
        self.ways.append(made)

    # A door: the way there and the way back, so a story writes one
    # line per passage instead of two that can disagree.
    pub func link(
        from: i64,
        direction: str,
        to: i64,
        back: str,
        locked: bool = false,
        needs: str = "",
    ):
        self.add_way(Way.make(
            from = from,
            direction = direction,
            to = to,
            locked = locked,
            needs = needs,
        ))
        self.add_way(Way.make(
            from = to,
            direction = back,
            to = from,
            locked = locked,
            needs = needs,
        ))

    pub func add_thing(made: Thing):
        self.things.append(made)

    # -- questions -----------------------------------------------------

    pub func name_at(at: i64) -> str:
        return self.rooms[at].name

    # The index of the room with this name, or none — which is what
    # a save file's word has to be turned into before it is a place.
    pub func where(name: str) -> i64?:
        for i, place in self.rooms:
            if place.name == name:
                return i
        return none

    pub func seen(at: i64) -> bool:
        return self.rooms[at].visited

    # Everything a player sees on looking: the room, what is lying in
    # it, and the ways out.  `brief` is the second visit's version.
    pub func look(at: i64, brief: bool = false) -> str:
        var said = builder()
        said.append(self.rooms[at].told(brief = brief))
        let lying = self.things_in(at)
        for thing in lying:
            said.append("\n" + article(thing.name) + " " + thing.name + " is here.")
        let ways = self.ways_out(at)
        if len(ways) == 0:
            said.append("\nThere is no way out.")
        else:
            said.append("\nWays out: " + ways.join(", ") + ".")
        return said.build()

    # The directions that leave this room, in the order the story
    # wrote them.  A fresh list, so the caller owns it (S28).
    pub func ways_out(at: i64) -> list[str]:
        var names: list[str] = []
        for way in self.ways:
            if way.starts_at(at):
                names.append(way.direction)
        return names

    pub func way_out(at: i64, direction: str) -> Way?:
        for way in self.ways:
            if way.leaves(at, direction):
                return way
        return none

    # Everything lying in one room, as a list of the caller's own —
    # the things table stays this realm's (OWNERSHIP.md S28).
    pub func things_in(at: i64) -> list[Thing]:
        var found = list[Thing]()
        for thing in self.things:
            if thing.lying_in(at):
                found.append(thing)
        return found

    pub func thing_in(at: i64, name: str) -> Thing?:
        for thing in self.things:
            if thing.lying_in(at) and thing.name == name:
                return thing
        return none

    pub func holding(name: str) -> bool:
        for thing in self.things:
            if thing.held() and thing.name == name:
                return true
        return false

    # What is in the player's hands, and what rooms they have walked
    # into: two fresh lists the caller owns, and what `journal.luc`
    # writes into a save file.
    pub func carrying() -> list[str]:
        var names: list[str] = []
        for thing in self.things:
            if thing.held():
                names.append(thing.name)
        return names

    pub func visited() -> list[str]:
        var names: list[str] = []
        for place in self.rooms:
            if place.visited:
                names.append(place.name)
        return names

    # Rooms seen and things held, in one traversal of each table —
    # two answers that are always read together, so they travel
    # together (docs/RETURNS.md).
    pub func tally() -> (i64, i64):
        var places = 0
        for place in self.rooms:
            if place.visited:
                places += 1
        var held = 0
        for thing in self.things:
            if thing.held():
                held += 1
        return places, held

    # What a thing here or in hand looks like up close, or none when
    # there is no such thing within reach.
    pub func describe(at: i64, name: str) -> str?:
        for thing in self.things:
            if thing.name == name and (thing.held() or thing.lying_in(at)):
                return thing.described()
        return none

    # -- changes -------------------------------------------------------
    #
    # Nested places retain the receiver's ownership and write through
    # its tables directly.  The same spelling is used here as in the
    # editor: no local alias is needed just to reach a field of an
    # indexed value.

    pub func visit(at: i64):
        self.rooms[at].visited = true

    # Pick a thing up if it is here and can be lifted; the answer says
    # which of the three happened, and the caller has the words.
    pub func pick_up(at: i64, name: str) -> bool:
        for i, thing in self.things:
            if thing.lying_in(at) and thing.name == name and thing.liftable():
                self.things[i].at = carried
                return true
        return false

    pub func put_down(at: i64, name: str) -> bool:
        for i, thing in self.things:
            if thing.held() and thing.name == name:
                self.things[i].at = at
                return true
        return false

    # Open a locked way, and the way back with it: a door unlocked
    # from one side is unlocked from the other.
    pub func unlock(at: i64, direction: str) -> bool:
        let way = self.way_out(at, direction)
        if way == none:
            return false
        let beyond = way.beyond()
        var opened = false
        for i, each in self.ways:
            if each.joins(at, beyond):
                self.ways[i].locked = false
                opened = true
        return opened

    # -- what a save file puts back ------------------------------------
    #
    # `forget` is the whole of the state a save replaces: every thing
    # back where the story left it, every room unwalked.  A restore
    # that skipped it would add a save's carried things to whatever
    # the player was already holding.

    pub func forget():
        for i, place in self.rooms:
            self.rooms[i].visited = false
        for i, thing in self.things:
            self.things[i].at = thing.origin

    # The two the restore path calls, and the reason they are `!`:
    # a save file is text off a disk, so a name in it may be a name
    # this realm has never heard of, and that is news for whoever
    # asked to load it (docs/FAILURE.md).
    pub func hold(name: str) -> !:
        for i, thing in self.things:
            if thing.name == name:
                self.things[i].at = carried
                return
        error("the save carries a " + name + ", which this story has none of")

    pub func mark_seen(name: str) -> !:
        let at = self.where(name)
        if at == none:
            error("the save has been in " + name + ", which this story has no room called")
        self.rooms[at].visited = true
