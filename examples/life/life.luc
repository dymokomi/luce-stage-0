# Conway's Game of Life: a multi-dimensional array on the terminal.
#
#   loom run life.lc
#   any key steps a generation, space runs a hundred, Ctrl-Q quits
#
# The run is *paced*, not merely repeated: each frame is drawn, then
# the loop waits out whatever is left of its share of a second.  That
# is what `clock_ms` is for — measure the frame, subtract, wait the
# remainder — and it is why a frame that overran asks to sleep a
# negative number of milliseconds.  That is not a bug and does not
# trap: there is no time left to wait, so the wait returns.

import std.os
import std.term

const frame_ms = 80

struct World:
    static func rows() -> i64:
        return clamp(term.rows() - 2, 8, 40)

    static func cols() -> i64:
        return clamp((term.cols() - 1) // 2, 8, 60)

    static func seed(grid: array[bool, _, _]):
        # A glider...
        grid[1, 2] = true
        grid[2, 3] = true
        grid[3, 1] = true
        grid[3, 2] = true
        grid[3, 3] = true
        # ...and a blinker.
        let mid = grid.dim(0) // 2
        grid[mid, 6] = true
        grid[mid, 7] = true
        grid[mid, 8] = true

    static func neighbors(grid: array[bool, _, _], row: i64, col: i64) -> i64:
        let height = grid.dim(0)
        let width = grid.dim(1)
        var alive = 0
        for dr in range(0, 3):
            for dc in range(0, 3):
                if dr != 1 or dc != 1:
                    let r = (row + dr - 1 + height) % height
                    let c = (col + dc - 1 + width) % width
                    if grid[r, c]:
                        alive = alive + 1
        return alive

    # One generation: builds the next grid; the caller owns it.
    static func step(grid: array[bool, _, _]) -> array[bool, _, _]:
        let height = grid.dim(0)
        let width = grid.dim(1)
        var next = array[bool](height, width)
        for row in range(0, height):
            for col in range(0, width):
                let around = World.neighbors(grid, row, col)
                if grid[row, col]:
                    next[row, col] = around == 2 or around == 3
                else:
                    next[row, col] = around == 3
        return next

    static func draw(grid: array[bool, _, _], generation: i64):
        term.clear()
        for row in range(0, grid.dim(0)):
            term.move(row, 0)
            for col in range(0, grid.dim(1)):
                if grid[row, col]:
                    term.style(114)
                    term.write("██")
                else:
                    term.style(238)
                    term.write(" ·")
        term.move(grid.dim(0), 0)
        term.style(252, 237)
        term.write(" generation " + str(generation) + "  |  any key: step   space: run   Ctrl-Q: quit ")

func main():
    var grid = array[bool](World.rows(), World.cols())
    World.seed(grid)
    var generation = 0
    var running = true
    while running:
        World.draw(grid, generation)
        # `none` is the keyboard running dry, which ends the run for
        # the same reason Ctrl-Q does: nobody is going to ask for
        # another generation.
        let event = term.read()
        if event == none:
            running = false
        else:
            var steps = 1
            match event:
                key(pressed):
                    if pressed == term.Key.ctrl_q:
                        steps = 0
                        running = false
                text(typed):
                    if typed == " ":
                        steps = 100
                else:
                    steps = 1
            for tick in range(0, steps):
                let began = os.clock_ms()
                grid = World.step(grid)   # the old grid frees right here (S5)
                generation = generation + 1
                if steps > 1:
                    World.draw(grid, generation)
                    # What is left of this frame's share of a second.
                    # A slow machine leaves nothing, or less than
                    # nothing, and the wait simply returns.
                    os.sleep_ms(frame_ms - (os.clock_ms() - began))
