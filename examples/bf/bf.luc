# A Brainfuck interpreter in Luce: the u8 tape is a real array,
# output accumulates in a builder, and `char` maps cell values to text.
#
#   loom luce examples/bf/bf.luc

func matching_forward(code: str, pc: i64) -> i64:
    var depth = 1
    var at = pc
    while depth > 0:
        at = at + 1
        if code[at] == '[':
            depth = depth + 1
        elif code[at] == ']':
            depth = depth - 1
    return at

func matching_backward(code: str, pc: i64) -> i64:
    var depth = 1
    var at = pc
    while depth > 0:
        at = at - 1
        if code[at] == ']':
            depth = depth + 1
        elif code[at] == '[':
            depth = depth - 1
    return at

func interpret(code: str, cells: i64) -> str:
    # A Brainfuck cell *is* a u8, so the tape says so: one u8 an
    # element instead of eight, and the type now carries the range the
    # `% 256` below used to be the only evidence of.
    var tape = new array[u8](cells)
    var pointer = 0
    var pc: i64 = 0
    var out = new builder
    while pc < len(code):
        let op = code[pc]
        if op == '>':
            pointer = pointer + 1
        elif op == '<':
            pointer = pointer - 1
        elif op == '+':
            if tape[pointer] == u8(255):
                tape[pointer] = u8(0)
            else:
                tape[pointer] += u8(1)
        elif op == '-':
            if tape[pointer] == u8(0):
                tape[pointer] = u8(255)
            else:
                tape[pointer] -= u8(1)
        elif op == '.':
            out.append(str(char(tape[pointer])))
        elif op == '[':
            if tape[pointer] == 0:
                pc = matching_forward(code, pc)
        elif op == ']':
            if tape[pointer] != 0:
                pc = matching_backward(code, pc)
        pc = pc + 1
    return out.build()

func main():
    let hello = "++++++++[>++++[>++>+++>+++>+<<<<-]>+>+>->>+[<]<-]>>.>---.+++++++..+++.>>.<-.<.+++.------.--------.>>+.>++."
    let out = interpret(hello, 30)
    print(out)
    assert(out == "Hello World!\n")
