# Word frequencies: map, list, builder, file reading, arguments.
#
#   loom run wordcount.lc FILE [TOP_N]

import std.files

func is_word_char(code: char) -> bool:
    if code >= 'a' and code <= 'z':
        return true
    if code >= 'A' and code <= 'Z':
        return true
    if code >= '0' and code <= '9':
        return true
    return code == '_' or u32(code) >= 128

# Collect every word of `content` into the counts map.
func count_words(content: str, counts: map[str, i64]):
    var at = 0
    while at < len(content):
        if is_word_char(content[at]):
            var stop = at + 1
            while stop < len(content) and is_word_char(content[stop]):
                stop = stop + 1
            let word = content[at:stop]
            # A compound store defines the key it writes into, at the
            # value type's zero, so the first sighting of a word needs
            # no arm of its own.  The has-then-index this replaces was
            # three hash lookups on the hit path; this is two.
            counts[word] += 1
            at = stop
        else:
            at = at + 1

# The most frequent remaining word, and how often (first seen wins
# ties).  It computed both and could answer only one, so every caller
# did a second hash lookup for the count this already had.
func heaviest(counts: map[str, i64]) -> (str, i64):
    var best = ""
    var best_count: i64 = 0
    for word in counts:
        if counts[word] > best_count:
            best = word
            best_count = counts[word]
    return best, best_count

func main(args: list[str]) -> !:
    if len(args) == 0:
        print("usage: wordcount FILE [TOP_N]")
        return
    let path = args[0]
    var top: i64 = 5
    if len(args) > 1:
        top = parse_i64(args[1]) else top

    # One read, and its answer is the whole story.  The exists-then-
    # read this used to write had a window between the two calls that
    # nothing could close, and it could not tell "not there" from
    # "would not open" either (docs/FAILURE.md).
    var counts = new map[str, i64]
    count_words(try files.read(path), counts)
    print(str(len(counts)) + " distinct words in " + path)

    var shown = 0
    while shown < top and len(counts) > 0:
        let word, count = heaviest(counts)
        var line = new builder
        line.append("  ")
        line.append(str(count))
        line.append("  ")
        line.append(word)
        print(line.build())
        counts.remove(word)
        shown = shown + 1
