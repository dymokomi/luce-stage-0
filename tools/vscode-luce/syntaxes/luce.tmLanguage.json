{
  "information_for_contributors": [
    "This file is GENERATED from the Luce compiler's own word tables.",
    "Do not edit it: run `zig build grammar` and commit the result.",
    "The generator is tools/grammar.zig, and a test in `zig build test` fails when this file and the language disagree."
  ],
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Luce",
  "scopeName": "source.luce",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#code"
    }
  ],
  "repository": {
    "accessors": {
      "patterns": [
        {
          "match": "(\\.)(append|insert|remove|pop|clear|sort|reverse|find|contains|dim|fill|has|get|keys|values|append_ascii|build|byte_at|find_byte)\\b",
          "captures": {
            "1": { "name": "punctuation.accessor.luce" },
            "2": { "name": "support.function.method.luce" }
          }
        },
        {
          "match": "(\\.)([A-Za-z][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.luce" },
            "2": { "name": "entity.name.function.luce" }
          }
        },
        {
          "match": "(\\.)([A-Za-z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.luce" },
            "2": { "name": "variable.other.member.luce" }
          }
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.luce",
          "match": "\\b(?:range|abs|min|max|clamp|sqrt|floor|ceil|trunc|len|assert|parse_int|parse_float|parse_string|chr|ord)\\b"
        },
        {
          "name": "support.function.builtin.host.luce",
          "match": "\\b(?:print|file_read|file_write|file_exists|term_rows|term_cols|term_clear|term_move|term_style|term_write|term_flush|key_read|key_text|read_line|print_error|clock_ms|sleep_ms|env|file_append|file_delete|file_rename|dir_list|file_open|exit|os_total_memory|os_available_memory|os_cpu_count)\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "entity.name.function.call.luce",
          "match": "\\b[A-Za-z][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "code": {
      "patterns": [
        {
          "include": "#numbers"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#stopping"
        },
        {
          "include": "#types"
        },
        {
          "include": "#accessors"
        },
        {
          "include": "#builtins"
        },
        {
          "include": "#names"
        },
        {
          "include": "#calls"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.luce",
          "match": "(#).*$",
          "captures": {
            "1": { "name": "punctuation.definition.comment.luce" }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(func)\\s+([A-Za-z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.luce" },
            "2": { "name": "entity.name.function.luce" }
          }
        },
        {
          "match": "\\b(struct)\\s+([A-Za-z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.struct.luce" },
            "2": { "name": "entity.name.type.struct.luce" }
          }
        },
        {
          "match": "\\b(let|var)\\s+([A-Za-z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.luce" },
            "2": { "name": "variable.other.definition.luce" }
          }
        },
        {
          "match": "\\b(import)\\s+([A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)*)",
          "captures": {
            "1": { "name": "keyword.control.import.luce" },
            "2": { "name": "entity.name.namespace.luce" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.luce",
          "match": "\\b(?:match|if|elif|else|while|for|in|return|break|continue)\\b"
        },
        {
          "name": "keyword.operator.word.luce",
          "match": "\\b(?:and|or|not)\\b"
        },
        {
          "name": "storage.type.luce",
          "match": "\\b(?:func|struct|enum|let|var)\\b"
        },
        {
          "name": "storage.modifier.luce",
          "match": "\\b(?:public|private)\\b"
        },
        {
          "name": "keyword.control.import.luce",
          "match": "\\b(?:import)\\b"
        },
        {
          "name": "keyword.control.exception.luce",
          "match": "\\b(?:try|catch)\\b"
        },
        {
          "name": "constant.language.luce",
          "match": "\\b(?:true|false|none)\\b"
        },
        {
          "name": "keyword.other.ownership.luce",
          "match": "\\b(?:new|give|copy|free)\\b"
        },
        {
          "name": "variable.language.luce",
          "match": "\\b(?:self)\\b"
        }
      ]
    },
    "names": {
      "patterns": [
        {
          "name": "invalid.illegal.name.luce",
          "match": "\\b_[A-Za-z0-9_]+\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "invalid.illegal.number.luce",
          "match": "\\b\\d[\\d_]*(?:\\.[\\d_]+){2,}"
        },
        {
          "name": "constant.numeric.float.luce",
          "match": "\\b\\d(?:_?\\d)*(?:\\.\\d(?:_?\\d)*(?:[eE][+-]?\\d(?:_?\\d)*)?|[eE][+-]?\\d(?:_?\\d)*)\\b"
        },
        {
          "name": "invalid.illegal.number.luce",
          "match": "\\b\\d[\\d_]*\\.(?![A-Za-z_])"
        },
        {
          "name": "constant.numeric.hex.luce",
          "match": "\\b0[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*\\b"
        },
        {
          "name": "constant.numeric.binary.luce",
          "match": "\\b0[bB][01](?:_?[01])*\\b"
        },
        {
          "name": "constant.numeric.integer.luce",
          "match": "\\b(?:0|[1-9](?:_?\\d)*)\\b"
        },
        {
          "name": "invalid.illegal.number.luce",
          "match": "\\b\\d[A-Za-z0-9_]*"
        },
        {
          "name": "invalid.illegal.number.luce",
          "match": "(?<![A-Za-z0-9_)\\]])\\.\\d[\\d_]*(?:[eE][+-]?\\d[\\d_]*)?"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.luce",
          "match": "<<=|>>=|//="
        },
        {
          "name": "keyword.operator.function-return.luce",
          "match": "->"
        },
        {
          "name": "keyword.operator.comparison.luce",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.assignment.luce",
          "match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^="
        },
        {
          "name": "keyword.operator.bitwise.luce",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.arithmetic.luce",
          "match": "//"
        },
        {
          "name": "keyword.operator.comparison.luce",
          "match": "<|>"
        },
        {
          "name": "keyword.operator.assignment.luce",
          "match": "="
        },
        {
          "name": "keyword.operator.bitwise.luce",
          "match": "&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.arithmetic.luce",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.optional.luce",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.fallible.luce",
          "match": "!"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.group.begin.luce",
          "match": "\\("
        },
        {
          "name": "punctuation.section.group.end.luce",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.brackets.begin.luce",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.luce",
          "match": "\\]"
        },
        {
          "name": "punctuation.separator.comma.luce",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.luce",
          "match": ":"
        },
        {
          "name": "punctuation.accessor.luce",
          "match": "\\."
        }
      ]
    },
    "stopping": {
      "patterns": [
        {
          "name": "keyword.control.trap.luce",
          "match": "\\btrap\\b"
        },
        {
          "name": "keyword.control.raise.luce",
          "match": "\\berror\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.interpolated.luce",
          "begin": "\\bf\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.luce" }
          },
          "end": "(\")|$",
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.luce" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.luce",
              "match": "\\{\\{|\\}\\}"
            },
            {
              "name": "meta.interpolation.luce",
              "begin": "\\{",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.luce" }
              },
              "end": "\\}",
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.luce" }
              },
              "patterns": [
                {
                  "include": "#code"
                }
              ]
            },
            {
              "name": "invalid.illegal.unmatched-brace.luce",
              "match": "\\}"
            },
            {
              "name": "constant.character.escape.luce",
              "match": "\\\\[nt\\\\\"]"
            },
            {
              "name": "invalid.illegal.escape.luce",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.luce",
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.luce" }
          },
          "end": "(\")|$",
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.luce" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.luce",
              "match": "\\\\[nt\\\\\"]"
            },
            {
              "name": "invalid.illegal.escape.luce",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.luce",
          "match": "\\b(?:bool|byte|short|int|long|half|float|double|string|list|map|array|builder|file|None)\\b"
        },
        {
          "name": "entity.name.type.luce",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
