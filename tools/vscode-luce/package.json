{
  "name": "luce-language",
  "displayName": "Luce Language",
  "description": "Syntax highlighting, brace-aware editing, and the Luce language server for VS Code.",
  "version": "0.6.8",
  "publisher": "luciaos",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "scripts": {
    "test": "node --test"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "luce",
    "luciaos",
    "loom"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "files": [
    "extension.js",
    "lsp.js",
    "language-configuration.json",
    "syntaxes/luce.tmLanguage.json",
    "README.md"
  ],
  "contributes": {
    "languages": [
      {
        "id": "luce",
        "aliases": [
          "Luce",
          "luce"
        ],
        "extensions": [
          ".luc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "luce",
        "scopeName": "source.luce",
        "path": "./syntaxes/luce.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[luce]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.detectIndentation": false,
        "editor.formatOnType": true
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": [
              "keyword.control.raise.luce",
              "keyword.control.trap.luce"
            ],
            "settings": {
              "foreground": "#e5484d"
            }
          }
        ]
      }
    },
    "configuration": {
      "title": "Luce",
      "properties": {
        "luce.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start the Luce language server for diagnostics."
        },
        "luce.lsp.serverPath": {
          "type": "string",
          "default": "luce-lsp",
          "description": "Command for the Luce language server; found on PATH when not absolute."
        }
      }
    },
    "commands": [
      {
        "command": "luce.foldAllMarks",
        "title": "Fold All Section Marks",
        "category": "Luce"
      },
      {
        "command": "luce.unfoldAllMarks",
        "title": "Unfold All Section Marks",
        "category": "Luce"
      },
      {
        "command": "luce.foldCurrentMark",
        "title": "Fold Current Section Mark",
        "category": "Luce"
      }
    ],
    "keybindings": [
      {
        "command": "luce.foldAllMarks",
        "key": "ctrl+k ctrl+m",
        "mac": "cmd+k cmd+m",
        "when": "editorTextFocus && editorLangId == luce"
      },
      {
        "command": "luce.unfoldAllMarks",
        "key": "ctrl+k ctrl+shift+m",
        "mac": "cmd+k cmd+shift+m",
        "when": "editorTextFocus && editorLangId == luce"
      },
      {
        "command": "luce.foldCurrentMark",
        "key": "ctrl+k ctrl+.",
        "mac": "cmd+k cmd+.",
        "when": "editorTextFocus && editorLangId == luce"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "luce.foldAllMarks",
          "when": "editorLangId == luce"
        },
        {
          "command": "luce.unfoldAllMarks",
          "when": "editorLangId == luce"
        },
        {
          "command": "luce.foldCurrentMark",
          "when": "editorLangId == luce"
        }
      ]
    }
  },
  "activationEvents": [
    "onLanguage:luce"
  ]
}
